@inject Microsoft.Extensions.Options.IOptions<TkgmOwsAyarlari> OwsAyarlari
@{
    var proxyAyari = OwsAyarlari.Value.ProxyAdresi;
    // "yok": proxy'siz statik yayın (GitHub Pages); tarayıcı TKGM'ye doğrudan, kullanıcının girdiği kimlikle bağlanır
    var dogrudan = string.Equals(proxyAyari, "yok", StringComparison.OrdinalIgnoreCase);
    string? proxyKoku = dogrudan ? null : string.IsNullOrWhiteSpace(proxyAyari) ? Url.Content("~/OwsProxy") : proxyAyari.TrimEnd('/');
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string baslik ? $"{baslik} · " : "")owsLab — TKGM CBS Servisleri Eğitimi</title>
    <meta name="description" content="TKGM CBS servislerini (WMS, WFS) gerçek servise canlı istekler göndererek öğreten uygulamalı eğitim portalı." />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.css">
    <link rel="stylesheet" href="~/css/owslab.css" asp-append-version="true" />
</head>
<body>
    <header class="ust-cubuk">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid ust-kap">
                <a class="marka" href="~/">
                    <span class="marka-simge"><i class="fa-solid fa-layer-group"></i></span>
                    <span>
                        <span class="marka-ad">owsLab</span>
                        <span class="marka-alt">TKGM CBS Servisleri Eğitimi</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#anaMenu" aria-label="Menüyü aç">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="anaMenu">
                    <ul class="navbar-nav me-auto ms-lg-4">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Dersler</a>
                            <ul class="dropdown-menu ders-menusu">
                                @{ string? sonBolum = null; var sira = 0; }
                                @foreach (var ders in Mufredat.Dersler)
                                {
                                    sira++;
                                    if (ders.Bolum != sonBolum)
                                    {
                                        sonBolum = ders.Bolum;
                                        <li><h6 class="dropdown-header">@ders.Bolum</h6></li>
                                    }
                                    <li>
                                        <a class="dropdown-item" href="~/ders/@ders.Slug" data-ders-ilerleme="@string.Join(",", ders.Gorevler.Select(g => g.Kimlik))">
                                            <span class="ders-menu-sira">@sira</span>
                                            <span class="flex-grow-1">@ders.Baslik</span>
                                            <span class="ilerleme-metin"></span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link" href="~/Home/Laboratuvar"><i class="fa-solid fa-flask me-1"></i>Laboratuvar</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Home/Rehber"><i class="fa-solid fa-book me-1"></i>Rehber</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <div class="ust-ilerleme" data-toplam-ilerleme="@Mufredat.ToplamGorev" title="Tamamlanan görevler">
                            <i class="fa-solid fa-trophy"></i>
                            <div class="ilerleme-cubugu"><div class="ilerleme-dolgu"></div></div>
                            <span class="ilerleme-metin">0/@Mufredat.ToplamGorev</span>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm demo-hesap-dugmesi dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                                <i class="fa-solid fa-key"></i> Demo hesap
                            </button>
                            <div class="dropdown-menu dropdown-menu-end p-3 demo-hesap-menusu">
                                <div class="small text-muted mb-2">TKGM'nin eğitim için verdiği hesap. Mahalle olarak yalnızca <b>Amasya / Merkez / Hızırpaşa</b>'yı, parsel olarak bu mahalle ve çevresini görür.</div>
                                <div class="kimlik-satiri"><span>Kullanıcı</span><code>cbsdemouser</code><button class="btn btn-sm btn-link p-0" data-kopyala="cbsdemouser" title="Kopyala"><i class="fa-regular fa-copy"></i></button></div>
                                <div class="kimlik-satiri"><span>Şifre</span><code>q3b8f+r*</code><button class="btn btn-sm btn-link p-0" data-kopyala="q3b8f+r*" title="Kopyala"><i class="fa-regular fa-copy"></i></button></div>
                                <div class="kimlik-satiri"><span>WMS</span><code class="small">…/tkgm.ows/wms</code><button class="btn btn-sm btn-link p-0" data-kopyala="https://cbsservis.tkgm.gov.tr/tkgm.ows/wms" title="Kopyala"><i class="fa-regular fa-copy"></i></button></div>
                                <div class="kimlik-satiri"><span>WFS</span><code class="small">…/tkgm.ows/wfs</code><button class="btn btn-sm btn-link p-0" data-kopyala="https://cbsservis.tkgm.gov.tr/tkgm.ows/wfs" title="Kopyala"><i class="fa-regular fa-copy"></i></button></div>
                                <div class="small text-muted mt-2">Kendi kurumunuzun verisi için TKGM'den ayrı bir hesap alırsınız; istekler aynı kalır, yalnızca kimlik bilgisi değişir.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @if (dogrudan)
    {
        <div class="tkgm-giris-bandi">
            <span class="giris-bekliyor">
                <i class="fa-solid fa-key"></i>
                Canlı istekler için TKGM'ye bir kez giriş yapın: düğmeye basın, açılan sekmede kullanıcı adı <code>cbsdemouser</code>,
                şifre <code>q3b8f+r*</code> girin ve bu sekmeye dönün.
                <a class="btn btn-sm btn-warning ms-1" data-tkgm-giris target="_blank" rel="noopener" id="tkgmGirisDugmesi"><i class="fa-solid fa-arrow-up-right-from-square"></i> TKGM'ye giriş yap</a>
            </span>
            <span class="giris-tamam"><i class="fa-solid fa-circle-check"></i> TKGM'ye bağlısınız; istekler doğrudan cbsservis.tkgm.gov.tr'ye gidiyor.</span>
        </div>
    }
    <main>
        @RenderBody()
    </main>

    <footer class="alt-bilgi">
        <div class="container-xl d-flex flex-wrap justify-content-between gap-2">
            <span>owsLab · TKGM CBS servislerinin uygulamalı eğitimi</span>
            <span>Tüm örnekler <code>cbsservis.tkgm.gov.tr</code> üzerinde canlı çalışır · <button type="button" class="btn btn-link btn-sm p-0 align-baseline alt-bilgi-link" data-eylem="ilerlemeSifirla">İlerlemeyi sıfırla</button></span>
        </div>
    </footer>

    <datalist id="owslabParametreAdlari">
        @foreach (var ad in new[] { "SERVICE", "VERSION", "REQUEST", "LAYERS", "LAYER", "STYLES", "STYLE", "SRS", "CRS", "BBOX", "WIDTH", "HEIGHT", "FORMAT", "TRANSPARENT", "BGCOLOR", "QUERY_LAYERS", "INFO_FORMAT", "X", "Y", "I", "J", "FEATURE_COUNT", "SLD_BODY", "CQL_FILTER", "FILTER", "TYPENAME", "MAXFEATURES", "PROPERTYNAME", "OUTPUTFORMAT", "SRSNAME", "SORTBY", "EXCEPTIONS" })
        {
            <option value="@ad"></option>
        }
    </datalist>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.js"></script>
    <script>window.OwsLabAyar = @Json.Serialize(new { kok = Url.Content("~/"), proxy = proxyKoku });</script>
    <script src="~/js/owslab-cekirdek.js" asp-append-version="true"></script>
    @if (dogrudan)
    {
        <script>document.getElementById("tkgmGirisDugmesi").href = OwsLab.GIRIS_SORGUSU;</script>
    }
    <script src="~/js/owslab-kurallar.js" asp-append-version="true"></script>
    <script src="~/js/owslab-laboratuvar.js" asp-append-version="true"></script>
    <script src="~/js/owslab-gorevler.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("click", async e => {
            const d = e.target.closest("[data-kopyala]");
            if (d && await OwsLab.panoyaKopyala(d.dataset.kopyala)) OwsLab.bildir("Panoya kopyalandı.");
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
