            "https://geoservices.informatik.kit.edu/geoserver/wfs": [49.0069, 8.4037, 10, "Karlsruhe, Almanya (KIT)"],
            "https://geodata.nationaalgeoregister.nl/top10nl/wfs": [52.37, 4.89, 8, "Amsterdam, Hollanda"],
            "https://geoportal.cuzk.cz/wfs_ruian": [50.0755, 14.4378, 8, "Prag, Çekya"],
            "https://wfs.geoportal.gov.pl/wfs_dz": [52.2297, 21.0122, 7, "Varşova, Polonya"],
            "https://inspire.geoportail.lu/geoserver/wfs": [49.6117, 6.1319, 10, "Lüksemburg Şehri"],
            "https://wms.geo.admin.ch/": [46.9480, 7.4474, 9, "Bern, İsviçre (Swisstopo)"],
            "https://services.wien.gv.at/basemap/wfs/1.1.0/wfs": [48.2082, 16.3738, 10, "Viyana, Avusturya"],
            "https://geoservices.icgc.cat/icc_geoserver/wfs": [41.3851, 2.1734, 9, "Barselona, İspanya (Katalonya)"],
            "https://geoserver.sdi.brno.cz/geoserver/wfs": [49.1951, 16.6068, 12, "Brno, Çekya"],
            "https://geoportal.jrc.ec.europa.eu/wfs/wfs": [50.8503, 4.3517, 5, "Brüksel, Belçika (JRC)"],
            "https://ws.geonames.net/wfs": [0, 0, 2, "GeoNames (Global)"],
            "https://geoservices.brgm.fr/geologie/wfs": [47.9029, 1.9093, 7, "Orléans, Fransa (BRGM)"],
            "https://geoserver.tnc.org/geoserver/wfs": [38.8951, -77.0369, 5, "Washington DC Bölgesi, ABD (TNC)"],
            "https://ows.terrestris.de/geoserver/wfs": [50.7374, 7.0877, 8, "Bonn, Almanya (Terrestris)"],
            "https://mapserver.spatialdev.com/wfs": [0, 0, 2, "MapServer Demo (Global)"],
            "custom_url": [39.92, 32.85, 6, "Türkiye Genel (Özel URL Varsayılan)"]
        };

        const [lat, lng, zoom, locationName] = centers[wfsUrl] || targetCenter;

        map.setView([lat, lng], zoom);
        logToConsole('INFO', `URL'ye göre harita otomatik olarak ${locationName} konumuna Zoom ${zoom} seviyesinde odaklandı.`);
    }


    // -----------------------------------------------------------
    // 2. KATMANLAR & UI MANTIĞI (OTOMATİK ALGILAMA & FORMAT AYARI)
    // -----------------------------------------------------------

    // GÜNCELLENEN FONKSİYON: Formatları URL'ye göre ayarlar
    function setDefaultFormat(wfsUrl) {
        const formatSelect = document.getElementById('downloadFormat');

        // OutputFormat seçeneklerini resetlemeden sadece değeri ayarla
        let defaultFormat = 'application/json'; // Genel GeoServer varsayılanı

        if (wfsUrl.includes('tkgm')) {
            defaultFormat = 'text/xml; subtype=gml/3.1.1'; // TKGM için varsayılan
        } else if (wfsUrl.includes('deegree') || wfsUrl.includes('wfp')) {
            defaultFormat = 'text/xml; subtype=gml/3.1.1';
        }

        // Mevcut seçenekler arasından default'u bul
        formatSelect.value = defaultFormat;
        if (!formatSelect.value) {
            formatSelect.value = formatSelect.options[0] ? formatSelect.options[0].value : 'application/json';
        }

        logToConsole('INFO', `Çıktı formatı "${formatSelect.options[formatSelect.selectedIndex].text}" olarak ayarlandı.`);
    }

    function populateLayerList(layers, defaultLayerName) {
        const listContainer = document.getElementById('availableLayersList');
        listContainer.innerHTML = "";

        document.getElementById('layerCount').innerText = layers.length;

        // UI Sıfırlama ve Hata Kontrolü
        if (layers.length === 0) {
            listContainer.innerHTML = `<div class="list-group-item text-danger">⚠️ Katman bulunamadı. Konsolu kontrol edin.</div>`;
            document.getElementById('typeNameInput').value = 'Katman Yok';
            document.getElementById('selectedLayer').value = '';
            return;
        }

        layers.forEach(l => {
            const item = document.createElement('a');
            let layerTitle = l.includes(':') ? l.split(':')[1] : l;

            item.className = 'list-group-item list-group-item-action py-1 text-truncate';
            item.innerHTML = `**${l}** <span class="badge bg-secondary text-light ms-1" style="font-weight: 400;">(${layerTitle})</span>`;
            item.onclick = (e) => {
                const selectedLayerName = e.currentTarget.getAttribute('data-typename');
                document.getElementById('selectedLayer').value = selectedLayerName;
                document.getElementById('typeNameInput').value = selectedLayerName;

                document.querySelectorAll('#availableLayersList .list-group-item').forEach(x => x.classList.remove('active'));
                e.currentTarget.classList.add('active');
                updateUrlPreview();
                updateDynamicWmsBaseLayer(); // ⬅️ DİNAMİK WMS Altlığını Güncelle
                logToConsole('INFO', `Katman seçildi: ${selectedLayerName}`);
            };
            item.setAttribute('data-typename', l);
            listContainer.appendChild(item);
        });

        // Varsayılan katmanı seçme mantığı
        let defaultItem = Array.from(listContainer.children).find(item => item.getAttribute('data-typename') === defaultLayerName);

        if (!defaultItem && layers.length > 0) {
            defaultItem = listContainer.firstChild;
            defaultLayerName = defaultItem.getAttribute('data-typename') || layers[0];
            logToConsole('WARNING', `Varsayılan katman (${defaultLayerName}) bulunamadı, ilk katman seçildi.`);
        }

        if (defaultItem) {
            defaultItem.classList.add('active');
            document.getElementById('selectedLayer').value = defaultLayerName;
            document.getElementById('typeNameInput').value = defaultLayerName;
            updateDynamicWmsBaseLayer(); // ⬅️ Varsayılanı seçince de güncelle
        }
    }

    // --- Core Layer Fetching Logic (Direct Mode + Auth) - GÜNCELLENDİ ---
    async function fetchLayersFromWFS(wfsUrl, isCustomUrl = false) {
        const cleanedUrl = wfsUrl.replace(/(\?.*)?$/, '');
        // WFS version 1.1.0/1.1.1 daha yaygın olduğu için varsayılanı 1.1.0'a çekelim
        const capabilitiesUrl = `${cleanedUrl}?service=WFS&version=1.1.0&request=GetCapabilities`;

        const targetUrl = capabilitiesUrl;
        const listContainer = document.getElementById('availableLayersList');

        // UI'ı temizle ve yükleme durumunu göster
        document.getElementById('loading-indicator').style.display = 'block';

        try {
            // AUTH HEADERS EKLENDİ (PROMPT DESTEKLİ)
            const headers = getAuthHeaders(cleanedUrl);
            const res = await fetch(targetUrl, { headers: headers });

            // HTTP 404, 500 veya 401 gibi hatalar için kontrol
            if (!res.ok) {
                const errorText = await res.text();
                logToConsole('ERROR', `Capabilities isteği başarısız oldu (HTTP ${res.status}). Sunucu hata yanıtı Response Data sekmesinde olabilir.`);
                throw new Error(`HTTP ${res.status} Hatası: Sunucudan Katman bilgisi alınamadı. (Yetkilendirme sorunu olabilir)`);
            }

            const xmlText = await res.text();
            const parser = new DOMParser();
            const xmlDoc = parser.parseFromString(xmlText, "text/xml");

            // XML ayrıştırma hatası kontrolü
            if (xmlDoc.getElementsByTagName("parsererror").length > 0) {
                logToConsole('ERROR', 'Sunucudan gelen yanıt geçerli bir XML belgesi değil. Yanıtı Response Data sekmesinde kontrol edin.');
                throw new Error('Geçersiz XML Yanıtı. WFS URL\'si doğru olmayabilir.');
            }

            currentWfsVersion = xmlDoc.documentElement.getAttribute('version') || '1.1.0';

            const exception = xmlDoc.getElementsByTagName('ServiceException');
            if (exception.length > 0) {
                throw new Error(`WFS Servis Hatası: ${exception[0].textContent || 'Bilinmeyen Hata'}`);
            }

            const featureTypes = xmlDoc.getElementsByTagNameNS('*', 'FeatureType');
            const layerNames = [];

            for (let i = 0; i < featureTypes.length; i++) {
                const nameElement = featureTypes[i].getElementsByTagNameNS('*', 'Name')[0];
                if (nameElement && nameElement.textContent) {
                    layerNames.push(nameElement.textContent);
                }
            }

            if (layerNames.length > 0) {
                logToConsole('SUCCESS', `${layerNames.length} adet katman başarıyla algılandı.`);

                if (isCustomUrl) {
                    CUSTOM_LAYERS = layerNames;
                }

                setDefaultFormat(cleanedUrl);
                populateLayerList(layerNames, layerNames[0]);
                return layerNames;
            } else {
                logToConsole('WARNING', 'Capabilities belgesinde FeatureType bulunamadı (Katman listesi boş).');
                populateLayerList([], '');
                return [];
            }


        } catch (e) {
            logToConsole('ERROR', `Katman algılama HATA KODU: ${e.message}`);

            // Hata durumunda UI'ı güncelle
            listContainer.innerHTML = `<div class="list-group-item text-danger">❌ HATA: Yükleme Başarısız! Detaylar için Konsolu kontrol edin. (${e.message.substring(0, 50)}...)</div>`;
            document.getElementById('layerCount').innerText = '0';
            document.getElementById('typeNameInput').value = 'YÜKLEME BAŞARISIZ';
            document.getElementById('selectedLayer').value = '';
            return [];
        } finally {
            document.getElementById('loading-indicator').style.display = 'none';
            updateUrlPreview(); // Hata olsa bile URL önizlemesini güncelle
        }
    }


    // GÜNCELLENDİ: loadLayers mantığı
    function loadLayers(isUrlChange = false) {
        const wfsUrlSelect = document.getElementById('wfsUrlSelect');
        const selectedUrlOption = wfsUrlSelect.value;
        const customUrlGroup = document.getElementById('customUrlGroup');
        const listContainer = document.getElementById('availableLayersList');

        customUrlGroup.style.display = 'none';

        // UI temizleme
        listContainer.innerHTML = '<div class="list-group-item text-info">⏳ Yeni URL için katmanlar yükleniyor...</div>';
        document.getElementById('layerCount').innerText = '0';
        document.getElementById('selectedLayer').value = '';
        document.getElementById('typeNameInput').value = 'YÜKLENİYOR...';

        if (selectedUrlOption.includes('tkgm')) {
            setDefaultFormat(selectedUrlOption);
            populateLayerList(LAYERS_TKGM, "TKGM:parseller");

        } else if (selectedUrlOption === 'custom_url') {
            // 2. Özel URL
            customUrlGroup.style.display = 'flex';
            listContainer.innerHTML = '<div class="list-group-item text-danger">⚠️ Lütfen URL girip Algıla\'ya basın.</div>';
            document.getElementById('typeNameInput').value = 'URL Girin / Algılayın';
            setDefaultFormat(selectedUrlOption);


        } else {
            // 3. Önceden Tanımlı Harici URL'ler
            const cleanedUrl = selectedUrlOption.split('?')[0];
            fetchLayersFromWFS(cleanedUrl, false);
        }

        updateDynamicWmsBaseLayer(); // ⬅️ YENİ EKLENDİ

        updateOperationParams(true);
        if (isUrlChange) centerMapToTKGMDefault();
    }

    // GÜNCELLENDİ: detectAndLoadLayers mantığı
    async function detectAndLoadLayers() {
        const rawUrl = document.getElementById('customWfsUrlInput').value.trim();
        const wfsUrlSelect = document.getElementById('wfsUrlSelect');

        if (!rawUrl || !rawUrl.toLowerCase().includes('wfs')) {
            logToConsole('ERROR', 'Geçerli bir WFS URL\'si girin.');
            alert('Geçerli bir WFS URL\'si girin.');
            return;
        }

        const cleanedUrl = rawUrl.split('?')[0];
        const layers = await fetchLayersFromWFS(cleanedUrl, true);

        if (layers && layers.length > 0) {
            const customOption = wfsUrlSelect.querySelector('option[value="custom_url"]');

            customOption.value = cleanedUrl;
            customOption.text = `🔗 Özel URL: ${cleanedUrl.substring(0, 30)}${cleanedUrl.length > 30 ? '...' : ''}`;

            wfsUrlSelect.value = cleanedUrl;
            document.getElementById('customUrlGroup').style.display = 'none';

            centerMapToTKGMDefault();
            updateOperationParams();
        }
    }


    function updateOperationParams(skipPreview = false) {
        const operation = document.getElementById('wfsOperationSelect').value;
        const typeSelectionGroup = document.getElementById('typeSelectionGroup');
        const getFeatureParams = document.getElementById('getFeatureParams');
        const downloadContainer = document.getElementById('download-section-container');

