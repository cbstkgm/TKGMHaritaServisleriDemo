    // 5. İŞLEMLER (ÖNİZLEME VE İNDİRME - AUTH DESTEKLİ)
    // -----------------------------------------------------------

    // Haritada Önizle butonu
    // Haritada Önizle butonu (GÜNCELLENMİŞ DETAYLI KONTROL)
    async function previewData() {
        const operationSelect = document.getElementById('wfsOperationSelect');
        const operation = operationSelect.value;

        const layerInput = document.getElementById('selectedLayer');
        const typeName = layerInput.value;

        const startTime = performance.now();

        // HATA AYIKLAMA: Sorunun kaynağını netleştirelim
        if (operation !== 'GetFeature') {
            alert(`⚠️ İŞLEM HATASI:\n\nŞu an seçili işlem: '${operation}'\nHaritada önizleme yapabilmek için 'WFS İşlemi' menüsünden 'GetFeature (Veri Çekme)' seçmelisiniz.`);
            logToConsole('ERROR', `Hata: İşlem tipi '${operation}' iken harita önizleme yapılamaz. GetFeature seçilmeli.`);
            return;
        }

        if (!typeName) {
            alert("⚠️ KATMAN SEÇİLMEDİ:\n\nLütfen listeden bir katman (Örn: TKGM:parseller) seçiniz.");
            logToConsole('ERROR', "Hata: Herhangi bir katman seçilmediği için işlem başlatılamadı.");
            return;
        }

        // --- Buradan sonrası standart işlem ---
        const targetUrl = buildRequestUrl('application/json');

        logToConsole('INFO', `Harita önizlemesi için GeoJSON isteği gönderiliyor: ${typeName}`);
        document.getElementById('loading-indicator').style.display = 'block';

        try {
            const wfsUrlSelect = document.getElementById('wfsUrlSelect');
            const headers = getAuthHeaders(wfsUrlSelect.value.split('?')[0]);

            const response = await fetch(targetUrl, { headers: headers });
            const responseText = await response.text();
            const duration = (performance.now() - startTime).toFixed(0);

            // Yanıtı Response sekmesine yazdır
            displayResponse(responseText, response.status, response.headers.get("content-type"), duration);
            new bootstrap.Tab(document.getElementById('response-tab')).show();

            // JSON Kontrolü
            if (responseText.includes('ExceptionReport') || responseText.includes('InvalidParameterValue')) {
                logToConsole('ERROR', 'Sunucu GeoJSON formatını desteklemiyor veya sorgu hatalı.');
                alert("Sunucudan HATA döndü. 'Response Data' sekmesini kontrol edin.");
                return;
            }

            try {
                const geojson = JSON.parse(responseText);

                if (previewLayer) map.removeLayer(previewLayer);

                previewLayer = L.geoJSON(geojson, {
                    style: { color: "#08ea5e", weight: 3, opacity: 0.8 },
                    onEachFeature: function (feature, layer) {
                        let popupContent = '<h6>Öznitelikler</h6>';
                        if (feature.properties) {
                            for (let key in feature.properties) {
                                popupContent += `<strong>${key}:</strong> ${feature.properties[key]}<br>`;
                            }
                        }
                        layer.bindPopup(popupContent);
                    }
                }).addTo(map);

                if (previewLayer.getLayers().length > 0) {
                    map.fitBounds(previewLayer.getBounds());
                    logToConsole('SUCCESS', `Harita güncellendi. ${geojson.features.length} adet kayıt yüklendi.`);
                } else {
                    logToConsole('WARNING', 'Sorgu başarılı ama 0 kayıt döndü (Kesişim alanında veri olmayabilir).');
                    alert("Sorgu başarılı ancak bu alanda veri bulunamadı (0 kayıt).");
                }

            } catch (jsonError) {
                console.error(jsonError);
                logToConsole('ERROR', 'Gelen veri JSON formatında değil.');
            }

        } catch (e) {
            logToConsole('ERROR', `İstek hatası: ${e.message}`);
        } finally {
            document.getElementById('loading-indicator').style.display = 'none';
        }
    }

    // İndirme Düğmesi
    async function downloadData() {
        const operation = document.getElementById('wfsOperationSelect').value;
        const typeName = document.getElementById('selectedLayer').value;
        const startTime = performance.now();

        if (operation !== 'GetFeature' || !typeName) {
            alert("Lütfen 'GetFeature' işlemi ve geçerli bir Katman Adı seçin.");
            logToConsole('ERROR', "İndirme için 'GetFeature' ve Katman Adı gerekli.");
            return;
        }

        const format = document.getElementById('downloadFormat').value;
        const targetUrl = buildRequestUrl(format);

        logToConsole('INFO', `İndirme başlatılıyor (${getIframeFormatName(format)} formatında).`);

        const layerName = document.getElementById('selectedLayer').value.split(':')[1];
        let extension = "dat";
        if (format.includes("json")) extension = "json";
        else if (format.includes("gml")) extension = "gml";
        else if (format.includes("kml")) extension = "kml";
        else if (format.includes("zip") || format.includes("SHAPE-ZIP")) extension = "zip";
        else if (format.includes("csv")) extension = "csv";

        const filename = `${layerName}_export_${Date.now()}.${extension}`;

        document.getElementById('loading-indicator').style.display = 'block';

        try {
            // AUTH HEADERS EKLENDİ (PROMPT DESTEKLİ)
            const wfsUrlSelect = document.getElementById('wfsUrlSelect');
            const headers = getAuthHeaders(wfsUrlSelect.value.split('?')[0]);

            const response = await fetch(targetUrl, { headers: headers });
            const responseStatus = response.status;
            const contentType = response.headers.get("content-type");

            const rawData = await response.clone().text();
            const duration = (performance.now() - startTime).toFixed(0);
            displayResponse(rawData, responseStatus, contentType, duration);
            new bootstrap.Tab(document.getElementById('response-tab')).show();


            if (!response.ok) {
                logToConsole('ERROR', `İndirme Hatası (HTTP ${responseStatus}): Sunucu Hata Raporu Response Data sekmesinde.`);
                throw new Error(`İndirme Hatası (HTTP: ${responseStatus})`);
            }

            const blob = await response.blob();
            const downloadUrl = window.URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = downloadUrl;
            a.download = filename;
            document.body.appendChild(a);
            a.click();

            logToConsole('SUCCESS', `Dosya başarıyla indirildi: ${filename}`);

            window.URL.revokeObjectURL(downloadUrl);
            document.body.removeChild(a);

        } catch (e) {
            logToConsole('ERROR', `İndirme sırasında hata oluştu. Hata: ${e.message}.`);
            alert("İndirme sırasında hata oluştu. Detaylar için konsolu kontrol edin. Hata: " + e.message);
        } finally {
            document.getElementById('loading-indicator').style.display = 'none';
        }
    }


    // Diğer yardımcı fonksiyonlar (formatXml, displayResponse, copyResponse, toggleWrap)
    function formatXml(xml) {
        if (!xml) return '';
        var formatted = '';
        var reg = /(>)(<)(\/*)/g;
        xml = xml.replace(reg, '$1\r\n$2$3');
        var pad = 0;
        xml.split('\r\n').forEach(function (node) {
            var indent = 0;
            if (node.match(/.+<\/\w[^>]*>$/)) {
                indent = 0;
            } else if (node.match(/^<\/\w/)) {
                if (pad != 0) pad -= 1;
            } else if (node.match(/^<\w[^>]*[^\/]>.*$/)) {
                indent = 1;
            } else {
                indent = 0;
            }
            var padding = '';
            for (var i = 0; i < pad; i++) padding += '  ';
            formatted += padding + node + '\r\n';
            pad += indent;
        });
        return formatted;
    }

    function displayResponse(data, status, contentType, duration) {
        const output = document.getElementById('responseOutput');
        const badge = document.getElementById('responseStatusBadge');
        const timeBadge = document.getElementById('responseTimeBadge');

        badge.innerText = `HTTP ${status}`;
        badge.className = status >= 200 && status < 300 ? "badge bg-success" : "badge bg-danger";

        timeBadge.innerText = `${duration}ms`;
        timeBadge.style.display = 'inline-block';

        let formattedContent = "";
        let languageClass = "language-json";

        let dataStr = typeof data === 'string' ? data : JSON.stringify(data);

        if (contentType && contentType.includes('json') && typeof data === 'object') {
            formattedContent = JSON.stringify(data, null, 2);
            languageClass = "language-json";
        } else if (dataStr.trim().startsWith('<')) {
            formattedContent = formatXml(dataStr);
            languageClass = "language-xml";
        } else {
            formattedContent = dataStr || 'Yanıt içeriği boş.';
            languageClass = "language-plaintext";
        }

        output.className = languageClass;
        output.textContent = formattedContent;

        if (window.hljs) {
            hljs.highlightElement(output);
        }
    }

    function copyResponse() {
        const text = document.getElementById('responseOutput').textContent;
        navigator.clipboard.writeText(text).then(() => {
            alert("Yanıt panoya kopyalandı!");
            logToConsole('INFO', 'Sunucu yanıtı panoya kopyalandı.');
        });
    }

    function toggleWrap() {
        const codeBlock = document.getElementById('responseOutput');
        const isWrapped = codeBlock.style.whiteSpace === 'pre-wrap';
        codeBlock.style.whiteSpace = isWrapped ? 'pre' : 'pre-wrap';
        logToConsole('INFO', `Satır kaydırma: ${isWrapped ? 'Kapatıldı' : 'Açıldı'}.`);
    }

    // Input/Select Değişikliklerini Dinle
    document.getElementById('cqlInput').addEventListener('input', updateUrlPreview);
    document.getElementById('downloadFormat').addEventListener('change', updateUrlPreview);
    document.getElementById('maxFeatures').addEventListener('change', updateUrlPreview);
    document.querySelectorAll('input[name="spatialMode"]').forEach(r => r.addEventListener('change', updateUrlPreview));

    // WFS URL değiştiğinde hem katmanları yükle hem de haritayı odakla.
    document.getElementById('wfsUrlSelect').addEventListener('change', () => loadLayers(true));

    // Yeni birleştirilmiş sekmeye tıklandığında içeriğin yüklenmesini sağla
    document.getElementById('download-iframe-tab').addEventListener('click', loadIframeContent);

    // Harita hareketlerini ve zoom'u dinle, WMS URL'sini güncelle
    map.on('moveend', updateUrlPreview);
    map.on('zoomend', updateUrlPreview);

    // Sayfa yüklendiğinde başlat
    window.onload = function() {
        logToConsole('INFO', 'WFS Eğitim Portalı başlatıldı. Tüm işlevler aktif.');

        // Çağrı 1: loadLayers, hem katmanları yükler hem de haritayı odaklar.
        loadLayers(true);

        // Çağrı 2: Son ve tek geçerli çağrı.
        // updateUrlPreview çağrısı, loadLayers bittikten sonra layer adıyla çalışmalıdır.
        // loadLayers içinde updateUrlPreview zaten çağrılıyor.
        // Burada tekrar çağırmaya gerek yok, ancak harita hareketlerini dinlemek için harita event listener'ları eklenmiştir.
    };
</script>

