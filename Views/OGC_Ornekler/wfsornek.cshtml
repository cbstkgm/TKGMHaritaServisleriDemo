@{
Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TKGM WFS Eğitim & İndirme Portalı (Auth Mode)</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/atom-one-dark.min.css">

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0f2f5;
            color: #333;
            display: flex;
            flex-direction: column;
        }

        .map-container {
            height: 600px;
            width: 100%;
            border-radius: 0 0 12px 12px;
            z-index: 1;
            border: 2px solid #dee2e6;
        }

        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            margin-bottom: 20px;
        }

        .col-lg-9 .card.mb-3 {
            margin-bottom: 0 !important;
        }
        .card-header {
            background-color: #fff;
            border-bottom: 1px solid #eee;
            font-weight: 600;
            color: #2c5364;
            padding: 15px;
        }

        #console-pane {
            background-color: #1e1e1e;
            color: #ccc;
            padding: 15px;
            border-radius: 0 0 8px 8px;
            font-family: 'Consolas', monospace;
            font-size: 0.85rem;
            max-height: 400px;
            overflow-y: auto;
            white-space: pre-wrap;
        }
        .log-timestamp { color: #888; margin-right: 8px; }
        .log-info { color: #6cb6ff; }
        .log-success { color: #85c868; }
        .log-error { color: #ff6a6a; }
        .log-warning { color: #dcdcaa; }

        #requestResponseTabs .tab-pane {
            background-color: #282c34;
            color: #abb2bf;
            padding: 15px;
            border-radius: 0 0 8px 8px;
            font-family: 'Consolas', monospace;
            font-size: 0.85rem;
            max-height: 400px;
            overflow: auto;
        }
        #requestResponseTabs .nav-link {
            border: none !important;
            border-radius: 8px 8px 0 0 !important;
            color: #ccc;
            background-color: #495057;
            margin-right: 2px;
            padding: 8px 15px;
        }

        #requestResponseTabs .nav-link.active {
            background-color: #282c34;
            color: #fff;
        }

        #download-iframe-pane {
            background-color: #fff;
            color: #333;
            padding: 0;
            max-height: 400px;
            overflow-y: hidden;
        }

        #download-section-container {
            height: 100%;
        }

        #download-section {
            padding-bottom: 15px;
            border-bottom: 1px solid #eee;
            margin-bottom: 15px;
            flex-grow: 1;
        }

        #iframe-display-section {
            border: 1px solid #ccc;
            border-radius: 4px;
            overflow: hidden;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            height: 100%;
            min-height: 350px;
        }

        #liveResultFrameInTab {
            flex-grow: 1;
            height: 100%;
            min-height: 150px;
        }

        .navbar {
            background: linear-gradient(135deg, #ea082a 0%, #203a43 85%, #2c5364 100%);
        }

        .leaflet-control-wkt-button a,
        .leaflet-control-bbox-button a {
            background-image: none !important;
            background-color: #2c5364 !important;
            color: white !important;
            font-weight: bold;
            padding: 0 8px;
            box-shadow: 0 4px 12px rgb(234, 8, 42);
            line-height: 30px;
            text-decoration: none;
            font-size: 0.85rem;
        }

        .leaflet-control-wkt-button a:hover,
        .leaflet-control-bbox-button a:hover {
            background-color: #203a43 !important;
        }

        .leaflet-control-wkt-button {
            margin-right: 5px;
        }

        .leaflet-control-coordinate-info {
            background-color: rgba(255, 255, 255, 0.85);
            padding: 5px 10px;
            margin: 5px;
            border-radius: 4px;
            box-shadow: 0 1px 5px rgba(0,0,0,0.4);
            font-size: 0.75rem;
            color: #333;
            font-weight: 600;
            cursor: default;
        }

        /* Katman listesi yazı boyutunu küçültür */
        #availableLayersList .list-group-item {
            font-size: 0.75rem; /* Yazı boyutu (yaklaşık 12px) */
            padding-top: 4px !important;    /* Satır aralığını daralt */
            padding-bottom: 4px !important;
        }
    </style>
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark mb-4">
    <div class="container-fluid px-4">
        <a class="navbar-brand d-flex align-items-center" href="#">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor"
                 class="bi bi-hdd-network me-2" viewBox="0 0 16 16">
                <path d="M4.5 5a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1zM3 4.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0z" />
                <path
                    d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v1a2 2 0 0 1-2 2H8.5v3a1.5 1.5 0 0 1 1.5 1.5h5.5a.5.5 0 0 1 0 1H10A1.5 1.5 0 0 1 8.5 14h-1A1.5 1.5 0 0 1 6 12.5H.5a.5.5 0 0 1 0-1H6A1.5 1.5 0 0 1 7.5 11V7H2a2 2 0 0 1-2-2V4zm1 0v1a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1zm6 7.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5z" />
            </svg>
            TKGM WFS | Eğitim & Veri İndirme Portalı
        </a>
        <button class="btn btn-outline-light btn-sm" data-bs-toggle="modal"
                data-bs-target="#cheatSheetModal">
            📖 Operatör Rehberi
        </button>
    </div>
</nav>

<div class="container-fluid px-4 flex-grow-1">
    <div class="row flex-grow-1">
        <div class="col-lg-3">

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>⚙️ Servis & İşlem Seçimi</span>
                    <span class="badge bg-secondary rounded-pill" id="layerCount">0</span>
                </div>
                <div class="card-body p-3">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">WFS URL</label>
                        <select class="form-select form-select-sm mb-2" id="wfsUrlSelect">


                            <option value="https://cbsservis.tkgm.gov.tr/tkgm.ows/wfs" selected>🇹🇷 TKGM (Tapu Kadastro)</option>
                            <option value="custom_url">🔗 Özel URL (Yapıştır)</option>
                            <option disabled>--- AÇIK KAYNAK WFS LİSTESİ (20) ---</option>

                            <option value="https://ahocevar.com/geoserver/wfs">🌎 GeoServer Demo (Ahocevar)</option>
                            <option value="https://demo.deegree.org/deegree-webservices/services/wfs110">🇩🇪 deegree Demo (WFS 1.1.0)</option>
                            <option value="https://wfs.geonode.com/geonode/wfs">🌐 GeoNode Demo Server</option>
                            <option value="https://geonode.wfp.org/geoserver/wfs">🌐 WFP GeoNode (BM)</option>
                            <option value="https://geoservices.informatik.kit.edu/geoserver/wfs">🇩🇪 KIT University Demo</option>

                            <option value="https://geodata.nationaalgeoregister.nl/top10nl/wfs">🇳🇱 NL Top10NL (Hollanda)</option>
                            <option value="https://geoportal.cuzk.cz/wfs_ruian">🇨🇿 Czech Cadaster (RUIAN)</option>
                            <option value="https://wfs.geoportal.gov.pl/wfs_dz">🇵🇱 Poland Cadaster (WFS)</option>
                            <option value="https://inspire.geoportail.lu/geoserver/wfs">🇱🇺 Luxembourg INSPIRE</option>
                            <option value="https://wms.geo.admin.ch/">🇨🇭 Swisstopo (WFS Endpoint)</option>
                            <option value="https://services.wien.gv.at/basemap/wfs/1.1.0/wfs">🇦🇹 Vienna Base Map</option>
                            <option value="https://geoservices.icgc.cat/icc_geoserver/wfs">🇪🇸 ICGC Catalonia (İspanya)</option>
                            <option value="https://geoserver.sdi.brno.cz/geoserver/wfs">🇨🇿 Brno City Data (SDI)</option>
                            <option value="https://geoportal.jrc.ec.europa.eu/wfs/wfs">🇪🇺 JRC Joint Research Centre</option>
                            <option value="https://ws.geonames.net/wfs">🌐 GeoNames (WFS)</option>
                            <option value="https://geoservices.brgm.fr/geologie/wfs">🇫🇷 BRGM (Fransa Jeoloji)</option>
                            <option value="https://geoserver.tnc.org/geoserver/wfs">🇺🇸 The Nature Conservancy</option>

                            <option value="https://ows.terrestris.de/geoserver/wfs">🇩🇪 Terrestris Demo</option>
                            <option value="https://demo.deegree.org/deegree-webservices/services/wfs200">🇩🇪 deegree Demo (WFS 2.0.0)</option>
                            <option value="https://mapserver.spatialdev.com/wfs">🇺🇸 MapServer Demo</option>

                        </select>

                        <div id="customUrlGroup" style="display: none;" class="input-group input-group-sm">
                            <input type="text" class="form-control" id="customWfsUrlInput"
                                   placeholder="Örn: https://example.com/geoserver/wfs">
                            <button class="btn btn-primary" type="button" id="detectWfsUrlButton" onclick="detectAndLoadLayers()">
                                🔍 Algıla
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">WFS İşlemi (Request)</label>
                        <select class="form-select form-select-sm" id="wfsOperationSelect"
                                onchange="updateOperationParams(); logToConsole('INFO', 'WFS Request değiştirildi: ' + this.value);">
                            <option value="GetFeature" selected>GetFeature (Veri Çekme)</option>
                            <option value="GetCapabilities">GetCapabilities (Yetkinlikleri Öğren)</option>
                            <option value="DescribeFeatureType">DescribeFeatureType (Şema/Öznitelik Öğren)
                            </option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    🔍 Parametreler
                </div>
                <div class="card-body">

                    <div id="typeSelectionGroup" class="operation-group">
                        <label class="form-label small fw-bold">Katman Adı (TypeName)</label>
                        <input type="text" class="form-control form-control-sm mb-2 text-primary fw-bold"
                               id="typeNameInput" value="TKGM:mahalleler" readonly>
                        <div class="scrollable-list mb-3" style="max-height: 150px; overflow-y: auto;">
                            <div class="list-group list-group-flush" id="availableLayersList"></div>
                        </div>
                        <input type="hidden" id="selectedLayer" value="TKGM:mahalleler">
                    </div>

                    <div id="getFeatureParams" class="operation-group">

                        <label class="form-label small fw-bold">Mekansal Kısıt (Spatial)</label>
                        <div class="btn-group w-100 mb-2" role="group">
                            <input type="radio" class="btn-check" name="spatialMode" id="modeBbox"
                                   value="BBOX" checked>
                            <label class="btn btn-outline-light text-dark btn-sm" for="modeBbox">⬜
                                BBOX</label>

                            <input type="radio" class="btn-check" name="spatialMode" id="modeIntersects"
                                   value="INTERSECTS">
                            <label class="btn btn-outline-light text-dark btn-sm" for="modeIntersects">🔷
                                INTERSECTS</label>
                        </div>
                        <div id="drawStatus" class="badge bg-secondary w-100 mb-3">Çizim Yok</div>

                        <label class="form-label small fw-bold">Öznitelik Filtresi (CQL)</label>
                        <div class="input-group input-group-sm mb-3">
                            <input type="text" class="form-control" id="cqlInput"
                                   placeholder="Örn: tapumahallead ilike '%Hızırpaşa%'" oninput="updateUrlPreview()">
                            <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('cqlInput').value=''; updateUrlPreview(); logToConsole('INFO', 'CQL filtresi temizlendi.');">X</button>
                        </div>

                        <label class="form-label small fw-bold">Max Kayıt Sayısı</label>
                        <input type="number" class="form-control form-control-sm mb-3" id="maxFeatures"
                               value="1000" oninput="updateUrlPreview()">
                    </div>

                    <button class="btn btn-primary w-100 btn-sm mb-2" onclick="previewData()">
                        👁️ Haritada Önizle (Fetch)
                    </button>
                </div>
            </div>

        </div>

        <div class="col-lg-9 d-flex flex-column">
            <div class="card mb-3">
                <div class="card-body p-0 position-relative">
                    <div id="loading-indicator"
                         style="display:none; position:absolute; z-index:999; top:50%; left:50%; transform:translate(-50%, -50%); background:rgba(255,255,255,0.9); padding:20px; border-radius:10px; border:1px solid #ccc; text-align:center">
                        <div class="spinner-border text-primary" role="status"></div>
                        <div class="fw-bold mt-2">Veri İşleniyor...</div>
                    </div>
                    <div id="map" class="map-container"></div>
                </div>
            </div>

            <div class="card bg-dark text-white mt-3 border-secondary p-0 flex-grow-1" id="requestResponseTabs">
                <ul class="nav nav-tabs border-0" id="responseTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="request-tab" data-bs-toggle="tab"
                                data-bs-target="#request-pane" type="button" role="tab"
                                aria-controls="request-pane" aria-selected="true">
                            1. 🔗 Request URL
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="response-tab" data-bs-toggle="tab"
                                data-bs-target="#response-pane" type="button" role="tab"
                                aria-controls="response-pane" aria-selected="false">
                            2. 📡 Response Data
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="download-iframe-tab" data-bs-toggle="tab"
                                data-bs-target="#download-iframe-pane" type="button" role="tab"
                                aria-controls="download-iframe-pane" aria-selected="false" onclick="loadIframeContent()">
                            3. 💾 İndirme & Görüntüleyici
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="console-tab" data-bs-toggle="tab"
                                data-bs-target="#console-pane" type="button" role="tab"
                                aria-controls="console-pane" aria-selected="false">
                            4. 💻 Console
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="external-link-tab" onclick="openExternalUrl()">
                            🔗 Harici URL'de Aç
                        </button>
                    </li>
                </ul>

                <div class="tab-content border-0 h-100" id="responseTabContent">
                    <div class="tab-pane fade show active p-3 h-100" id="request-pane" role="tabpanel"
                         aria-labelledby="request-tab" tabindex="0">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold small me-2 text-white-50">1. Oluşturulan URL (Direct WFS İsteği)</span>
                        </div>
                        <pre class="m-0" style="background: none; padding: 0;"><code class="language-http" id="urlDisplay" style="max-height:100%; height:100%; overflow-y:auto; white-space: pre-wrap; display: block;">Henüz istek oluşturulmadı...</code></pre>

                        <hr class="my-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold small me-2 text-warning">2. WMS URL'si (GetMap - Harita Görünümüne Göre)</span>
                        </div>
                        <pre class="m-0" style="background: none; padding: 0;"><code class="language-http" id="wmsUrlDisplay" style="max-height:100%; height:100%; overflow-y:auto; white-space: pre-wrap; display: block;">WMS URL'si hazırlanıyor...</code></pre>
                    </div>

                    <div class="tab-pane fade h-100" id="response-pane" role="tabpanel"
                         aria-labelledby="response-tab" tabindex="0">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center">
                                <span id="responseStatusBadge" class="badge bg-dark border border-secondary text-light">Bekleniyor...</span>
                                <span id="responseTimeBadge" class="badge bg-dark border border-secondary text-light ms-1" style="display:none">0ms</span>
                            </div>
                            <div>
                                <div class="btn-group btn-group-sm me-2" role="group">
                                    <button type="button" class="btn btn-outline-light" onclick="toggleWrap()" title="Satır Kaydırmayı Aç/Kapat">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-text-wrap" viewBox="0 0 16 16">
                                            <path d="M2.5 10a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 0 0 1H3a.5.5 0 0 0-.5-.5z" />
                                        </svg>
                                    </button>
                                </div>
                                <button class="btn btn-sm btn-light fw-bold" onclick="copyResponse()">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-clipboard me-1" viewBox="0 0 16 16">
                                        <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z" />
                                        <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z" />
                                    </svg>
                                    Kopyala
                                </button>
                            </div>
                        </div>
                        <pre class="m-0 h-100" style="background: none; padding: 0;"><code id="responseOutput" class="language-json" style="max-height: 100%; height: 100%; overflow: auto; display:block;">Henüz istek gönderilmedi. WFS işlemini başlatınız.</code></pre>
                    </div>

                    <div class="tab-pane fade h-100" id="console-pane" role="tabpanel"
                         aria-labelledby="console-tab" tabindex="0">
                        <pre id="consoleOutput" style="background: none; padding: 0; margin: 0; max-height: 100%; height: 100%; overflow: auto;"></pre>
                    </div>

                    <div class="tab-pane fade h-100 p-3" id="download-iframe-pane" role="tabpanel"
                         aria-labelledby="download-iframe-tab" tabindex="0">

                        <div class="row g-4 h-100">
                            <div id="download-section-container" class="col-lg-6 d-flex flex-column">
                                <div id="download-section" class="card p-3 border-success border-2 bg-light text-dark flex-grow-1">
                                    <h5 class="fw-bold text-success">💾 İndirme Seçenekleri ve Bilgilendirmesi</h5>
                                    <hr class="my-2">

                                    <label class="form-label small fw-bold">iFrame & İndirme Formatı Seçimi</label>
                                    <select class="form-select form-select-sm mb-3" id="downloadFormat"
                                            onchange="updateUrlPreview(); loadIframeContent(); logToConsole('INFO', 'İndirme/Görüntüleme formatı: ' + this.options[this.selectedIndex].text);">
                                        <option value="text/xml; subtype=gml/3.1.1" selected>GML 3.1.1 (.xml)</option>
                                        <option value="application/json">GeoJSON (.json)</option>
                                        <option value="GML2">GML 2.0 (.xml)</option>
                                        <option value="KML">KML (.kml)</option>
                                        <option value="SHAPE-ZIP">Shapefile (.zip)</option>
                                        <option value="csv">CSV (Sadece Öznitelik)</option>
                                    </select>

                                    <button class="btn btn-success w-100 fw-bold mb-3" onclick="downloadData()">
                                        📥 DOSYAYI İNDİR
                                    </button>


                                    <div class="alert alert-info small py-1 flex-grow-1" style="font-size:0.7rem">
                                        **İNDİRME URL ÖNİZLEMESİ**
                                        <pre class="m-0" style="background: none; padding: 0; white-space: pre-wrap;"><code class="language-http" id="downloadUrlDisplay" style="font-size: 0.7rem; color: #e60707;">...</code></pre>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6 d-flex flex-column">
                                <div id="iframe-display-section" class="flex-grow-1 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-center bg-light p-2 border-bottom">
                                        <span class="small fw-bold text-dark">iFrame'de Canlı Servis Yanıtı Görüntüleyici:</span>
                                        <span class="badge bg-primary ms-2" id="iframeFormatBadge">GML 3.1.1 (.xml)</span>
                                    </div>
                                    <iframe id="liveResultFrameInTab" src="" frameborder="0" style="width: 100%; height: 100%; min-height: 200px;"></iframe>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cheatSheetModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">📚 CQL & WFS Operatör Rehberi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="accordion" id="accordionOps">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#collapse1">1. Karşılaştırma Operatörleri
                                (Comparison)</button>
                        </h2>
                        <div id="collapse1" class="accordion-collapse collapse show">
                            <div class="accordion-body">
                                <p>Sayısal ve metinsel değerlerin eşitlik veya büyüklük durumlarını kontrol
                                    eder.</p>
                                <ul>
                                    <li>Eşittir: <code>CITY_NAME = 'Ankara'</code></li>
