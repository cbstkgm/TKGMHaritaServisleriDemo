    // -----------------------------------------------------------
    // 2.1. DİNAMİK WMS ALTLIĞI YÖNETİCİSİ (YENİ EKLENDİ)
    // -----------------------------------------------------------

    /**
     * Seçilen WFS Katmanını WMS TileLayer olarak harita altlığına ekler/günceller.
     * Bu katman, harita altlığı katmanlarının üzerine dinamik olarak eklenir.
     */
    function updateDynamicWmsBaseLayer() {
        const wfsUrl = document.getElementById('wfsUrlSelect').value;
        const typeName = document.getElementById('selectedLayer').value;
        const isTkgm = wfsUrl.includes('tkgm.ows');

        // 1. Önceki dinamik katmanı kaldır (Bu katman, çekilen WFS verisi DEĞİL, WMS altlığıdır)
        if (dynamicWmsBaseLayer) {
            map.removeLayer(dynamicWmsBaseLayer);
        }

        // Geçerli katman ve URL kontrolü
        if (!typeName || typeName === 'YÜKLENİYOR...' || typeName === 'Katman Yok' || wfsUrl.includes('custom_url')) {
            dynamicWmsBaseLayer = null; // WMS altlığı yok
            return;
        }

        // WFS URL'sini WMS Endpoint'ine çevir
        let wmsEndpointUrl = wfsUrl.split('?')[0];
        if (wmsEndpointUrl.includes('/wfs')) {
            wmsEndpointUrl = wmsEndpointUrl.replace('/wfs', '/wms');
        }

        // WMS katmanını oluştur (Bu bir Base Layer DEĞİL, üst katmandır)
        dynamicWmsBaseLayer = L.tileLayer.wms(wmsEndpointUrl, {
            layers: typeName,
            format: 'image/png',
            transparent: true, // WMS'i diğer altlıkların üzerine şeffaf olarak ekle
            version: '1.1.1',
            crs: L.CRS.EPSG4326,
            attribution: isTkgm ? '© TKGM | WMS Üst Katman' : '© Harici WMS Üst Katman',
            maxNativeZoom: 22,
            maxZoom: 22,
        });

        // Yeni WMS katmanını haritaya Base Layer olarak DEĞİL, Overlay Layer olarak ekle.
        // Base Layer'ı Layer Control yönetiyor.
        dynamicWmsBaseLayer.addTo(map);

        logToConsole('SUCCESS', `Harita üzerine **${typeName}** katmanının WMS görüntüsü (Overlay) eklendi.`);
    }

    // -----------------------------------------------------------
    // 3.0. WMS GETMAP URL OLUŞTURUCU (Her zaman açık olması istenen özellik)
    // -----------------------------------------------------------

    function buildWmsGetMapUrl() {
        const wfsUrl = document.getElementById('wfsUrlSelect').value;
        const typeName = document.getElementById('selectedLayer').value;

        // WFS URL'sini WMS Endpoint'ine çeviriyoruz (genellikle aynı path'tir, sadece path sonu değişebilir)
        // TKGM'de ikisi de 'tkgm.ows/' altında toplanıyor. Sadece 'wfs' yerine 'wms' gelebilir.
        let cleanedUrl = wfsUrl.split('?')[0];
        if (cleanedUrl.includes('/wfs')) {
            cleanedUrl = cleanedUrl.replace('/wfs', '/wms');
        }


        // Eğer katman seçilmemişse veya özel URL girilmemişse uyarı döndür.
        if (!typeName || wfsUrl.includes('custom_url')) return 'WMS isteği için Katman seçimi gerekli veya Özel URL algılanamadı.';


        // Harita BBOX'unu al (kullanıcı çizim yapmasa bile haritanın görünüm alanını kullanmak için)
        let mapBounds;
        let mapSize;
        try {
            mapBounds = map.getBounds();
            mapSize = map.getSize();
        } catch (e) {
            // Harita initialize olmamışsa varsayılan BBOX kullan
            return 'Harita henüz yüklenmedi veya geçersiz BBOX.';
        }

        // Leaflet bounds'u Lng, Lat olarak verir, WMS BBOX Lng, Lat, Lng, Lat ister.
        // GetMap için haritanın mevcut BBOX'u WGS84 (EPSG:4326) formatında hesaplanır.
        const currentMapBbox = `${mapBounds.getSouthWest().lng.toFixed(7)},${mapBounds.getSouthWest().lat.toFixed(7)},${mapBounds.getNorthEast().lng.toFixed(7)},${mapBounds.getNorthEast().lat.toFixed(7)}`;

        let wmsParams = [];
        wmsParams.push('service=WMS');
        wmsParams.push('version=1.1.1');
        wmsParams.push('request=GetMap');
        wmsParams.push(`layers=${typeName}`);
        wmsParams.push('styles='); // Stil boş bırakılabilir
        wmsParams.push(`width=${Math.round(mapSize.x)}`); // Mevcut harita genişliği
        wmsParams.push(`height=${Math.round(mapSize.y)}`); // Mevcut harita yüksekliği
        wmsParams.push('srs=EPSG:4326'); // Koordinat sistemi
        wmsParams.push('format=image/png');
        wmsParams.push('transparent=TRUE');
        wmsParams.push(`bbox=${currentMapBbox}`); // Haritanın mevcut görünüm alanı (4326)

        const queryString = wmsParams.join('&');
        return `${cleanedUrl}?${queryString}`;
    }


    // -----------------------------------------------------------
    // 3. URL VE AUTH URL OLUŞTURUCU
    // -----------------------------------------------------------

    function buildRequestUrl(formatOverride) {
        const wfsUrlSelect = document.getElementById('wfsUrlSelect');
        const baseUrl = wfsUrlSelect.value;
        const operation = document.getElementById('wfsOperationSelect').value;
        const typeName = document.getElementById('selectedLayer').value;
        const maxFeatures = document.getElementById('maxFeatures').value;

        // Versiyon seçimi
        let version = (operation === 'DescribeFeatureType') ? '1.0.0' : currentWfsVersion;
        version = version || '1.1.0';

        let format = formatOverride || document.getElementById('downloadFormat').value;

        // Ana URL yapısı
        let params = [];
        params.push('service=WFS');
        params.push(`version=${version}`);
        params.push(`request=${operation}`);

        if (operation === 'DescribeFeatureType' || operation === 'GetFeature') {
            params.push(`typeName=${typeName}`);
        }

        if (operation === 'GetFeature') {
            params.push(`maxFeatures=${maxFeatures}`);
            params.push(`srsName=EPSG:4326`);
            params.push(`outputFormat=${encodeURIComponent(format)}`);

            const cqlInput = document.getElementById('cqlInput').value;
            const spatialMode = document.querySelector('input[name="spatialMode"]:checked').value;
            let cqlFilters = [];

            // 1. Kullanıcıdan gelen öznitelik filtresini ekle
            if (cqlInput.trim() !== "") {
                cqlFilters.push(`(${cqlInput})`);
            }

            // 2. Mekansal filtreyi (INTERSECTS veya BBOX) ekle
            if (currentWkt) {
                if (spatialMode === 'INTERSECTS') {
                    cqlFilters.push(`INTERSECTS(geom, '${currentWkt}')`);
                } else if (spatialMode === 'BBOX' && currentBbox) {
                    params.push(`bbox=${currentBbox},EPSG:4326`);
                }
            }

            // 3. Tüm CQL filtrelerini 'AND' ile birleştir ve URL'ye ekle
            if (cqlFilters.length > 0) {
                params.push(`cql_filter=${encodeURIComponent(cqlFilters.join(" AND "))}`);
            }
        } else {
            if (operation !== 'GetCapabilities') {
                params.push(`outputFormat=${encodeURIComponent(format)}`);
            }
        }

        const queryString = params.join('&');
        const finalUrl = `${baseUrl}?${queryString}`;

        return finalUrl;
    }


    function updateUrlPreview() {
        // 1. WFS Request URL'yi oluştur
        const downloadFormat = document.getElementById('downloadFormat').value;
        const previewUrl = buildRequestUrl(downloadFormat);

        // 2. WMS GetMap URL'yi oluştur (Yeni Kısım)
        const wmsMapUrl = buildWmsGetMapUrl();

        // Direct WFS URL göster
        document.getElementById('urlDisplay').textContent = decodeURIComponent(previewUrl);
        document.getElementById('downloadUrlDisplay').textContent = decodeURIComponent(previewUrl);

        // WMS GetMap URL göster (Yeni Kısım)
        document.getElementById('wmsUrlDisplay').textContent = decodeURIComponent(wmsMapUrl);

        document.getElementById('iframeFormatBadge').innerText = getIframeFormatName(downloadFormat);

        if (document.getElementById('download-iframe-tab').classList.contains('active')) {
            loadIframeContent();
        }

        hljs.highlightAll();
    }

