    // --- WKT Yardımcı Fonksiyonları ---
    // (Mevcut WKT/GeoJSON fonksiyonları buraya dahildir)

    function latLngToWKT(latlng) {
        return `${latlng.lng.toFixed(6)} ${latlng.lat.toFixed(6)}`;
    }

    function geoJsonToWkt(geojson) {
        if (!geojson || !geojson.geometry) return "GEOMETRYCOLLECTION EMPTY";

        const type = geojson.geometry.type.toUpperCase();
        const coords = geojson.geometry.coordinates;
        const formatCoordinate = (c) => `${c[0].toFixed(6)} ${c[1].toFixed(6)}`;

        switch (type) {
            case 'POINT':
                return `POINT (${formatCoordinate(coords)})`;
            case 'LINESTRING':
                return `LINESTRING (${coords.map(formatCoordinate).join(', ')})`;
            case 'POLYGON':
                const rings = coords.map(ring => {
                    return `(${ring.map(formatCoordinate).join(', ')})`;
                });
                return `POLYGON ${rings.join(', ')}`;
            case 'RECTANGLE':
            case 'CIRCLE':
                const bounds = L.polygon(L.GeoJSON.coordsToLatLngs(coords, 1)).getBounds();
                const sw = bounds.getSouthWest();
                const ne = bounds.getNorthEast();
                return `POLYGON ((${latLngToWKT(sw)}, ${latLngToWKT(L.latLng(sw.lat, ne.lng))}, ${latLngToWKT(ne)}, ${latLngToWKT(L.latLng(ne.lat, sw.lng))}, ${latLngToWKT(sw)}))`;
            default:
                return `${type} (Geometri ayrıştırılamadı)`;
        }
    }

    function parseWKT(wkt) {
        const wktUpper = wkt.trim().toUpperCase();
        const match = wktUpper.match(/^(POINT|LINESTRING|POLYGON)\s*\((.*)\)/i);
        if (!match) return null;

        const type = match[1];
        const coordStr = match[2];

        const parseCoords = (str) => {
            return str.trim().split(',').map(c => {
                const parts = c.trim().split(/\s+/).map(Number);
                return [parts[0], parts[1]];
            });
        };

        try {
            let coordinates;
            switch (type) {
                case 'POINT':
                    coordinates = parseCoords(coordStr)[0];
                    break;
                case 'LINESTRING':
                    coordinates = parseCoords(coordStr);
                    break;
                case 'POLYGON':
                    const rings = coordStr.replace(/[\(\)]/g, "").split('), (').map(ringStr => {
                        return ringStr.split(',').map(c => c.trim().split(/\s+/).map(Number));
                    });
                    coordinates = rings;
                    break;
                default:
                    return null;
            }

            return {
                type: "Feature",
                geometry: {
                    type: type.charAt(0) + type.slice(1).toLowerCase(),
                    coordinates: coordinates
                }
            };
        } catch (e) {
            console.error("WKT Ayrıştırma Hatası:", e);
            return null;
        }
    }


