    // ---------------------------------------------------------
    var lastFeatureInfoUrl = null; // Son oluşturulan GetFeatureInfo URL'ini tutar
    var clickBufferCircle = null; // Tıklama tampon dairesini tutar.
    var highlightedFeature = null; // Vurgulanan parsel katmanını tutar.

    const WMS_LAYERS_MAP = {
        // ... (Mevcut katman listesi) ...
        "https://csb.gov.tr/map/rest/services/Planlama/MapServer/WMSServer": [
