    // ---------------------------------------------------------
    // DescribeLayer Buton Yönetimi (Fetch ve XML Görüntüleme)
    // ---------------------------------------------------------

    function getCleanBaseUrl(url) {
        // URL'in sonundaki / veya ? işaretini kaldırır
        if (url.endsWith('/') || url.endsWith('?')) {
            return url.slice(0, -1);
        }
        return url;
    }

    // YENİ FONKSİYON: Haritanın güncel BBOX'unu EPSG:3857 formatında döndürür.
    function getCurrentMapBBOX() {
        const bounds = map.getBounds();
        const sw = L.CRS.EPSG3857.project(bounds.getSouthWest());
        const ne = L.CRS.EPSG3857.project(bounds.getNorthEast());

        // BBOX formatı: minX,minY,maxX,maxY (EPSG:3857)
        return `${sw.x.toFixed(2)},${sw.y.toFixed(2)},${ne.x.toFixed(2)},${ne.y.toFixed(2)}`;
    }

    // REQUEST tipine göre URL oluşturur (BBOX/I/J içermeyen temiz istekler için)
    function createRequestUrl(requestType) {
        const baseUrl = document.getElementById('wmsUrlInput').value;
        const layerName = document.getElementById('layerName').value;

        if (!baseUrl) return null;

        const cleanUrl = getCleanBaseUrl(baseUrl);
        let url = `${cleanUrl}?SERVICE=WMS&VERSION=1.1.1&REQUEST=${requestType}`;

        if (requestType !== 'GetCapabilities' && requestType !== 'GetMap') {
            if (!layerName) return null;

            if (requestType === 'DescribeLayer' || requestType === 'GetLegendGraphic') {
                // GetLegendGraphic request için LAYER, DescribeLayer için LAYERS kullanılır.
                url += `&LAYER=${layerName}`;
            }
            if (requestType === 'GetFeatureInfo') {
                // GetFeatureInfo template'i, gerçek I/J ve BBOX olmadan sadece yapıyı göstermek için.
                url += `&QUERY_LAYERS=${layerName}&INFO_FORMAT=text/html&I=50&J=50&BBOX=-1000,-1000,1000,1000&WIDTH=100&HEIGHT=100&SRS=EPSG:3857`;
            }
        }
        return url;
    }

    // YENİ EK: İstek sonucunu fetch ile alıp XML olarak biçimlendirip gösterir ve sayfayı kaydırır.
    function fetchAndDisplayResponse() {
        // Sayfayı Oluşan İstek alanına kaydır
        const targetElement = document.getElementById('requestCodeCard');
        if (targetElement) {
            targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        const requestType = document.getElementById('wmsRequestType').value;
        let url = '';

        if (requestType === 'GetMap') {
            // GetMap için özel BBOX'lu URL'yi Request Code alanından alıyoruz
            url = document.getElementById('requestCode').innerText.split('\n')[0].trim();
        } else {
            url = createRequestUrl(requestType);
        }

        const responseCard = document.getElementById('responseCard');
        const responseCodeElement = document.getElementById('responseCode');
        const iframeMessage = document.getElementById('iframeMessage');

        if (!url || url.includes('Henüz bir istek yapılmadı') || url.includes('{minX,minY,maxX,maxY}')) {
            responseCard.style.display = 'none';
            alert('URL oluşturulamadı. Lütfen WMS URL, Katman Adı ve GetMap ise geçerli harita alanını kontrol edin.');
            return;
        }

        // Kartı göster ve yükleniyor mesajını ayarla
        responseCard.style.display = 'block';
        responseCodeElement.innerHTML = '<span style="color:#66d9ef;">// Yükleniyor... Lütfen bekleyiniz.</span>';
        iframeMessage.innerText = `⚙️ Sunucuya ${requestType} isteği gönderiliyor.`;

        fetch(url)
            .then(response => {
                // GetLegendGraphic gibi resim istekleri için özel durum
                const contentType = response.headers.get('content-type');
                if (contentType && contentType.startsWith('image/')) {
                    // Eğer resim geliyorsa, URL'yi doğrudan img etiketi ile gösterelim
                    responseCodeElement.innerHTML = `<img src="${url}" alt="Resim Yanıtı" style="max-width:100%; height:auto;">`;
                    iframeMessage.innerText = `İstek sonucu resim formatında (${contentType}) geldi ve bu alanda doğrudan gösterildi.`;
                    return;
                }
                return response.text();
            })
            .then(text => {
                let formattedText = text;

                // XML formatında gelmesi beklenen GetCapabilities ve DescribeLayer için
                if (requestType === 'GetCapabilities' || requestType === 'DescribeLayer') {
                    try {
                        const parser = new DOMParser();
                        const xmlDoc = parser.parseFromString(text, "text/xml");
                        const xslt = new XMLSerializer();

                        // XML Declaration (<?xml ...?>) kısmını metinden ayır
                        let xmlDeclaration = '';
                        if (text.startsWith('<?xml')) {
                            const declarationEnd = text.indexOf('?>');
                            xmlDeclaration = text.substring(0, declarationEnd + 2) + '\n';
                            // XMLSerializer genellikle declaration'ı ekler, bu yüzden bazen çift görünebilir. 
                            // Ancak, tarayıcılar XML'i düzgün parse edemezse bu önlem faydalıdır.

                            // Sadece kök elementi serialize et ve formatla
                            if (xmlDoc.documentElement) {
                                formattedText = xmlDeclaration + xslt.serializeToString(xmlDoc.documentElement);
                            } else {
                                // XML parse edilemediyse (hatalı XML), ham metni kullan.
                                formattedText = text;
                            }
                        } else {
                            // XML Declaration yoksa sadece serialize et
                            if (xmlDoc.documentElement) {
                                formattedText = xslt.serializeToString(xmlDoc.documentElement);
                            }
                        }

                        // Daha iyi okunabilirlik için basit bir satır içi biçimlendirme (tab/boşluk) ekle (isteğe bağlı ve basit bir yöntem)
                        // Bu basit yerine koymalar, XML'i tam pretty print yapmaz ama okunurluğu artırır.
                        formattedText = formattedText.replace(/></g, '>\n<');

                    } catch (e) {
                        // XML parse edilemezse ham metni kullan
                        console.error("XML Biçimlendirme Hatası:", e);
                        formattedText = text;
                    }
                }

                responseCodeElement.innerText = formattedText;
                iframeMessage.innerText = `✅ Yanıt başarıyla alındı. (${requestType})`;
            })
            .catch(error => {
                responseCodeElement.innerText = `HATA: İstek sırasında bir sorun oluştu veya tarayıcı, CORS (Origin) politikaları nedeniyle yanıtı okuyamadı.\n\nURL'yi kopyalayıp tarayıcınızın yeni bir sekmesinde deneyiniz:\n${url}`;
                iframeMessage.innerText = `❌ Hata: ${error.message}. Tarayıcı Konsolunu kontrol edin.`;
                console.error('Fetch Error:', error);
            });
    }

