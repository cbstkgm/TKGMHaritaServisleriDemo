            "TKGM:ilceler (İlçe İdari Sınırları)",
            "TKGM:iller (İl İdari Sınırları)",
            "TKGM3D:bp_project_2d_v (3B Proje 2D Görünüm)",
            "TKGM3D:bp_project_administrative_area_parsel_v (3B Proje İdari Alan Parsel Görünümü)",
            "TKGM3D:building_photogrametric_footprint_v (Fotogrametrik Bina Taban Alanı)",
            "TKGM3D:building_photogrametric_has_architecturel_v (Fotogrametrik Yapısal Mimari Bilgi)",
            "TKGM:eklentiler (Eklenti Alanları)",
            "TKGM:irtifakhaklari (İrtifak Hakları)",
            "TKGM:kulturvarliklarialan (Kültür Varlıkları Alanları)",
            "TKGM:muhdesatlar (Muhdesat Alanları)",
            "TKGM:ozelalanbirlesimview (Özel Alan Birleşim Görünümü)",
            "TKGM:ozelguvenlikbolgeleri (Özel Güvenlik Bölgeleri)",
            "TKGM:pafta (Pafta Sınırları)",
            "TKGM:parseller_adalar (Parsel ve Ada Sınırları)",
            "TKGM:pasif_parseller (Pasif Parsel Kayıtları)",
            "TKGM:planyuzbin_hazineparsel_view (1/100K Hazine Parsel Görünümü)",
            "TKGM:planyuzbinview (1/100K Plan Görünümü)",
            "TKGM:tescilharicialanlar (Tescil Harici Alanlar)",
            "TKGM:yerkontrolnoktalari (Yer Kontrol Noktaları)"
        ],
        "https://tiles.maps.eox.at/wms": [
            "Sentinel-2cloudless (Bulutsuz Sentinel-2 Görüntüleri)",
            "overlay (Şeffaf Yüzey Katmanı)",
            "terrain-light (Hafif Topoğrafya)"
        ],
        "https://wms.geo.admin.ch/": [
            "ch.swisstopo.swissimage (Ortophoto)",
            "ch.swisstopo.pixelkarte-farbe (Ulusal Harita Renkli)",
            "ch.swisstopo.zeitreihen (Zaman Serisi)",
            "ch.bafu.ren_suedhang (Güneye Bakan Yüzeyler)"
        ],
        "https://creodias.sentinel-hub.com/ogc/wms/ceb32402-23c2-49af-b076-291771141151": [
            "SENTINEL2_L1C (Yüksek Çözünürlüklü Görüntü)",
            "SENTINEL2_L2A (Yüzey Yansıtma)"
        ],
        "https://discomap.eea.europa.eu/arcgis/services/AAS_A2_UrbanAtlas_2018/MapServer/WMSServer": [
            "UA2018_CLC2018_20m_v020 (Kentsel Alanlar)",
            "CLC2018_v2018_20m (Arazi Örtüsü)"
        ],
        "https://sedac.ciesin.columbia.edu/geoserver/wms": [
            "gpw-v3:gpw-v3-population-density-future-estimates_2015",
            "gpw-v3:gpw-v3-population-count-future-estimates_2015"
        ],
        "https://mesonet.agron.iastate.edu/cgi-bin/wms/nexrad/n0r.cgi": [
            "nexrad-n0r-900913 (Hava Radarı)",
            "nexrad-n0r-900913-topo (Topoğrafyalı Hava Radarı)"
        ],
        "https://ahocevar.com/geoserver/wms": [
            "topp:states (ABD Eyaletleri)",
            "topp:capitals (ABD Başkentleri)"
        ],
        "https://basemap.nationalmap.gov/arcgis/services/USGSTopo/MapServer/WMSServer": [
            "USGSTopo (Topoğrafya)",
            "USGSHydroCached (Su Kaynakları)"
        ],
        "https://worldpop.arcgis.com/arcgis/services/WorldPop_Population_Density/MapServer/WMSServer": [
            "WorldPop_Population_Density (Yoğunluk)",
            "WorldPop_Population_Count (Sayım)"
        ],
        "https://wms.met.no/wms": [
            "radarmet_europe_weather_radar_composite (Avrupa Hava Radarı)",
            "sea_surface_temperature (Deniz Yüzey Sıcaklığı)"
        ]
    };

    const INITIAL_COORDS = {
        'TR': [39.93, 32.85], // Türkiye merkez
        'CH': [46.8182, 8.2275], // İsviçre merkez
        'EU': [50, 10],      // Avrupa merkez
        'US': [40, -95],     // ABD merkez
        'GLOBAL': [30, 0]
    };

    // YENİ SABİTLER: SRS/CRS Seçenekleri
    const WMS_SRS_OPTIONS = {
        'standard': [
            { code: 'EPSG:3857', name: 'EPSG:3857 (Web Mercator)' },
            { code: 'EPSG:4326', name: 'EPSG:4326 (WGS 84 - Coğrafi)' },
            { code: 'CRS:84', name: 'CRS:84 (WGS 84 - Lng/Lat)' }
        ],
        'TR': [
            { code: 'EPSG:5253', name: 'EPSG:5253 (ITRF96/TM30 - Türkiye)' },
            { code: 'EPSG:32636', name: 'EPSG:32636 (UTM Zone 36N - Doğu TR)' },
            { code: 'EPSG:32635', name: 'EPSG:32635 (UTM Zone 35N - Batı TR)' }
        ],
        'CH': [
            { code: 'EPSG:2056', name: 'EPSG:2056 (CH1903+/LV95)' }
        ]
    };

    // Güncellendi: TKGM için GetFeatureInfo isteğinde EPSG:4326 kullanılması beklendiği varsayımıyla varsayılanı 4326 olarak değiştirelim.
    const WMS_DEFAULT_SRS = {
        "https://cbsservis.tkgm.gov.tr/tkgm.ows/wms": 'EPSG:4326', // Değişiklik burada yapıldı
        "https://csb.gov.tr/map/rest/services/Planlama/MapServer/WMSServer": 'EPSG:5253',
        "https://wms.geo.admin.ch/": 'EPSG:2056',
    };


    function listLayersForSelectedWMS(wmsUrl) {
        // ... (Layer listesi mevcut kod) ...
        const layerListElement = document.getElementById('availableLayersList');
        layerListElement.innerHTML = '';
        const layers = WMS_LAYERS_MAP[wmsUrl];

        if (layers && layers.length > 0) {
            layers.forEach(layer => {
                const parts = layer.split(' ');
                const layerName = parts[0];
                const description = parts.slice(1).join(' ');

                const listItem = document.createElement('li');
                listItem.className = 'list-group-item list-group-item-action py-2 px-3 small';
                listItem.style.cursor = 'pointer';

                listItem.onclick = function() {
                    document.getElementById('layerName').value = layerName;
                    document.querySelectorAll('#availableLayersList .list-group-item').forEach(item => item.classList.remove('active'));
                    listItem.classList.add('active');
                    processWMSRequest();
                    updateRequestResultArea();
                };

                listItem.innerHTML = `<span class="fw-bold text-primary">${layerName}</span> <br><span class="text-muted" style="font-size: 0.75rem;">${description}</span>`;
                layerListElement.appendChild(listItem);
            });
        } else {
            layerListElement.innerHTML = '<li class="list-group-item text-muted small">Bu WMS için statik katman bilgisi bulunmamaktadır. Lütfen Layer Adı alanına manuel giriniz.</li>';
        }
    }


    // ---------------------------------------------------------
    // Harita Başlatma ve Servis Güncelleme
    // ---------------------------------------------------------
    var map = L.map('map').setView(INITIAL_COORDS.TR, 6);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    var genericWmsLayer = null;

    // SRS Seçeneklerini günceller
    function updateSrsOptions(wmsUrl) {
        const srsSelect = document.getElementById('srsCode');
        srsSelect.innerHTML = '';

        const defaultSrsCode = WMS_DEFAULT_SRS[wmsUrl] || 'EPSG:3857';
        let specificOptions = WMS_SRS_OPTIONS.standard;

        if (wmsUrl.includes('tkgm') || wmsUrl.includes('csb.gov.tr')) {
            specificOptions = WMS_SRS_OPTIONS.standard.concat(WMS_SRS_OPTIONS.TR);
        } else if (wmsUrl.includes('wms.geo.admin.ch')) {
            specificOptions = WMS_SRS_OPTIONS.standard.concat(WMS_SRS_OPTIONS.CH);
        }

        specificOptions.forEach(srs => {
            const option = document.createElement('option');
            option.value = srs.code;
            option.textContent = srs.name;
            if (srs.code === defaultSrsCode) {
                option.selected = true;
            }
            srsSelect.appendChild(option);
        });
    }

    document.getElementById('wmsUrlSelect').addEventListener('change', function() {
        var selectedVal = this.value;
        var customInput = document.getElementById('wmsUrlCustomInput');
        var urlInfoSpan = document.getElementById('wmsUrlInfo');
        var layerInput = document.getElementById('layerName');

        let urlToUse = selectedVal; // Varsayılan: Seçilen değer

        let defaultLayer = '';
        let view = INITIAL_COORDS.TR;
        let zoom = 6;

        if (selectedVal === 'custom') {
            urlInfoSpan.style.display = 'none';
            customInput.style.display = 'block';
            urlToUse = customInput.value; // Başlangıçta boş olabilir
            layerInput.value = '';
            customInput.focus();

        } else {
            urlInfoSpan.style.display = 'block';
            customInput.style.display = 'none';
            urlInfoSpan.textContent = selectedVal;

            if (selectedVal.includes('tkgm.ows')) {
                defaultLayer = 'TKGM:parseller';
            } else if (selectedVal.includes('csb.gov.tr')) {
                defaultLayer = 'Planlama:Planlar';
            } else if (selectedVal.includes('wms.geo.admin.ch')) {
                defaultLayer = 'ch.swisstopo.swissimage';
                view = INITIAL_COORDS.CH;
                zoom = 8;
            } else if (selectedVal.includes('tiles.maps.eox.at')) {
                defaultLayer = 'Sentinel-2cloudless';
                view = INITIAL_COORDS.EU;
                zoom = 5;
            } else if (selectedVal.includes('sentinel-hub.com')) {
                defaultLayer = 'SENTINEL2_L1C';
                view = INITIAL_COORDS.EU;
                zoom = 5;
            } else if (selectedVal.includes('eea.europa.eu')) {
                defaultLayer = 'UA2018_CLC2018_20m_v020';
                view = INITIAL_COORDS.EU;
                zoom = 5;
            } else if (selectedVal.includes('sedac') || selectedVal.includes('worldpop.arcgis.com')) {
                defaultLayer = selectedVal.includes('sedac') ? 'gpw-v3:gpw-v3-population-density-future-estimates_2015' : 'WorldPop_Population_Density';
                view = INITIAL_COORDS.GLOBAL;
                zoom = 3;
            } else if (selectedVal.includes('mesonet') || selectedVal.includes('ahocevar') || selectedVal.includes('basemap.nationalmap.gov')) {
                defaultLayer = selectedVal.includes('mesonet') ? 'nexrad-n0r-900913' : (selectedVal.includes('ahocevar') ? 'topp:states' : 'USGSTopo');
                view = INITIAL_COORDS.US;
                zoom = 4;
            } else if (selectedVal.includes('wms.met.no')) {
                defaultLayer = 'radarmet_europe_weather_radar_composite';
                view = [60, 10];
                zoom = 4;
            }

            layerInput.value = defaultLayer;
            map.setView(view, zoom);
        }

        listLayersForSelectedWMS(urlToUse);
        updateSrsOptions(urlToUse);
        // processWMSRequest() ve updateRequestResultArea() updateSrsOptions içinde çağrılıyor.
    });

    // Custom URL alanına yazıldığında WMS işlemlerini güncelle
    document.getElementById('wmsUrlCustomInput').addEventListener('input', function() {
        processWMSRequest();
        updateRequestResultArea();
    });


    // ---------------------------------------------------------
    // GENEL YARDIMCI FONKSİYONLAR
    // ---------------------------------------------------------

    // YENİ/GÜNCELLENMİŞ: Kullanılacak WMS URL'ini döndürür
    function getWMSUrl() {
        const select = document.getElementById('wmsUrlSelect');
        if (select.value === 'custom') {
            return document.getElementById('wmsUrlCustomInput').value.trim();
        }
        return select.value;
    }


    function getCleanBaseUrl(url) {
        if (url.endsWith('/') || url.endsWith('?')) {
            return url.slice(0, -1);
        }
        return url;
    }

    function getCurrentMapBBOX() {
        const bounds = map.getBounds();
        const sw = L.CRS.EPSG3857.project(bounds.getSouthWest());
        const ne = L.CRS.EPSG3857.project(bounds.getNorthEast());

        return `${sw.x.toFixed(2)},${sw.y.toFixed(2)},${ne.x.toFixed(2)},${ne.y.toFixed(2)}`;
    }

    // REQUEST tipine göre URL oluşturur (BBOX/I/J içermeyen temiz istekler için)
    function createRequestUrl(requestType) {
        const baseUrl = getWMSUrl(); // GÜNCELLENDİ
        const layerName = document.getElementById('layerName').value;
        // const srsCode = document.getElementById('srsCode').value; // GetFeatureInfo için özel olarak 4326 kullanacağız

        if (!baseUrl) return null;

        const cleanUrl = getCleanBaseUrl(baseUrl);
        let url = `${cleanUrl}?SERVICE=WMS&VERSION=1.1.1&REQUEST=${requestType}`;

        if (requestType !== 'GetCapabilities' && requestType !== 'GetMap') {
            if (!layerName) return null;

            if (requestType === 'DescribeLayer' || requestType === 'GetLegendGraphic') {
                url += `&LAYER=${layerName}`;
            }
            if (requestType === 'GetFeatureInfo') {
                // Şablon: İstenen formata uygun parametreler
                url += `&SRS=EPSG:4326&LAYERS=${layerName}&STYLES=&FORMAT=image/png&QUERY_LAYERS=${layerName}&INFO_FORMAT=text/html&FEATURE_COUNT=10&WIDTH={width}&HEIGHT={height}&BBOX={lngMin},{latMin},{lngMax},{latMax}&X={pixelX}&Y={pixelY}`;
            }
        }
        return url;
    }

    // GÜNCELLENDİ: GetFeatureInfo URL'ini istenen EPSG:4326 BBOX ve X/Y değerleriyle oluşturur
    function createFeatureInfoRequestUrl(bounds, width, height, i, j) {
        const baseUrl = getWMSUrl(); // GÜNCELLENDİ
        const layerName = document.getElementById('layerName').value;
        const cleanUrl = getCleanBaseUrl(baseUrl);

        // Sabitlenen parametreler
        const srsCode = 'EPSG:4326';
        const featureCount = 10;
        const format = 'image/png';
        const infoFormat = 'text/html';

        // EPSG:4326 BBOX'u hesapla (minX, minY, maxX, maxY sırası: Lng, Lat, Lng, Lat)
        const sw4326 = bounds.getSouthWest();
        const ne4326 = bounds.getNorthEast();

        const bbox4326 = `${sw4326.lng.toFixed(8)},${sw4326.lat.toFixed(8)},${ne4326.lng.toFixed(8)},${ne4326.lat.toFixed(8)}`;

        let url = `${cleanUrl}?SERVICE=WMS&VERSION=1.1.1&REQUEST=GetFeatureInfo`;

        // İstenen sıradaki parametreler ekleniyor
        url += `&SRS=${srsCode}`;
        url += `&LAYERS=${layerName}`;
        url += `&STYLES=`;
        url += `&FORMAT=${format}`;
        url += `&QUERY_LAYERS=${layerName}`;
        url += `&INFO_FORMAT=${infoFormat}`;
        url += `&FEATURE_COUNT=${featureCount}`;
        url += `&WIDTH=${Math.round(width)}`;
        url += `&HEIGHT=${Math.round(height)}`;
        url += `&BBOX=${bbox4326}`;
        url += `&X=${Math.round(i)}`; // Piksel X koordinatı
        url += `&Y=${Math.round(j)}`; // Piksel Y koordinatı

        return url;
    }


    /**
     * YENİ: Vurgulanan özelliği WMS GetMap + CQL_FILTER ile haritaya ekler.
     * @@param {string} featureID - Parselin benzersiz ID'si (örneğin TKGM'de 'objectid' değeri)
     * @@param {string} layerName - Sorgulanan katman adı (örn: TKGM:parseller)
     */
    function highlightFeatureByFilter(featureID, layerName) {
        // Önceki vurgulamayı kaldır
        if (highlightedFeature) {
            map.removeLayer(highlightedFeature);
            highlightedFeature = null;
        }

        if (!featureID) {
            return;
        }

        const baseUrl = getWMSUrl();
        const cleanUrl = getCleanBaseUrl(baseUrl);

        // Geoserver/ArcGIS sunucularında filtreleme için CQL_FILTER veya FILTER kullanılır.
        // TKGM'de genellikle 'objectid' alanı benzersiz ID'yi tutar.
        const cqlFilter = `objectid='${featureID}'`;

        // Vurgulama stili için SLD_BODY/SLD_URL yerine, TKGM bu tür özel stil parametrelerini desteklemiyorsa
        // basit bir filtreli WMS katmanı oluşturmak en iyisidir.
        // Veya Geoserver'a özel `format_options` kullanarak stil göndermeyi deneyebiliriz (genellikle desteklenmez).

        // Basitçe filtreyi uygulayan WMS katmanı oluşturalım.
        highlightedFeature = L.tileLayer.wms(cleanUrl, {
            layers: layerName,
            format: 'image/png',
            transparent: true,
            version: '1.1.1',
            crs: L.CRS.EPSG3857,
            cql_filter: cqlFilter, // CQL_FILTER parametresiyle parseli filtrele
            // Stil ekle: Bu sunucunun varsayılan stilini kullanacak, ancak sadece filtrelenen özellikler görünecek.
            // Sunucuda özel bir "vurgulama stili" (SLD) tanımlıysa onu STYLES parametresinde kullanmak gerekir.
            // Bu demoda sadece filtreleme ile gösterim yapıyoruz.
            styles: 'red_border_fill', // <--- BU SATIRI SUNUCUNUZDA TANIMLI ÖZEL BİR VURGULAMA STİLİ VARSA KULLANIN!
            // TKGM'de bu stilin adı muhtemelen farklıdır veya hiç yoktur. Eğer çalışmazsa, STYLES satırını kaldırın.
            attribution: 'TKGM Highlight'
        });

        // Eğer GetMap işlemi başarılı olursa highlightFeature'ı haritaya ekle.
        highlightedFeature.on('tileerror', function(e) {
             console.error("Vurgulama katmanı yüklenirken hata oluştu. Filtre (CQL_FILTER) veya stil (STYLES) desteklenmiyor olabilir.", e);
             // Hata durumunda sadece ID'yi göstermeye devam et
             if (highlightedFeature) {
                 map.removeLayer(highlightedFeature);
                 highlightedFeature = null;
             }
         });


        highlightedFeature.addTo(map);

        console.log(`Highlighted Feature ID: ${featureID}. CQL Filter URL: ${cleanUrl}?SERVICE=WMS&VERSION=1.1.1&REQUEST=GetMap&LAYERS=${layerName}&CQL_FILTER=${cqlFilter}&...`);
    }

    // YENİ FONKSİYON: GetFeatureInfo isteğini çek ve göster
    function fetchAndDisplayFeatureInfo(url) {
        const responseCard = document.getElementById('responseCard');
        const responseCodeElement = document.getElementById('responseCode');
        const iframeMessage = document.getElementById('iframeMessage');
        const layerName = document.getElementById('layerName').value;

        // Önceki vurgulamayı kaldır
        if (highlightedFeature) {
            map.removeLayer(highlightedFeature);
            highlightedFeature = null;
        }
        // Tıklama halkasını kaldır
        if (clickBufferCircle) {
             map.removeLayer(clickBufferCircle);
             clickBufferCircle = null;
         }

        if (!url) {
            alert("GetFeatureInfo isteği oluşturulamadı. Haritada bir yere tıkladığınızdan ve bir katman seçili olduğundan emin olun.");
            return;
        }

        responseCard.style.display = 'block';
        responseCodeElement.innerHTML = '<span style="color:#66d9ef;">// Özellik Bilgisi Yükleniyor... Lütfen bekleyiniz.</span>';
        iframeMessage.innerText = `⚙️ Sunucuya GetFeatureInfo isteği gönderiliyor.`;
        document.getElementById('responseFormat').innerText = 'HTML/JSON/XML';

        document.getElementById('responseCard').scrollIntoView({ behavior: 'smooth', block: 'start' });

        fetch(url)
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP Hata kodu: ${response.status}`);
                }
                return response.text();
            })
            .then(text => {
                responseCodeElement.innerText = text;
                iframeMessage.innerText = `✅ Özellik Bilgisi başarıyla alındı. (GetFeatureInfo)`;

                // ----------------------------------------------------
                // PARSEL ID'SİNİ ÇEKME VE VURGULAMA MANTIĞI (YENİ)
                // ----------------------------------------------------
                let featureID = null;

                try {
                    // HTML yanıtını ayrıştır (TKGM WMS GetFeatureInfo genellikle HTML döner)
                    const parser = new DOMParser();
                    const htmlDoc = parser.parseFromString(text, "text/html");

                    // TKGM'de 'objectid' veya 'parselno' değerini içeren bir tablo hücresini bulmaya çalış
                    // Bu kısıtlı bir yaklaşımdır ve sunucunun yanıt formatına göre ayarlanmalıdır.
                    const tds = htmlDoc.querySelectorAll('td');

                    tds.forEach((td, index) => {
                         // Genellikle tablo, Label | Value formatındadır
                         if (td.innerText.includes('objectid') || td.innerText.includes('id')) { // ID/Label sütunu
                              const valueTd = tds[index + 1]; // Sonraki sütun değeri
                              if (valueTd) {
                                  featureID = valueTd.innerText.trim();
                                  console.log("Bulunan ID:", featureID);
                                  // İlk ID'yi bulduğumuzda dur
                                  return;
                              }
                         }
                    });

                } catch (e) {
                    console.error("HTML ayrıştırma hatası:", e);
                }

                if (featureID) {
                    // Bulunan ID ile parseli haritada vurgula
                    highlightFeatureByFilter(featureID, layerName);
                    iframeMessage.innerText += `\n🎯 Parsel Vurgulandı (ID: ${featureID}).`;
                } else {
                    iframeMessage.innerText += `\n⚠️ Özellik ID'si bulunamadı (objectid/id). Vurgulama yapılamadı.`;
                }


            })
            .catch(error => {
                responseCodeElement.innerText = `HATA: Özellik bilgisi alınamadı. Hata: ${error.message}\n\nURL'yi kopyalayıp tarayıcınızda deneyin:\n${url}`;
                iframeMessage.innerText = `❌ Hata: ${error.message}. Konsolu kontrol edin.`;
                console.error('Fetch Error:', error);
            });
    }


    function fetchAndDisplayResponse() {
        // ... (Kalan fonksiyonlar aynı bırakıldı, sadece fetchAndDisplayFeatureInfo güncellendi) ...
        const targetElement = document.getElementById('requestCodeCard');
        if (targetElement) {
            targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        const requestType = document.getElementById('wmsRequestType').value;
        let url = '';

        if (requestType === 'GetMap') {
            url = document.getElementById('requestCode').innerText.split('\n')[0].trim();
        } else {
            url = createRequestUrl(requestType);
        }

        const responseCard = document.getElementById('responseCard');
        const responseCodeElement = document.getElementById('responseCode');
        const iframeMessage = document.getElementById('iframeMessage');

        if (!url || url.includes('Henüz bir istek yapılmadı') || url.includes('{minX,minY,maxX,maxY}')) {
            responseCard.style.display = 'none';
            alert('URL oluşturulamadı. Lütfen WMS URL, Katman Adı ve GetMap ise geçerli harita alanını kontrol edin.');
            return;
        }

        responseCard.style.display = 'block';
        responseCodeElement.innerHTML = '<span style="color:#66d9ef;">// Yükleniyor... Lütfen bekleyiniz.</span>';
        iframeMessage.innerText = `⚙️ Sunucuya ${requestType} isteği gönderiliyor.`;

        fetch(url)
            .then(response => {
                const contentType = response.headers.get('content-type');
                if (contentType && contentType.startsWith('image/')) {
                    responseCodeElement.innerHTML = `<img src="${url}" alt="Resim Yanıtı" style="max-width:100%; height:auto;">`;
                    iframeMessage.innerText = `İstek sonucu resim formatında (${contentType}) geldi ve bu alanda doğrudan gösterildi.`;
                    return;
                }
                return response.text();
            })
            .then(text => {
                let formattedText = text;

                if (requestType === 'GetCapabilities' || requestType === 'DescribeLayer') {
                    try {
                        const parser = new DOMParser();
                        const xmlDoc = parser.parseFromString(text, "text/xml");
                        const xslt = new XMLSerializer();

                        let xmlDeclaration = '';
                        if (text.startsWith('<?xml')) {
                            const declarationEnd = text.indexOf('?>');
                            xmlDeclaration = text.substring(0, declarationEnd + 2) + '\n';
                            if (xmlDoc.documentElement) {
                                formattedText = xmlDeclaration + xslt.serializeToString(xmlDoc.documentElement);
                            } else {
                                formattedText = text;
                            }
                        } else {
                            if (xmlDoc.documentElement) {
                                formattedText = xslt.serializeToString(xmlDoc.documentElement);
                            }
                        }
                        formattedText = formattedText.replace(/></g, '>\n<');

                    } catch (e) {
                        console.error("XML Biçimlendirme Hatası:", e);
                        formattedText = text;
                    }
                }

                responseCodeElement.innerText = formattedText;
                iframeMessage.innerText = `✅ Yanıt başarıyla alındı. (${requestType})`;
            })
            .catch(error => {
                responseCodeElement.innerText = `HATA: İstek sırasında bir sorun oluştu veya tarayıcı, CORS (Origin) politikaları nedeniyle yanıtı okuyamadı.\n\nURL'yi kopyalayıp tarayıcınızda deneyin:\n${url}`;
                iframeMessage.innerText = `❌ Hata: ${error.message}. Tarayıcı Konsolunu kontrol edin.`;
                console.error('Fetch Error:', error);
            });
    }

