            view = INITIAL_COORDS.TR;
            zoom = 6;
        } else {
            input.readOnly = true;
            input.value = selectedVal;

            if (selectedVal.includes('tkgm.ows')) {
                defaultLayer = 'TKGM:parseller';
            } else if (selectedVal.includes('csb.gov.tr')) {
                defaultLayer = 'Planlama:Planlar';
            } else if (selectedVal.includes('wms.geo.admin.ch')) { // YENİ KONTROL
                defaultLayer = 'ch.swisstopo.swissimage';
                view = INITIAL_COORDS.CH;
                zoom = 8;
            } else if (selectedVal.includes('tiles.maps.eox.at')) {
                defaultLayer = 'Sentinel-2cloudless';
                view = INITIAL_COORDS.EU;
                zoom = 5;
            } else if (selectedVal.includes('sentinel-hub.com')) {
                defaultLayer = 'SENTINEL2_L1C';
                view = INITIAL_COORDS.EU;
            } else if (selectedVal.includes('eea.europa.eu')) {
                defaultLayer = 'UA2018_CLC2018_20m_v020';
                view = INITIAL_COORDS.EU;
                zoom = 5;
            } else if (selectedVal.includes('sedac') || selectedVal.includes('worldpop.arcgis.com')) {
                defaultLayer = selectedVal.includes('sedac') ? 'gpw-v3:gpw-v3-population-density-future-estimates_2015' : 'WorldPop_Population_Density';
