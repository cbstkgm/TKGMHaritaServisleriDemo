@{
Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OGC WMS Eğitim ve Demo Portalı - TKGM</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.css" />

    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f4f7f6; color: #333; }
        /* container-fluid kullanıldığı için varsayılan margin/padding ayarları */
        .navbar { background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); }
        .map-container { height: 600px; width: 100%; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); border: 2px solid #e0e0e0; z-index: 1; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 15px rgba(0,0,0,0.05); margin-bottom: 20px; }
        .card-header { background-color: #fff; border-bottom: 1px solid #eee; font-weight: 600; color: #1e3c72; }
        /* Kod bloğu stilini, BBOX çıktısını daha iyi göstermek için güncelledim */
        .code-block { background-color: #2d2d2d; color: #f8f8f2; padding: 15px; border-radius: 8px; font-family: 'Consolas', monospace; font-size: 0.9rem; overflow-x: auto; white-space: pre-wrap; word-break: break-all; }
        .param-badge { background-color: #e3f2fd; color: #0d47a1; padding: 4px 8px; border-radius: 4px; font-family: monospace; font-weight: bold; }

        /* --- Toggle Switch CSS (TKGM Butonu İçin) --- */
        .basemap-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-top: 1px solid #eee; }
        .basemap-label { font-weight: 500; color: #555; }
        .switch { position: relative; display: inline-block; width: 50px; height: 24px; margin-bottom: 0; }
        .switch input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #ccc; transition: .4s; border-radius: 24px; }
        .slider:before { position: absolute; content: ""; height: 16px; width: 16px; left: 4px; bottom: 4px; background-color: white; transition: .4s; border-radius: 50%; }
        input:checked + .slider { background-color: #1e3c72; }
        input:checked + .slider:before { transform: translateX(26px); }

        /* --- Yeni Kontrol Stili (Koordinat ve Zoom) --- */
        .leaflet-control-coordinates {
            background: rgba(30, 60, 114, 0.9); /* #1e3c72 koyu mavi */
            color: white;
            padding: 5px 10px;
            font-size: 0.8rem;
            font-weight: 600;
            border-radius: 8px;
            text-shadow: 0 1px 1px rgba(0,0,0,0.5);
        }
        /* Yeni Katman Listesi Stili */
        #availableLayersList .list-group-item:hover {
            background-color: #f0f4f7;
        }
        #availableLayersList .list-group-item.active {
            background-color: #d1e7dd; /* Light green/success color */
            border-left: 4px solid #0f5132;
        }
        /* Yeni eklendi: Tıklama uyarısı */
        .click-info {
            font-size: 0.8rem;
            color: #1e3c72;
            font-weight: 500;
            padding-top: 5px;
        }
        /* XML/Metin Çıktı Stili */
        #responseCode {
            width: 100%;
            height: 400px;
            border: none;
            background-color: #2d2d2d;
            border-radius: 8px;
            font-size: 0.8rem; /* Daha okunaklı XML için font küçültüldü */
        }

        /* Kopyalama butonu için stil (Yanıt Kopyalama) */
        #copyResponseBtn {
            background-color: #0d6efd; /* Bootstrap primary color */
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 0.75rem;
            transition: background-color 0.2s;
        }
        #copyResponseBtn:hover {
            background-color: #0b5ed7;
        }

        /* YENİ: İstek URL'i Kopyalama Butonu */
        #copyRequestUrlBtn {
            background-color: #6c757d; /* Darker gray */
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 0.75rem;
            transition: background-color 0.2s;
        }
        #copyRequestUrlBtn:hover {
            background-color: #5a6268;
        }

        /* --- WMS BİLGİ KONTROL STİLLERİ --- */
        .leaflet-control-wms-info {
            box-shadow: 0 1px 5px rgba(0,0,0,0.4);
            background: #fff;
            border-radius: 5px;
            width: 280px;
            font-size: 0.85rem;
            padding: 0;
        }
        /* YENİ HEADER/BUTTON STİLİ */
        .wms-info-toggle-bar {
            background: #1e3c72;
            color: white;
            padding: 5px 10px;
            border-radius: 5px;
            display: flex;
            align-items: center;
            cursor: pointer;
            font-weight: 600;
            box-shadow: 0 1px 5px rgba(0,0,0,0.4);
        }
        .wms-info-icon {
            /* i simgesini temsil eden yuvarlak stil */
            border: 2px solid white;
            border-radius: 50%;
            width: 22px;
            height: 22px;
            line-height: 18px;
            text-align: center;
            font-size: 1rem;
            font-weight: bold;
            margin-right: 8px;
            flex-shrink: 0;
        }
        .wms-info-content {
            display: none; /* Varsayılan olarak gizli */
            padding: 10px;
            border-top: 1px solid #eee;
        }
        .wms-info-content.active {
            display: block;
        }

        /* Leaflet.draw ikonlarını koyu temaya uygun hale getirmek (opsiyonel) */
        .leaflet-draw-toolbar a {
            background-image: url('https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/images/spritesheet.png');
        }
        /* WKT Butonu ve BBOX Butonu Stilleri */
        /* WKT butonu için özel arka plan ve yazı rengi */
        .leaflet-control-wkt-button a, 
        .leaflet-control-bbox-button a {
             background-image: none !important; 
             background-color: #1e3c72 !important; /* Koyu Mavi */
             color: white !important;
             font-weight: bold;
             padding: 0 5px;
             line-height: 30px;
             text-decoration: none;
             font-size: 0.9rem;
        }
        .leaflet-control-wkt-button a:hover,
        .leaflet-control-bbox-button a:hover {
             background-color: #2a5298 !important; /* Daha açık mavi */
        }
        /* Bu iki butonu Draw kontrolünün yanına düzgünce yerleştirmek için */
        .leaflet-top.leaflet-right .leaflet-control:nth-child(2) {
            margin-right: 5px; /* Draw kontrolü ile WKT arasında boşluk */
        }
        .leaflet-control-wkt-button {
            margin-right: 5px; /* WKT ile BBOX arasında boşluk */
        }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark mb-4">
    <div class="container-fluid"> <a class="navbar-brand" href="#">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-globe-americas me-2" viewBox="0 0 16 16">
                <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0ZM2.04 4.326c.325 1.329 2.532 2.54 3.717 3.19.48.263.793.434.743.484-.08.08-.662.08-.82.079-.318-.002-.759.042-.998.237a1.12 1.12 0 0 0-.296.687l-.04.49c-.115 1.15.376 1.947 1.112 2.455.358.248.825.423 1.216.461.405.04.743-.037.774-.048a.45.45 0 0 0 .15-.083c.143-.11.123-.33.08-.573a2.22 2.22 0 0 0-.114-.452l-.114-.323c-.335-.95-.404-1.656-.166-2.477.026-.09.12-.226.256-.214.088.008.19.09.247.227.35.835 1.026 1.81 2.053 2.625.45.355 1.24.717 1.737.893.197.07.398.127.6.164a8 8 0 1 1-10.4-5.44Z"/>
            </svg>
            OGC WMS Eğitim ve Demo Portalı - TKGM
        </a>
    </div>
</nav>

<div class="container-fluid"> <div class="row">

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>🗺️ Canlı Önizleme</span>
                    <span class="badge bg-success">Map Ready</span>
                </div>
                <div class="card-body p-0">
                    <div id="map" class="map-container"></div>
                </div>
                <div class="card-footer text-muted small">
                    Harita altlığı: OpenStreetMap | Overlay: Leaflet WMS
                    <p class="click-info mb-0">💡 İPUCU: Haritaya tıkladığınızda **BBOX** parametresi otomatik olarak güncellenecektir. **Çizim araçları** sağ üstte mevcuttur.</p>
                </div>
            </div>

            <div class="card mt-4" id="requestCodeCard">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>💻 Oluşan İstek (Request URL)</span>
                    <button id="copyRequestUrlBtn" onclick="copyRequestUrlText()" title="İstek URL'ini Panoya Kopyala">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-clipboard me-1" viewBox="0 0 16 16">
                            <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/>
                            <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 3h3A1.5 1.5 0 0 0 11 1.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/>
                        </svg>
                        Kopyala
                    </button>
                </div>
                <div class="card-body bg-dark p-0">
                    <div class="code-block" id="requestCode">
                        Henüz bir istek yapılmadı...
                    </div>
                </div>
            </div>

            <div class="card mt-4" id="responseCard" style="display:none;">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>📄 İstek Yanıtı</span>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-info me-2" id="responseFormat">XML/Metin</span>
                        <button id="copyResponseBtn" onclick="copyResponseText()" title="Yanıtı Panoya Kopyala">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-clipboard me-1" viewBox="0 0 16 16">
                                <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/>
                                <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 3h3A1.5 1.5 0 0 0 11 1.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/>
                            </svg>
                            Kopyala
                        </button>
                    </div>
                </div>
                <div class="card-body bg-dark p-0">
                    <pre class="code-block" id="responseCode" style="height: 400px; overflow-y: scroll;"></pre>
                </div>
                <div class="card-footer text-muted small" id="iframeMessage">
                    İstek sonucu sunucudan çekildi ve biçimlendirilmiş metin olarak gösterildi. (CORS kısıtlamaları bazı sunucularda metin okumayı engelleyebilir.)
                </div>
            </div>
        </div>


        <div class="col-lg-4">

            <div class="card bg-light">
                <div class="card-header">
                    ⚙️ Genel WMS Servis Ayarları
                </div>
                <div class="card-body">
                    <form id="wmsForm">
                        <div class="mb-3">
                            <label for="wmsUrl" class="form-label fw-bold">WMS URL</label>
                            <select class="form-select" id="wmsUrlSelect">
                                <option value="custom">Özel URL Gir...</option>

                                <option value="https://cbsservis.tkgm.gov.tr/tkgm.ows/wms" selected>🇹🇷 T.C. TKGM (Harita Servisleri)</option>
                                <option value="https://csb.gov.tr/map/rest/services/Planlama/MapServer/WMSServer">🇹🇷 T.C. Çevre Şehircilik (Planlama)</option>
                                <option value="https://tiles.maps.eox.at/wms">🇪🇺 EOX (Sentinel-2 Görüntüleri)</option>
                                <option value="https://wms.geo.admin.ch/">🇨🇭 İsviçre Federal Coğrafya Ofisi (Swisstopo)</option>
                                <option value="https://creodias.sentinel-hub.com/ogc/wms/ceb32402-23c2-49af-b076-291771141151">🇪🇺 Copernicus (Sentinel-2 Uydu)</option>
                                <option value="https://discomap.eea.europa.eu/arcgis/services/AAS_A2_UrbanAtlas_2018/MapServer/WMSServer">🇪🇺 EEA (Kentsel Atlas)</option>

                                <option value="https://sedac.ciesin.columbia.edu/geoserver/wms">NASA SEDAC (Nüfus Yoğunluğu)</option>
                                <option value="https://mesonet.agron.iastate.edu/cgi-bin/wms/nexrad/n0r.cgi">Iowa State (Hava Durumu Radarı)</option>
                                <option value="https://ahocevar.com/geoserver/wms">Geoserver Demo (ABD Eyaletleri)</option>
                                <option value="https://basemap.nationalmap.gov/arcgis/services/USGSTopo/MapServer/WMSServer">USGS Topo (ABD Topoğrafyası)</option>
                                <option value="https://worldpop.arcgis.com/arcgis/services/WorldPop_Population_Density/MapServer/WMSServer">World Population Density (UN)</option>
                                <option value="https://wms.met.no/wms">Weather Radar (Global)</option>
                            </select>
                            <input type="text" class="form-control mt-2" id="wmsUrlInput" value="https://cbsservis.tkgm.gov.tr/tkgm.ows/wms" readonly>
                        </div>

                        <div class="mb-3">
                            <label for="wmsRequestType" class="form-label fw-bold">WMS İşlem (REQUEST) Tipi</label>
                            <select class="form-select" id="wmsRequestType" onchange="processWMSRequest(); updateRequestResultArea()">
                                <option value="GetMap" selected>GetMap (Haritayı Ekle/Görüntüle)</option>
                                <option value="GetCapabilities">GetCapabilities (Servis Bilgilerini Al)</option>
                                <option value="GetFeatureInfo">GetFeatureInfo (Nokta Sorgulama Şablonu)</option>
                                <option value="GetLegendGraphic">GetLegendGraphic (Lejant Resmini Al)</option>
                                <option value="DescribeLayer">DescribeLayer (Katman Detaylarını Al)</option>
                            </select>
                            <div class="form-text text-danger small" id="mapWarning">
                                Sadece **GetMap** haritaya katman ekler. Diğerleri URL oluşturup istek kodu alanında gösterilir.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="layerName" class="form-label fw-bold">Katman Adı (LAYERS)</label>
                            <input type="text" class="form-control" id="layerName" value="TKGM:parseller" oninput="updateRequestResultArea()">
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="button" class="btn btn-primary" onclick="processWMSRequest()">
                                İstek URL'ini Oluştur / Haritayı Güncelle
                            </button>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-success" id="showRequestResultButton" disabled onclick="fetchAndDisplayResponse()">
                                ⚙️ İstek Sonucunu Alan İçinde Göster
                            </button>
                            <div class="form-text text-muted small" id="describeLayerInfo">
                                Bu buton sadece **GetMap** dışındaki OGC istekleri seçiliyken (ve gerekiyorsa Katman Adı girilmişken) aktif olur.
                            </div>
                        </div>

                    </form>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    📑 Yayınlanan Katmanlar (LAYERS)
                </div>
                <div class="card-body p-0" style="max-height: 180px; overflow-y: auto;">
                    <ul class="list-group list-group-flush" id="availableLayersList">
                    </ul>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    🇹🇷 Özel Yerel Katmanlar
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-2">Türkiye verileri için özel servisler.</p>

                    <div class="basemap-item">
                        <span class="basemap-label">TKGM Parseller (Sabit URL)</span>
                        <label class="switch">
                            <input type="checkbox" id="tkgm-parcels">
                            <span class="slider"></span>
                        </label>
                    </div>
                    <div class="text-muted small mt-1" style="font-size: 0.75rem;">
                        ⚠️ Sadece yakınlaştırma (Zoom 15+) seviyesinde çalışır.
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

<footer class="text-center py-4 text-muted mt-5 border-top">
    <div class="container-fluid"> <p class="mb-0">owsLab - OGC Eğitim ve TKGM Entegrasyon Demosu</p>
    </div>
</footer>

<div class="modal fade" id="wktModal" tabindex="-1" aria-labelledby="wktModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title" id="wktModalLabel">✏️ WKT (Well-Known Text) Geometri İşlemleri (WGS84)</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
        </div>
        <div class="modal-body">
          
          <h6 class="text-secondary mb-3">✅ Çizilen Geometriler (WKT Formatı)</h6>
          <div id="wktList" class="list-group mb-4" style="max-height: 200px; overflow-y: auto;">
              <div class="list-group-item list-group-item-info small">Haritada çizim yaptığınızda WKT formatı buraya eklenecektir.</div>
          </div>
          
          <hr>

          <div id="bboxResultContainer" class="alert alert-warning small" style="display:none;">
            <h6 class="text-secondary">📐 Çizilen Tüm Geometrileri Kapsayan BBOX (Bounding Box)</h6>
            <div id="bboxWktOutput"></div>
            <div id="bboxEpsg3857Output" class="mt-2"></div>
            <button class="btn btn-sm btn-outline-dark mt-2" onclick="copyBboxToClipboard()">BBOX'u Kopyala (EPSG:3857)</button>
          </div>
          
          <hr id="bboxSeparator" style="display:none;">
          
          <h6 class="text-secondary mb-3">➡️ Dışarıdan WKT Yapıştır ve Haritada Görüntüle</h6>
          <textarea id="wktInput" class="form-control mb-3" rows="5" placeholder="Örn: POLYGON ((32.85 39.93, 32.9 39.9, 32.8 39.9, 32.85 39.93)) veya POINT (32.85 39.93) (Boylam Enlem Sırası)"></textarea>
          
          <div class="d-grid gap-2">
              <button type="button" class="btn btn-success" id="goToWktBtn">
                  WKT'yi Haritada Çiz ve Yakınlaş
              </button>
          </div>
          <div class="form-text text-muted small mt-2">
              WKT formatı WGS84 (**Boylam Enlem**) olmalıdır. Çizilen geometri haritaya geçici olarak eklenecektir.
          </div>
        </div>
      </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.js"></script>
<script>

    // ---------------------------------------------------------
    // WMS Katman Bilgileri ve Sabitler
    // ---------------------------------------------------------
    const WMS_LAYERS_MAP = {
        // ... (Mevcut katman listesi) ...
        "https://csb.gov.tr/map/rest/services/Planlama/MapServer/WMSServer": [
            "Planlama:Planlar (Mekânsal Planlama)",
            "Planlama:HaliHazirHaritalar (Halihazır)",
            "Planlama:NazimImar (Nazım İmar)",
            "Planlama:UygulamaImar (Uygulama İmar)"
        ],
        "https://cbsservis.tkgm.gov.tr/tkgm.ows/wms": [
            "TKGM:parseller (Parsel Bilgileri - Zoom 15+)",
            "TKGM:yapilar (Yapı Kayıtları - Zoom 15+)",
            "TKGM:mahalleler (Mahalle İdari Sınırları)",
            "TKGM:sinirlar (İdari Sınırlar)",
            "TKGM:ilceler (İlçe İdari Sınırları)",
            "TKGM:iller (İl İdari Sınırları)",
            "TKGM3D:bp_project_2d_v (3B Proje 2D Görünüm)",
            "TKGM3D:bp_project_administrative_area_parsel_v (3B Proje İdari Alan Parsel Görünümü)",
            "TKGM3D:building_photogrametric_footprint_v (Fotogrametrik Bina Taban Alanı)",
            "TKGM3D:building_photogrametric_has_architecturel_v (Fotogrametrik Yapısal Mimari Bilgi)",
            "TKGM:eklentiler (Eklenti Alanları)",
            "TKGM:irtifakhaklari (İrtifak Hakları)",
            "TKGM:kulturvarliklarialan (Kültür Varlıkları Alanları)",
            "TKGM:muhdesatlar (Muhdesat Alanları)",
            "TKGM:ozelalanbirlesimview (Özel Alan Birleşim Görünümü)",
            "TKGM:ozelguvenlikbolgeleri (Özel Güvenlik Bölgeleri)",
            "TKGM:pafta (Pafta Sınırları)",
            "TKGM:parseller_adalar (Parsel ve Ada Sınırları)",
            "TKGM:pasif_parseller (Pasif Parsel Kayıtları)",
            "TKGM:planyuzbin_hazineparsel_view (1/100K Hazine Parsel Görünümü)",
            "TKGM:planyuzbinview (1/100K Plan Görünümü)",
            "TKGM:tescilharicialanlar (Tescil Harici Alanlar)",
            "TKGM:yerkontrolnoktalari (Yer Kontrol Noktaları)"
        ],
        "https://tiles.maps.eox.at/wms": [
