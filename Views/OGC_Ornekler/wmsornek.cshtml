@{
Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OGC WMS Eğitim ve Demo Portalı - TKGM</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.css" />

    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f4f7f6; color: #333; }
        /* container-fluid kullanıldığı için varsayılan margin/padding ayarları */
        .navbar { background: linear-gradient(135deg, #1a9a03 0%, #2a5298 100%); }
        .map-container { height: 600px; width: 100%; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); border: 2px solid #e0e0e0; z-index: 1; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 15px rgba(0,0,0,0.05); margin-bottom: 20px; }
        .card-header { background-color: #fff; border-bottom: 1px solid #eee; font-weight: 600; color: #1e3c72; }
        /* Kod bloğu stilini, BBOX çıktısını daha iyi göstermek için güncelledim */
        .code-block { background-color: #2d2d2d; color: #f8f8f2; padding: 15px; border-radius: 8px; font-family: 'Consolas', monospace; font-size: 0.9rem; overflow-x: auto; white-space: pre-wrap; word-break: break-all; }
        .param-badge { background-color: #e3f2fd; color: #0d47a1; padding: 4px 8px; border-radius: 4px; font-family: monospace; font-weight: bold; }

        /* --- Toggle Switch CSS (TKGM Butonu İçin) --- */
        .basemap-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-top: 1px solid #eee; }
        .basemap-label { font-weight: 500; color: #555; }
        .switch { position: relative; display: inline-block; width: 50px; height: 24px; margin-bottom: 0; }
        .switch input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #ccc; transition: .4s; border-radius: 24px; }
        .slider:before { position: absolute; content: ""; height: 16px; width: 16px; left: 4px; bottom: 4px; background-color: white; transition: .4s; border-radius: 50%; }
        input:checked + .slider { background-color: #1e3c72; }
        input:checked + .slider:before { transform: translateX(26px); }

        /* --- Yeni Kontrol Stili (Koordinat ve Zoom) --- */
        .leaflet-control-coordinates {
            background: rgba(30, 60, 114, 0.9); /* #1e3c72 koyu mavi */
            color: white;
            padding: 5px 10px;
            font-size: 0.8rem;
            font-weight: 600;
            border-radius: 8px;
            text-shadow: 0 1px 1px rgba(0,0,0,0.5);
        }
        /* Yeni Katman Listesi Stili */
        #availableLayersList .list-group-item:hover {
            background-color: #f0f4f7;
        }
        #availableLayersList .list-group-item.active {
            background-color: #d1e7dd; /* Light green/success color */
            border-left: 4px solid #0f5132;
        }
        /* Yeni eklendi: Tıklama uyarısı */
        .click-info {
            font-size: 0.8rem;
            color: #1e3c72;
            font-weight: 500;
            padding-top: 5px;
        }
        /* XML/Metin Çıktı Stili */
        #responseCode {
            width: 100%;
            height: 400px;
            border: none;
            background-color: #2d2d2d;
            border-radius: 8px;
            font-size: 0.8rem; /* Daha okunaklı XML için font küçültüldü */
        }

        /* Kopyalama butonu için stil (Yanıt Kopyalama) */
        #copyResponseBtn {
            background-color: #0d6efd; /* Bootstrap primary color */
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 0.75rem;
            transition: background-color 0.2s;
        }
        #copyResponseBtn:hover {
            background-color: #0b5ed7;
        }

        /* YENİ: İstek URL'i Kopyalama Butonu */
        #copyRequestUrlBtn {
            background-color: #6c757d; /* Darker gray */
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 0.75rem;
            transition: background-color 0.2s;
        }
        #copyRequestUrlBtn:hover {
            background-color: #5a6268;
        }

        /* --- WMS BİLGİ KONTROL STİLLERİ --- */
        .leaflet-control-wms-info {
            box-shadow: 0 1px 5px rgba(0,0,0,0.4);
            background: #fff;
            border-radius: 5px;
            width: 280px;
            font-size: 0.85rem;
            padding: 0;
        }
        /* YENİ HEADER/BUTTON STİLİ */
        .wms-info-toggle-bar {
            background: #1e3c72;
            color: white;
            padding: 5px 10px;
            border-radius: 5px;
            display: flex;
            align-items: center;
            cursor: pointer;
            font-weight: 600;
            box-shadow: 0 1px 5px rgba(0,0,0,0.4);
        }
        .wms-info-icon {
            /* i simgesini temsil eden yuvarlak stil */
            border: 2px solid white;
            border-radius: 50%;
            width: 22px;
            height: 22px;
            line-height: 18px;
            text-align: center;
            font-size: 1rem;
            font-weight: bold;
            margin-right: 8px;
            flex-shrink: 0;
        }
        .wms-info-content {
            display: none; /* Varsayılan olarak gizli */
            padding: 10px;
            border-top: 1px solid #eee;
        }
        .wms-info-content.active {
            display: block;
        }

        /* Leaflet.draw ikonlarını koyu temaya uygun hale getirmek (opsiyonel) */
        .leaflet-draw-toolbar a {
            background-image: url('https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/images/spritesheet.png');
        }
        /* WKT Butonu, BBOX Butonu ve INFO Butonu Stilleri */
        .leaflet-control-wkt-button a,
        .leaflet-control-bbox-button a,
        .leaflet-control-feature-info-button a {
            background-image: none !important;
            background-color: #1e3c72 !important;
            color: white !important;
            font-weight: bold;
            padding: 0 5px;
            line-height: 30px;
            text-decoration: none;
            font-size: 0.9rem;
        }
        .leaflet-control-wkt-button a:hover,
        .leaflet-control-bbox-button a:hover,
        .leaflet-control-feature-info-button a:hover {
            background-color: #2a5298 !important;
        }
        /* INFO Butonunu (YENİ: GetFeatureInfo) daha belirgin yapalım */
        .leaflet-control-feature-info-button a {
            background-color: #f0ad4e !important; /* Turuncu tonu */
        }
        .leaflet-control-feature-info-button a:hover {
            background-color: #ec971f !important;
        }

        /* Kontrol yerleşimleri için boşluklar (Sağ üstteki butonların sıralaması) */
        /* Varsayılan Draw kontrolünden sonra (Çizim araçları) */
        /* leaflet-top.leaflet-right .leaflet-control:nth-child(2) zaten Leaflet.draw içindeki araç çubuğu. */
        .leaflet-top.leaflet-right .leaflet-control:nth-child(2) {
            margin-right: 5px; /* Draw kontrolü ile WKT arasında boşluk */
        }
        .leaflet-control-wkt-button {
            margin-right: 5px; /* WKT ile BBOX arasında boşluk */
        }
        /* BBOX butonu sağ üstte 4. sırada olmalı (Draw, WMSInfo, WKT, BBOX, INFO) */
        /* WMS Info kontolü yerleşimi etkiliyor. */
        /* WMS Info (1), Draw (2), WKT (3), BBOX (4), INFO (5) */
        /* INFO butonu BBOX butonunun sağında olacak. */
        .leaflet-control-bbox-button {
            margin-right: 5px; /* BBOX ile INFO arasında boşluk */
        }
        /* INFO (GetFeatureInfo) butonu en sağda. */
        .leaflet-control-feature-info-button {
            margin-left: 0; /* INFO butonu BBOX'un sağında boşluksuz olsun. */
        }


        /* Yeni Eklendi: WMS URL'ini label'a entegre etmek için stil */
        #wmsUrlInfo {
            font-size: 0.8rem;
            font-weight: normal;
            color: #495057;
            display: block;
            margin-top: 5px;
            background-color: #e9ecef;
            padding: 5px 8px;
            border-radius: 4px;
        }
        /* Yeni Eklendi: Özel URL girişi için metin alanı */
        #wmsUrlCustomInput {
            display: none; /* Başlangıçta gizli */
            margin-top: 5px;
        }
        /* --- YENİ EKLENDİ: col-lg-4'ü ve alt elemanlarını küçültmek için --- */
        /* Sütun değişimi zaten col-lg-3 ile yapıldı. İçeriği ayrıca küçültmek istiyorsak: */
        .shrink-content .card {
            width: 100%; /* Sütun genişliği %75'e düştüğü için bu zaten küçülmüş olur */
            /* transform: scale(0.75); /* Eğer %25 küçültme tam olarak istenirse. Ancak bu hizalama sorunları yaratır. */
            /* max-width: 75%; /* Bu daha kontrollü bir küçültme ve hizalama sağlar */
            /* margin-left: auto; /* Ortalamak için */
            /* margin-right: auto; */
        }

    </style>
</head>
<body>

<div class="modal fade" id="cheatSheetModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">📚 CQL & WMS Operatör Rehberi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="accordion" id="accordionOps">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#collapse1">1. Karşılaştırma Operatörleri
                                (Comparison)</button>
                        </h2>
                        <div id="collapse1" class="accordion-collapse collapse show">
                            <div class="accordion-body">
                                <p>Sayısal ve metinsel değerlerin eşitlik veya büyüklük durumlarını kontrol
                                    eder.</p>
                                <ul>
                                    <li>Eşittir: <code>CITY_NAME = 'Ankara'</code></li>
                                    <li>Eşit Değildir: <code>POPULATION &lt;&gt; 1000</code></li>
                                    <li>Büyüktür / Küçüktür: <code>AGE &gt; 18</code></li>
                                    <li>Aralık Belirtme (Dahil): <code>PRICE BETWEEN 10 AND 50</code></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#collapse2">2. Metin ve Liste
                                Operatörleri (Text & List)</button>
                        </h2>
                        <div id="collapse2" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                <p>Metin içerisindeki desenleri aramak veya bir liste içinde arama yapmak
                                    için kullanılır. (Joker karakterler: <code>%</code> çoklu,
                                    <code>_</code> tek karakter).
                                </p>
                                <ul>
                                    <li>Benzerlik (Duyarlı): <code>NAME LIKE 'Ist%'</code></li>
                                    <li>Harf Duyarsız Benzerlik: <code>NAME ILIKE 'ankara'</code></li>
                                    <li>Liste İçinde Arama: <code>CITY_NAME IN ('Izmir', 'Ankara')</code>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#collapse3">3. Mantıksal
                                Operatörler (Logical)</button>
                        </h2 >
                        <div id="collapse3" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                <p>Birden fazla koşulu birleştirmek için kullanılır.</p>
                                <ul>
                                    <li>VE: <code>POPULATION &gt; 1000000 AND CITY_NAME = 'Istanbul'</code>
                                    </li>
                                    <li>VEYA: <code>TYPE = 'River' OR TYPE = 'Lake'</code></li>
                                    <li>DEĞİL: <code>NOT (TYPE = 'Forest')</code></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#collapse4">4. Boş Değer
                                Kontrolleri (Null Checks)</button>
                        </h2>
                        <div id="collapse4" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                <p>Veri tabanında verinin girilip girilmediğini kontrol eder.</p>
                                <ul>
                                    <li>Boş: <code>ADDRESS IS NULL</code></li>
                                    <li>Dolu: <code>PHONE_NUMBER IS NOT NULL</code></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#collapse5">5. Geometrik ve
                                Uzamsal Operatörler (Spatial)</button>
                        </h2>
                        <div id="collapse5" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                <p>WFS'in en güçlü yanıdır. Coğrafi ilişkileri sorgular. (Genellikle
                                    geometri sütunu <code>geom</code> veya <code>the_geom</code> olarak
                                    adlandırılır). </p>
                                <ul>
                                    <li>Kesişme: <code>INTERSECTS(geom, POINT(32.8 39.9))</code></li>
                                    <li>İçinde Olma: <code>WITHIN(geom, POLYGON(...))</code></li>
                                    <li>Ayrık Olma: <code>DISJOINT(geom, POLYGON(...))</code></li>
                                    <li>Sınırlayıcı Kutu: <code>BBOX(geom, 26.0, 36.0, 45.0, 42.0)</code>
                                    </li>
                                    <li>Mesafe İçinde:
                                        <code>DWITHIN(geom, POINT(x y), 500, kilometers)</code>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#collapse6">6. Zaman Operatörleri
                                (Temporal)
                            </button>

                            <div id="collapse6" class="accordion-collapse collapse">
                                <div class="accordion-body">
                                    <p>Veride zaman damgası (timestamp) varsa kullanılır. Format:
                                        YYYY-MM-DDThh:mm:ssZ</p>
                                    <ul>
                                        <li>Süre İçinde:
                                            <code>time_attr DURING 2023-01-01T.../2023-12-31T...</code>
                                        </li>
                                        <li>Önce: <code>time_attr BEFORE 2023-01-01T...</code></li>
                                        <li>Sonra: <code>time_attr AFTER 2023-01-01T...</code></li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary"
                                                  data-bs-dismiss="modal">Kapat</button></div>
            </div>
        </div>
    </div>
</div>


<nav class="navbar navbar-expand-lg navbar-dark mb-4">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-globe-americas me-2" viewBox="0 0 16 16">
