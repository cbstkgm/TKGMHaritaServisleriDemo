    /**
     * GÜNCELLEDİ: Oluşturulan Request URL'ini yeni bir sekmede açar.
     */
    function openRequestUrlInNewTab() {
        const requestType = document.getElementById('wmsRequestType').value;
        let urlToOpen;

        if (requestType === 'GetFeatureInfo') {
            // GetFeatureInfo için özel mantık: Eğer bir tıklama yapıldıysa, oluşturulan URL'i kullan.
            if (lastFeatureInfoUrl) {
                urlToOpen = lastFeatureInfoUrl;
            } else {
                alert("Yeni sekmede açılacak bir GetFeatureInfo isteği URL'i bulunmuyor. Lütfen haritada bir yere tıklayıp isteği tetikleyin.");
                return;
            }
        } else if (requestType === 'GetMap') {
            // GetMap için dinamik BBOX ve boyutları içeren URL'i al
            const mapBBOX = getCurrentMapBBOX();
            const mapSize = map.getSize();
            const layer = document.getElementById('layerName').value;
            const srsCode = document.getElementById('srsCode').value;
            const cleanUrl = getCleanBaseUrl(getWMSUrl());

            // Tam GetMap URL'ini oluştur
            urlToOpen = `${cleanUrl}?SERVICE=WMS&VERSION=1.1.1&REQUEST=GetMap&LAYERS=${layer}&STYLES=&SRS=${srsCode}&BBOX=${mapBBOX}&WIDTH=${Math.round(mapSize.x)}&HEIGHT=${Math.round(mapSize.y)}&FORMAT=image/png&TRANSPARENT=TRUE`;
        } else {
            // GetCapabilities, DescribeLayer, GetLegendGraphic için temiz URL'i al
            urlToOpen = createRequestUrl(requestType);
        }

        // URL'de şablon değerleri (örneğin {width}) veya geçersiz başlangıç metni olmadığından emin ol
        if (urlToOpen && !urlToOpen.includes('{') && !urlToOpen.includes('Henüz bir istek yapılmadı')) {
            window.open(urlToOpen, '_blank');
        } else if (urlToOpen && urlToOpen.includes('{')) {
            alert(`URL şablon değerleri içeriyor (${requestType === 'GetFeatureInfo' ? 'Tıklama parametreleri' : 'BBOX'}). Lütfen GetFeatureInfo için önce haritaya tıklayın.`);
        } else {
            alert('Yeni sekmede açılabilecek geçerli bir URL bulunmamaktadır.');
        }
    }


