    function listLayersForSelectedWMS(wmsUrl) {
        const layerListElement = document.getElementById('availableLayersList');
        layerListElement.innerHTML = '';
        const layers = WMS_LAYERS_MAP[wmsUrl];

        if (layers && layers.length > 0) {
            layers.forEach(layer => {
                const parts = layer.split(' ');
                const layerName = parts[0];
                const description = parts.slice(1).join(' ');

                const listItem = document.createElement('li');
                listItem.className = 'list-group-item list-group-item-action py-2 px-3 small';
                listItem.style.cursor = 'pointer';

                listItem.onclick = function() {
                    document.getElementById('layerName').value = layerName;
                    document.querySelectorAll('#availableLayersList .list-group-item').forEach(item => item.classList.remove('active'));
                    listItem.classList.add('active');
                    processWMSRequest(); // Otomatik güncelle
                    updateRequestResultArea(); // Yeni katman seçilince butonu güncelle
                };

                listItem.innerHTML = `<span class="fw-bold text-primary">${layerName}</span> <br><span class="text-muted" style="font-size: 0.75rem;">${description}</span>`;
                layerListElement.appendChild(listItem);
            });
        } else {
            layerListElement.innerHTML = '<li class="list-group-item text-muted small">Bu WMS için statik katman bilgisi bulunmamaktadır. Lütfen Layer Adı alanına manuel giriniz.</li>';
        }
    }


