    function processWMSRequest() {
        const requestType = document.getElementById('wmsRequestType').value;

        // --- HARİTA KATMANI GÜNCELLEME MANTIĞI ---
        // GetMap, GetFeatureInfo ve DescribeLayer seçildiğinde haritada katman görünür kalmalı
        if (requestType === 'GetMap' || requestType === 'GetFeatureInfo' || requestType === 'DescribeLayer') {
            updateMapLayer();
        } else {
            // Diğer OGC istekleri için (Capabilities, GetLegendGraphic) harita katmanını kaldır
            if (genericWmsLayer) {
                map.removeLayer(genericWmsLayer);
                genericWmsLayer = null;
            }
        }

        // --- İSTEK KODUNU GÜNCELLEME ---
        // Tüm REQUEST tiplerinde URL'i güncel tut.
        updateRequestCodeForWMSOptions(requestType);

        // FeatureInfo butonunun görünürlüğünü yönet
        if (requestType === 'GetFeatureInfo') {
            featureInfoButton.show();
            // Tıklama halkasını kaldır
             if (clickBufferCircle) {
                 map.removeLayer(clickBufferCircle);
                 clickBufferCircle = null;
             }
            lastFeatureInfoUrl = null; // Yeni seçimde eski URL'i sıfırla
        } else {
            featureInfoButton.hide();
            lastFeatureInfoUrl = null;
        }
    }


    function updateMapLayer() {
        var url = getWMSUrl(); // GÜNCELLENDİ
        var layerName = document.getElementById('layerName').value;

        if (!url || !layerName || document.getElementById('wmsUrlSelect').value === 'custom' && url.length < 5) {
            // Harita katmanını kaldıralım, kullanıcıya uyarı vermeye gerek yok
            if (genericWmsLayer) { map.removeLayer(genericWmsLayer); genericWmsLayer = null; }
            return;
        }

        if (genericWmsLayer) {
            map.removeLayer(genericWmsLayer);
        }

        const cleanUrl = getCleanBaseUrl(url);
        // GetMap için kullanıcı arayüzündeki SRS'yi kullanalım
        const srsCode = document.getElementById('srsCode').value;

        genericWmsLayer = L.tileLayer.wms(cleanUrl, {
            layers: layerName,
            format: 'image/png',
            transparent: true,
            version: '1.1.1',
            crs: L.CRS.EPSG3857, // Genellikle WMS katmanları 3857'de gösterilir
            attribution: 'WMS Demo'
        });

        genericWmsLayer.addTo(map);
        updateRequestCodeForWMSOptions(document.getElementById('wmsRequestType').value);
    }

    // GÜNCELLENDİ: GetFeatureInfo isteği formatını yansıtacak şekilde düzenlendi
    function updateRequestCodeForWMSOptions(request = document.getElementById('wmsRequestType').value, customBBOX = null, clickLatlng = null, clickPixels = null) {
        var baseUrl = getWMSUrl(); // GÜNCELLENDİ
        var layer = document.getElementById('layerName').value;
        var requestCodeElement = document.getElementById('requestCode');
        var srsCode = document.getElementById('srsCode').value;

        const cleanUrl = getCleanBaseUrl(baseUrl);
        let description = ``;
        let layerParams = ``;
        let extraInfo = '';
        let mapBBOX = customBBOX || getCurrentMapBBOX() || "{minX,minY,maxX,maxY}";

        let url = `${cleanUrl}?SERVICE=WMS&VERSION=1.1.1&REQUEST=${request}`;

        switch (request) {
            case 'GetCapabilities':
                description = `
                ${url}
                \nBu istek, servisin desteklediği tüm katmanları, koordinat sistemlerini ve diğer özelliklerini XML formatında döndürür.`;
                break;

            case 'GetMap':
                layerParams = `&LAYERS=${layer}&STYLES=&SRS=${srsCode}&BBOX=${mapBBOX}&WIDTH=${map.getSize().x}&HEIGHT=${map.getSize().y}&FORMAT=image/png&TRANSPARENT=TRUE`;
                url += layerParams;
                description = `
                ${url}
                \nBu istek, belirtilen katmanın, sınırların (BBOX), boyutların (WIDTH/HEIGHT: ${map.getSize().x}x${map.getSize().y}), formatın ve **SRS=${srsCode}** koordinat sisteminin harita görüntüsünü (PNG) döndürür.`;
                break;

            case 'GetFeatureInfo':
                const featureCount = '10';
                const infoSrsCode = 'EPSG:4326'; // İstenen SRS

                if (clickLatlng) {
                    const mapSize = map.getSize();
                    const mapBounds = map.getBounds();
                    const clickPoint = map.latLngToContainerPoint(clickLatlng);

                    // Yeni fonksiyon, 4326 BBOX'u ile tam URL'i hesaplar
                    const calculatedUrl = createFeatureInfoRequestUrl(
                        mapBounds,
                        mapSize.x,
                        mapSize.y,
                        clickPoint.x,
                        clickPoint.y
                    );
                    lastFeatureInfoUrl = calculatedUrl;
                    url = calculatedUrl;
                    // I/J yerine X/Y kullanılıyor (WMS 1.1.1'de X/Y de geçerlidir, I/J ise 1.3.0'da yaygındır)
                    extraInfo += `\n   * Tıklanan Piksel (X, Y): ${Math.round(clickPoint.x)}, ${Math.round(clickPoint.y)}`;

                } else {
                    // Tıklanmadığında şablon göster (İstenen formata uygun parametreler)
                    layerParams = `&SRS=${infoSrsCode}&LAYERS=${layer}&STYLES=&FORMAT=image/png&QUERY_LAYERS=${layer}&INFO_FORMAT=text/html&FEATURE_COUNT=${featureCount}&WIDTH={width}&HEIGHT={height}&BBOX={lngMin},{latMin},{lngMax},{latMax}&X={pixelX}&Y={pixelY}`;
                    url += layerParams;
                }

                description = `
                ${url}
                \nBu istek, harita üzerindeki (X, Y piksel koordinatında) bulunan belirtilen katmanın öznitelik bilgilerini (HTML) döndürür. (SRS=${infoSrsCode})`;
                break;

            case 'GetLegendGraphic':
                url += `&LAYER=${layer}&FORMAT=image/png&WIDTH=20&HEIGHT=20`;
                description = `
                ${url}
                \nBu istek, belirtilen katmanın haritada kullanılan sembollerini gösteren bir lejant resmi (PNG) döndürür.`;
                break;

            case 'DescribeLayer':
                url += `&LAYERS=${layer}`;
                description = `
                ${url}
                \nBu istek, belirtilen katmanın detaylı şemasını (genellikle XML) döndürür.`;
                break;
        }

        if (clickLatlng) {
            extraInfo += `\n\n🎯 SON TIKLAMA BİLGİSİ: \n   Tıklanan Nokta (Lat/Lng): ${clickLatlng.lat.toFixed(6)}, ${clickLatlng.lng.toFixed(6)}`;
            // Yüksek hassasiyetli GetFeatureInfo için bu BBOX'u göstermeye gerek yok
        }

        requestCodeElement.innerText = description.trim() + extraInfo;
    }

