@{
Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OGC SOS Eğitim ve Sensör Veri Portalı</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f4f7f6; color: #333; }
        .navbar { background: linear-gradient(135deg, #e67e22 0%, #f1c40f 100%); } /* Turuncu-Sarı Ton */
        .map-container { height: 600px; width: 100%; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); border: 2px solid #e0e0e0; z-index: 1; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 15px rgba(0,0,0,0.05); margin-bottom: 20px; }
        .card-header { background-color: #fff; border-bottom: 1px solid #eee; font-weight: 600; color: #e67e22; }
        .code-block { background-color: #2d2d2d; color: #66d9ef; padding: 15px; border-radius: 8px; font-family: 'Consolas', monospace; font-size: 0.85rem; overflow-x: auto; white-space: pre-wrap; }
        .param-badge { background-color: #fcece0; color: #e67e22; padding: 4px 8px; border-radius: 4px; font-family: monospace; font-weight: bold; }

        #loading-indicator { display: none; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 9999; background: rgba(255,255,255,0.9); padding: 20px; border-radius: 10px; box-shadow: 0 0 10px rgba(0,0,0,0.2); text-align: center; }

        .feature-marker { background-color: #e67e22; width: 15px; height: 15px; display: block; border-radius: 50%; border: 3px solid #fff; box-shadow: 0 0 5px rgba(0,0,0,0.5); }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="#">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-thermometer-half me-2" viewBox="0 0 16 16">
                <path d="M9.5 12.5a1.5 1.5 0 1 1-2-1.414V6c0-.528.484-1 1-1s1 .472 1 1v5.086a1.5 1.5 0 0 1-2 1.414z"/>
                <path fill-rule="evenodd" d="M1 8a7 7 0 1 0 14 0A7 7 0 0 0 1 8zm14 0A6 6 0 1 1 2 8a6 6 0 0 1 12 0zM8 0a.5.5 0 0 1 .5.5v1.5a.5.5 0 0 1-1 0V.5A.5.5 0 0 1 8 0zM5.5 8a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1 0-1h1a.5.5 0 0 1 .5.5zm8 0a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1 0-1h1a.5.5 0 0 1 .5.5zM8 12a.5.5 0 0 1 .5-.5h-1a.5.5 0 0 1 0-1h1a.5.5 0 0 1 .5.5v1.5a.5.5 0 0 1-1 0V12z"/>
            </svg>
            OGC SOS (Sensör Veri) Portalı
        </a>
    </div>
</nav>

<div class="container">
    <div class="row">
        <div class="col-lg-4">

            <div class="card">
                <div class="card-header">
                    📚 SOS Nedir? (Sensor Observation Service)
                </div>
                <div class="card-body">
                    <p class="small text-muted">SOS, sensörlerden gelen (hava, su, titreşim vb.) **zamana bağlı ölçüm (Observation)** verilerini standart <span class="param-badge">O&M (Observation & Measurement)</span> formatında sunar.</p>
                    <hr />
                    <h6>Temel Parametreler:</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-1"><span class="param-badge">SERVICE</span>: SOS</li>
                        <li class="mb-1"><span class="param-badge">REQUEST</span>: GetObservation (Ölçümleri getir)</li>
                        <li class="mb-1"><span class="param-badge">OFFERING</span>: Hangi sensör setinden veri istendiği</li>
                        <li class="mb-1"><span class="param-badge">OBSERVEDPROPERTY</span>: Ölçülen parametre (Sıcaklık, Basınç vb.)</li>
                        <li class="mb-1"><span class="param-badge">PROCEDURE</span>: Tek bir sensör/istasyon ID'si</li>
                    </ul>
                </div>
            </div>

            <div class="card bg-light">
                <div class="card-header">
                    ⚙️ SOS Servis Ayarları (Türkiye Örneği Dahil)
                </div>
                <div class="card-body">
                    <form id="sosForm">
                        <div class="mb-3">
                            <label for="sosUrlSelect" class="form-label fw-bold">SOS Servis URL</label>
                            <select class="form-select" id="sosUrlSelect">
                                <option value="https://geoserver.gisc.gmu.edu/geoserver/sos" data-offering="GMU_SOS_OFFERING" data-property="urn:ogc:def:phenomenon:OGC:1.0.3:air_temperature" data-procedure="urn:ogc:def:procedure:OGC:1.0.3:station_id_10" data-center="38.8, -77.3" data-zoom="10">1. GeoServer Demo (ABD)</option>
                                <option value="https://havaizleme.cevre.gov.tr/sos/service" data-offering="AQMS_Offering" data-property="PM10" data-procedure="TR_AQMS_001" data-center="39.9255, 32.8647" data-zoom="12" selected>2. Türkiye (Hava Kalitesi İzleme Ağı)</option>
                                <option value="https://data.swe.kit.edu/sos/data.php" data-offering="urn:x-plug-in:default" data-property="http://www.opengis.net/def/phenomenon/OGC/1.0.3/air_temperature" data-procedure="urn:x-plug-in:default:2836" data-center="49.0, 8.4" data-zoom="12">3. KIT SOS Demo (Almanya - Su/Hava)</option>
                                <option value="https://data.nile-basin.org/sos/data.php" data-offering="urn:x-plug-in:default" data-property="http://www.opengis.net/def/phenomenon/OGC/1.0.3/WaterFlow" data-procedure="urn:x-plug-in:default:3347" data-center="15.0, 32.0" data-zoom="5">4. Nile Basin (Afrika - Su Akışı)</option>
                                <option value="https://sos.efg-service.de/sos/data.php" data-offering="urn:ogc:def:service:SOS:EFG" data-property="http://www.opengis.net/def/phenomenon/OGC/1.0.3/water_level" data-procedure="urn:ogc:def:procedure:OGC:EFG:station_id_333" data-center="51.5, 10.0" data-zoom="6">5. EFG SOS (Almanya - Su Seviyesi)</option>
                                <option value="https://www.lcsas.org/sos/data.php" data-offering="urn:x-plug-in:default" data-property="http://www.opengis.net/def/phenomenon/OGC/1.0.3/air_temperature" data-procedure="urn:x-plug-in:default:1337" data-center="42.5, 1.5" data-zoom="8">6. LCSAS (Avrupa)</option>
                                <option value="https://vms.oceanobservatories.org/sos/" data-offering="urn:ooc-o-s:MOAS_OON_D002_NSI003" data-property="http://sweet.jpl.nasa.gov/2.0/phys.property.html#Temperature" data-procedure="urn:ooc-o-p:D002:NSI003" data-center="35.0, -125.0" data-zoom="4">7. OOI (Okyanus - Sıcaklık)</option>
                                <option value="https://sos.awi.de/sos/data.php" data-offering="urn:x-plug-in:default" data-property="http://www.opengis.net/def/phenomenon/OGC/1.0.3/air_pressure" data-procedure="urn:x-plug-in:default:333" data-center="75.0, 10.0" data-zoom="3">8. AWI (Kutup Araştırmaları - Basınç)</option>
                                <option value="https://data.52north.org/sos/data.php" data-offering="urn:x-plug-in:default" data-property="http://www.opengis.net/def/phenomenon/OGC/1.0.3/air_temperature" data-procedure="urn:x-plug-in:default:10" data-center="51.0, 7.0" data-zoom="10">9. 52° North (Genel Demo)</option>
                                <option value="https://sos.bafg.de/sos/data.php" data-offering="urn:x-plug-in:default" data-property="http://www.opengis.net/def/phenomenon/OGC/1.0.3/WaterFlow" data-procedure="urn:x-plug-in:default:1001" data-center="52.0, 12.0" data-zoom="6">10. BfG (Almanya - Su Akışı)</option>
                            </select>
                            <input type="text" class="form-control mt-2" id="sosUrlInput" value="https://havaizleme.cevre.gov.tr/sos/service" readonly>
                        </div>

                        <div class="mb-3">
                            <label for="offeringId" class="form-label fw-bold">Offering ID (Sensör Grubu)</label>
                            <input type="text" class="form-control" id="offeringId" value="AQMS_Offering">
                            <div class="form-text small">Hangi sensör setinden veri isteneceğini belirler.</div>
                        </div>

                        <div class="mb-3">
                            <label for="observedProperty" class="form-label fw-bold">Observed Property (Ölçülen Değer)</label>
                            <input type="text" class="form-control" id="observedProperty" value="PM10">
                            <div class="form-text small">Örn: PM10 (Partikül Madde), O3 (Ozon).</div>
                        </div>

                        <div class="mb-3">
                            <label for="procedureId" class="form-label fw-bold">Procedure ID (Sensör İstasyon)</label>
                            <input type="text" class="form-control" id="procedureId" value="TR_AQMS_001">
                            <div class="form-text small">Tek bir sensörün/istasyonun ID'si (Örn: Ankara-Sıhhiye İstasyonu).</div>
                        </div>

                        <div class="mb-3">
                            <label for="timePeriod" class="form-label fw-bold">Time Period (Zaman Aralığı)</label>
                            <input type="text" class="form-control" id="timePeriod" value="2024-01-01T00:00:00Z/2024-01-02T00:00:00Z">
                            <div class="form-text small">ISO 8601 formatı: `Başlangıç/Bitiş`. (Tarihi güncelledim)</div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-primary mb-2" onclick="generateGetObservationRequest()">
                                📈 GetObservation İsteği Oluştur
                            </button>
                            <button type="button" class="btn btn-info" onclick="generateGetCapabilitiesRequest()">
                                🔍 GetCapabilities İsteği Oluştur
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>🗺️ Sensör Konumu Önizlemesi</span>
                    <span class="badge bg-warning text-dark" id="request-type">GetObservation</span>
                </div>
                <div class="card-body p-0 position-relative">
                    <div id="loading-indicator">
                        <div class="spinner-border text-primary" role="status"></div>
                        <div>İstek Yürütülüyor...</div>
                    </div>
                    <div id="map" class="map-container"></div>
                </div>
                <div class="card-footer text-muted small">
                    Harita, seçili $\text{Procedure ID}$'nin coğrafi konumunu göstermeyi amaçlar.
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    💻 Oluşturulan SOS İsteği URL'i
                </div>
                <div class="card-body bg-dark p-0">
                    <div class="code-block" id="requestCode">
                        İstek URL'i burada gösterilecektir.
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    🔗 Direkt İstek Linki (Veriyi İndir/Görüntüle)
                </div>
                <div class="card-body">
                    <a href="#" id="downloadLink" class="btn btn-outline-success btn-sm" target="_blank" disabled>İsteği Tarayıcıda Aç</a>
                </div>
            </div>
        </div>
    </div>
</div>

<footer class="text-center py-4 text-muted mt-5 border-top">
    <div class="container">
        <p class="mb-0">owsLab - SOS Sensör Veri Entegrasyon Demosu</p>
    </div>
</footer>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    // ---------------------------------------------------------
    // 1. HARİTA BAŞLATMA VE MARKER YÖNETİMİ
    // ---------------------------------------------------------
    var map = L.map('map').setView([39.9255, 32.8647], 12); // Varsayılan: Ankara
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    var stationMarker = null;

    // Haritada sensör konumunu gösteren fonksiyon (Hardcoded koordinatlar ile)
    function updateSensorLocation(lat, lon, zoom) {
        if (stationMarker) map.removeLayer(stationMarker);

        const customIcon = L.divIcon({
            className: 'feature-marker',
            iconSize: [15, 15]
        });

        stationMarker = L.marker([lat, lon], {icon: customIcon})
            .addTo(map)
            .bindPopup(`Sensör Konumu: ${lat.toFixed(4)}, ${lon.toFixed(4)}`)
            .openPopup();

        map.setView([lat, lon], zoom);
    }

    // ---------------------------------------------------------
    // 2. SERVİS SEÇİM MANTIĞI
    // ---------------------------------------------------------

    document.getElementById('sosUrlSelect').addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];

        const url = selectedOption.value;
        const offering = selectedOption.getAttribute('data-offering');
        const property = selectedOption.getAttribute('data-property');
        const procedure = selectedOption.getAttribute('data-procedure');
        const center = selectedOption.getAttribute('data-center').split(',').map(c => parseFloat(c));
        const zoom = parseInt(selectedOption.getAttribute('data-zoom'));

        // Form alanlarını güncelle
        document.getElementById('sosUrlInput').value = url;
        document.getElementById('offeringId').value = offering;
        document.getElementById('observedProperty').value = property;
        document.getElementById('procedureId').value = procedure;

        // Harita ve Marker'ı güncelle (Merkeze ve varsayılan sensöre odaklan)
        updateSensorLocation(center[0], center[1], zoom);

        // İlk yüklemede GetObservation isteğini oluştur
        generateGetObservationRequest();
    });

    // ---------------------------------------------------------
    // 3. İSTEK OLUŞTURMA FONKSİYONLARI
    // ---------------------------------------------------------

    // Genel istek oluşturma ve URL/Link güncelleme
    function buildRequest(requestType) {
        const baseUrl = document.getElementById('sosUrlInput').value;
        const offeringId = document.getElementById('offeringId').value;
        const observedProperty = document.getElementById('observedProperty').value;
        const procedureId = document.getElementById('procedureId').value;
        const timePeriod = document.getElementById('timePeriod').value;

        const sosUrl = new URL(baseUrl);
        sosUrl.searchParams.append("service", "SOS");
        sosUrl.searchParams.append("version", "1.0.0"); // 1.0.0 veya 2.0.0 yaygın kullanılır
        sosUrl.searchParams.append("request", requestType);

        // GetObservation'a özel parametreler
        if (requestType === "GetObservation") {
            sosUrl.searchParams.append("offering", offeringId);
            sosUrl.searchParams.append("observedProperty", observedProperty);
            // Sadece tek bir istasyon için filtreleme
            sosUrl.searchParams.append("procedure", procedureId);
            sosUrl.searchParams.append("eventTime", timePeriod);
            // Çıktı formatı: XML/O&M (Sunucuya göre değişir)
            sosUrl.searchParams.append("responseFormat", "text/xml; subtype=\"om/1.0.0\"");
        }

        const finalUrl = decodeURIComponent(sosUrl.toString());

        document.getElementById('requestCode').innerText = finalUrl;

        const downloadLink = document.getElementById('downloadLink');
        downloadLink.href = finalUrl;
        downloadLink.disabled = false;
        downloadLink.innerText = `İsteği Tarayıcıda Aç (${requestType})`;
        document.getElementById('request-type').innerText = requestType;
    }

    // GetObservation'ı tetikler
    function generateGetObservationRequest() {
        buildRequest("GetObservation");
    }

    // GetCapabilities'i tetikler (Servisin yeteneklerini listeler)
    function generateGetCapabilitiesRequest() {
        buildRequest("GetCapabilities");
    }


    // ---------------------------------------------------------
    // 4. İLK YÜKLEME
    // ---------------------------------------------------------
    window.onload = function() {
        // İlk servisi (Artık Türkiye) otomatik olarak yükle ve isteği oluştur
        document.getElementById('sosUrlSelect').value = "https://havaizleme.cevre.gov.tr/sos/service";
        document.getElementById('sosUrlSelect').dispatchEvent(new Event('change'));
        document.getElementById('loading-indicator').style.display = 'none';
    };

</script>
</body>
</html>