@{
Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OGC WMS (SLD Destekli) ve Raster Harita Portalı</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f4f7f6; color: #333; }
        .navbar { background: linear-gradient(135deg, #e74c3c 0%, #f39c12 100%); } /* İsviçre Kırmızısı ve Sarı Tonları */
        .map-container { height: 600px; width: 100%; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); border: 2px solid #e0e0e0; z-index: 1; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 15px rgba(0,0,0,0.05); margin-bottom: 20px; }
        .card-header { background-color: #fff; border-bottom: 1px solid #eee; font-weight: 600; color: #e74c3c; }
        .code-block { background-color: #2d2d2d; color: #f92672; padding: 15px; border-radius: 8px; font-family: 'Consolas', monospace; font-size: 0.85rem; overflow-x: auto; white-space: pre-wrap; }
        .param-badge { background-color: #fcece0; color: #e74c3c; padding: 4px 8px; border-radius: 4px; font-family: monospace; font-weight: bold; }

        #loading-indicator { display: none; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 9999; background: rgba(255,255,255,0.9); padding: 20px; border-radius: 10px; box-shadow: 0 0 10px rgba(0,0,0,0.2); text-align: center; }

        .sld-editor { resize: vertical; min-height: 150px; font-family: 'Consolas', monospace; font-size: 0.8rem; background-color: #f8f8f8; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="#">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-palette2 me-2" viewBox="0 0 16 16">
                <path d="M11.982 11.982a1 1 0 0 0-1.026.177L6.85 14.33a.5.5 0 0 1-.644-.094l-3.32-3.832a.5.5 0 0 1-.106-.47L3.924 6.91a1 1 0 0 0-.177-1.026L.182 2.686a.5.5 0 0 1 .158-.654l.872-.654a.5.5 0 0 1 .654.158L5.89 4.076a1 1 0 0 0 1.026.177l4.106-2.434a.5.5 0 0 1 .644.094l3.32 3.832a.5.5 0 0 1 .106.47l-.994 4.091a1 1 0 0 0 .177 1.026l3.702 3.702a.5.5 0 0 1-.158.654l-.872.654a.5.5 0 0 1-.654-.158L11.982 11.982z"/>
            </svg>
            OGC WMS (SLD Destekli) Portalı - Swisstopo Odaklı
        </a>
    </div>
</nav>

<div class="container">
    <div class="row">
        <div class="col-lg-4">

            <div class="card">
                <div class="card-header">
                    📚 WMS ve SLD Nedir?
                </div>
                <div class="card-body">
                    <p class="small text-muted">**WMS**, haritaları resim (**Raster**) olarak sunar. **SLD** (Styled Layer Descriptor), WMS isteğine eklenerek sunucudaki haritanın çizim stilini dinamik olarak değiştirmeye yarayan bir **XML** standardıdır.</p>
                    <hr />
                    <h6>Temel Parametreler:</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-1"><span class="param-badge">SERVICE</span>: WMS</li>
                        <li class="mb-1"><span class="param-badge">REQUEST</span>: GetMap (Harita resmi getir)</li>
                        <li class="mb-1"><span class="param-badge">LAYERS</span>: Katman Adı</li>
                        <li class="mb-1"><span class="param-badge">SLD_BODY</span>: SLD XML içeriği</li>
                    </ul>
                </div>
            </div>

            <div class="card bg-light">
                <div class="card-header">
                    ⚙️ WMS Servis Ayarları (Swisstopo Ağırlıklı)
                </div>
                <div class="card-body">
                    <form id="wmsForm">
                        <div class="mb-3">
                            <label for="wmsUrlSelect" class="form-label fw-bold">WMS URL</label>
                            <select class="form-select" id="wmsUrlSelect">
                                <option value="https://ahocevar.com/geoserver/wms"
                                        data-layers="topp:states"
                                        data-center="40.0, -98.0"
                                        data-zoom="4">
                                    1. GeoServer Demo (ABD Eyaletleri)
                                </option>
                                <option value="https://wms.geo.admin.ch/"
                                        data-layers="ch.swisstopo.swissboundaries3d-kanton-flaeche.fill"
                                        data-center="46.8, 8.2"
                                        data-zoom="7" selected>
                                    2. Swisstopo - Kantonal Sınırlar (Varsayılan)
                                </option>
                                <option value="https://wms.geo.admin.ch/"
                                        data-layers="ch.swisstopo.amtliches-strassenverzeichnis"
                                        data-center="46.8, 8.2"
                                        data-zoom="9">
                                    3. Swisstopo - Resmi Yol Ağı
                                </option>
                                <option value="https://wms.geo.admin.ch/"
                                        data-layers="ch.swisstopo.geologie-eiszeiten-lgm"
                                        data-center="46.8, 8.2"
                                        data-zoom="8">
                                    4. Swisstopo - Buzul Çağı Haritası
                                </option>
                                <option value="https://wms.geo.admin.ch/"
                                        data-layers="ch.swisstopo.zeitreihen.ortho-photo"
                                        data-center="46.8, 8.2"
                                        data-zoom="12">
                                    5. Swisstopo - Ortofoto (Hava Fotoğrafı)
                                </option>
                                <option value="https://wms.geo.admin.ch/"
                                        data-layers="ch.swisstopo.fixpunkte-hoehe-ln02"
                                        data-center="46.8, 8.2"
                                        data-zoom="10">
                                    6. Swisstopo - Yükseklik Sabit Noktaları
                                </option>
                                <option value="https://wms.geo.admin.ch/"
                                        data-layers="ch.bazl.luftfahrtkarten-icao"
                                        data-center="46.8, 8.2"
                                        data-zoom="7">
                                    7. Swisstopo - Havacılık Haritası (ICAO)
                                </option>
                                <option value="https://wms.geo.admin.ch/"
                                        data-layers="ch.swisstopo.vec25-gewaesser"
                                        data-center="46.8, 8.2"
                                        data-zoom="9">
                                    8. Swisstopo - Su Kütleleri/Akarsular
                                </option>
                                <option value="https://wms.geo.admin.ch/"
                                        data-layers="ch.swisstopo.swissimage"
                                        data-center="46.8, 8.2"
                                        data-zoom="12">
                                    9. Swisstopo - Swissimage (Yüksek Çöz. Ortofoto)
                                </option>
                                <option value="https://wms.geo.admin.ch/"
                                        data-layers="ch.swisstopo.pixelkarte-farbe"
                                        data-center="46.8, 8.2"
                                        data-zoom="8">
                                    10. Swisstopo - Renkli Raster Harita
                                </option>
                            </select>
                            <input type="text" class="form-control mt-2" id="wmsUrlInput" value="https://wms.geo.admin.ch/" readonly>
                        </div>

                        <div class="mb-3">
                            <label for="layers" class="form-label fw-bold">LAYERS (Katman Adı)</label>
                            <input type="text" class="form-control" id="layers" value="ch.swisstopo.swissboundaries3d-kanton-flaeche.fill">
                            <div class="form-text small">WMS'te katman adı 'LAYERS' parametresi ile çağrılır.</div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-primary" onclick="loadWmsLayer()">
                                Haritayı Yenile (Varsayılan Stil)
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    ✍️ SLD (Styled Layer Descriptor) XML
                </div>
                <div class="card-body">
                    <textarea id="sldBody" class="form-control sld-editor" rows="8">
&lt;StyledLayerDescriptor version="1.0.0"&gt;
  &lt;NamedLayer&gt;
    &lt;Name&gt;ch.swisstopo.swissboundaries3d-kanton-flaeche.fill&lt;/Name&gt;
    &lt;UserStyle&gt;
      &lt;Name&gt;Sade Kırmızı Stil&lt;/Name&gt;
      &lt;FeatureTypeStyle&gt;
        &lt;Rule&gt;
          &lt;PolygonSymbolizer&gt;
            &lt;Fill&gt;
              &lt;CssParameter name="fill"&gt;#FF5733&lt;/CssParameter&gt;
              &lt;CssParameter name="fill-opacity"&gt;0.5&lt;/CssParameter&gt;
            &lt;/Fill&gt;
            &lt;Stroke&gt;
              &lt;CssParameter name="stroke"&gt;#C70039&lt;/CssParameter&gt;
              &lt;CssParameter name="stroke-width"&gt;2&lt;/CssParameter&gt;
            &lt;/Stroke&gt;
          &lt;/PolygonSymbolizer&gt;
        &lt;/Rule&gt;
      &lt;/FeatureTypeStyle&gt;
    &lt;/UserStyle&gt;
  &lt;/NamedLayer&gt;
&lt;/StyledLayerDescriptor&gt;
                    </textarea>
                    <div class="alert alert-info mt-2 small p-2">
                        ⚠️ **Not:** SLD içeriği, `SLD_BODY` parametresi ile URL'ye URL-encoded olarak eklenir. Katman adını (`&lt;Name&gt;`) değiştirmeyi unutmayın!
                    </div>
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-warning" onclick="loadWmsLayer(true)">
                            SLD İle Haritayı Yenile (Dinamik Stil)
                        </button>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>🗺️ Raster Harita (WMS Katmanı)</span>
                    <span class="badge bg-secondary" id="request-type-badge">WMS GetMap</span>
                </div>
                <div class="card-body p-0 position-relative">
                    <div id="loading-indicator">
                        <div class="spinner-border text-primary" role="status"></div>
                        <div>Harita İndiriliyor...</div>
                    </div>
                    <div id="map" class="map-container"></div>
                </div>
                <div class="card-footer text-muted small">
                    Harita resmi, sunucudan `SLD` parametresine göre çizilmiş olarak gelmektedir.
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    💻 Yapılan WMS İsteği URL'i
                </div>
                <div class="card-body bg-dark p-0">
                    <div class="code-block" id="requestCode">
                        Harita isteği URL'i burada gösterilecektir.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<footer class="text-center py-4 text-muted mt-5 border-top">
    <div class="container">
        <p class="mb-0">owsLab - WMS ve SLD Entegrasyon Demosu</p>
    </div>
</footer>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    // ---------------------------------------------------------
    // 1. HARİTA BAŞLATMA
    // ---------------------------------------------------------
    // Varsayılan: İsviçre merkezine odaklanma
    var map = L.map('map').setView([46.8, 8.2], 7);
    var wmsLayer = null;
    var hasWmsErrorOccurred = false; // Hatanın bir kez uyarıldığını kontrol eden bayrak

    // Temel Harita Katmanı
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    // ---------------------------------------------------------
    // 2. SERVİS SEÇİM MANTIĞI
    // ---------------------------------------------------------

    document.getElementById('wmsUrlSelect').addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];

        const url = selectedOption.value;
        const layers = selectedOption.getAttribute('data-layers');
        const center = selectedOption.getAttribute('data-center').split(',').map(c => parseFloat(c));
        const zoom = parseInt(selectedOption.getAttribute('data-zoom'));

        // Form alanlarını güncelle
        document.getElementById('wmsUrlInput').value = url;
        document.getElementById('layers').value = layers;

        // Haritayı ve görünümü güncelle
        map.setView([center[0], center[1]], zoom);

        // SLD içeriğindeki katman adını otomatik güncelle (Örnek: GeoServer'dan Swisstopo'ya geçişte)
        const sldTextarea = document.getElementById('sldBody');
        // RegEx ile <Name>...</Name> içindeki içeriği değiştirme
        sldTextarea.value = sldTextarea.value.replace(/<Name>.*?<\/Name>/g, `<Name>${layers}</Name>`);

        // Katman değiştikçe yeni katmanı yükle
        loadWmsLayer();
    });

    // ---------------------------------------------------------
    // 3. WMS VE SLD İSTEĞİ OLUŞTURMA (TEK HATA UYARISI)
    // ---------------------------------------------------------

    function loadWmsLayer(useSld = false) {
        document.getElementById('loading-indicator').style.display = 'block';

        const baseUrl = document.getElementById('wmsUrlInput').value;
        const layers = document.getElementById('layers').value;

        // Leaflet WMS katmanını kaldır
        if (wmsLayer) map.removeLayer(wmsLayer);

        let wmsParams = {
            service: 'WMS',
            version: '1.1.1',
            request: 'GetMap',
            layers: layers,
            styles: '',
            format: 'image/png',
            transparent: true,
            srs: 'EPSG:4326'
        };

        let finalUrl = baseUrl;
        let sldContent = "";

        if (useSld) {
            sldContent = document.getElementById('sldBody').value.trim();
            // SLD_BODY içeriğini URL'ye ekle
            wmsParams.SLD_BODY = sldContent;
            document.getElementById('request-type-badge').innerText = "WMS GetMap (SLD)";
        } else {
            document.getElementById('request-type-badge').innerText = "WMS GetMap (Varsayılan)";
        }

        // URL gösterimi (sadece bilgi amaçlı)
        let requestUrl = `${finalUrl}?SERVICE=${wmsParams.service}&VERSION=${wmsParams.version}&REQUEST=${wmsParams.request}&LAYERS=${wmsParams.layers}&STYLES=${wmsParams.styles}&FORMAT=${wmsParams.format}&TRANSPARENT=${wmsParams.transparent}&SRS=${wmsParams.srs}`;

        // SLD varsa ekle ve URL-encode et
        if (useSld && sldContent) {
            const encodedSld = encodeURIComponent(sldContent);
            requestUrl += `&SLD_BODY=${encodedSld}`;

            document.getElementById('requestCode').innerText = requestUrl + ' (BBOX ve Boyutlar eksik)';

        } else {
            document.getElementById('requestCode').innerText = requestUrl + ' (BBOX ve Boyutlar eksik)';
        }


        // Leaflet WMS Katmanını Oluşturma
        wmsLayer = L.tileLayer.wms(finalUrl, wmsParams).addTo(map);

        // Hata bayrağını her katman yüklemesinde sıfırla
        hasWmsErrorOccurred = false;

        wmsLayer.on('load', function() {
            document.getElementById('loading-indicator').style.display = 'none';
        });

        // GÜNCELLENMİŞ HATA YÖNETİMİ: Tek bir uyarı gösterir
        wmsLayer.on('tileerror', function(e) {
            document.getElementById('loading-indicator').style.display = 'none';

            // Eğer daha önce bir hata uyarısı gösterilmediyse, uyar
            if (!hasWmsErrorOccurred) {
                alert("WMS Hatası: Servis yanıt vermedi veya CORS/SLD sorunu var. Lütfen URL'yi ve SLD XML'i kontrol edin.\n(Bu uyarı, tarayıcınız yeniden yüklenene kadar bir daha gösterilmeyecektir.)");

                // Bayrağı TRUE yap, böylece bir sonraki tileerror olayı uyarılmaz.
                hasWmsErrorOccurred = true;
            }

            console.error("WMS Tile Error:", e);
        });
    }

    // ---------------------------------------------------------
    // 4. İLK YÜKLEME
    // ---------------------------------------------------------
    window.onload = function() {
        // Dropdown'da Swisstopo'yu (2. sıradaki) seçili hale getir
        document.getElementById('wmsUrlSelect').value = "https://wms.geo.admin.ch/";

        // Dropdown change olayını tetikleyerek varsayılan ayarları (Swisstopo) yükle
        document.getElementById('wmsUrlSelect').dispatchEvent(new Event('change'));
        document.getElementById('loading-indicator').style.display = 'none';
    };

</script>
</body>
</html>