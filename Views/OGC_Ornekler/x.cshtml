<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/languages/http.min.js"></script>

<script>
    // -----------------------------------------------------------
    // CONSOLE/TERMINAL LOG MANTIĞI (YENİ)
    // -----------------------------------------------------------
    function logToConsole(type, message) {
        const consoleOutput = document.getElementById('consoleOutput');
        if (!consoleOutput) return;

        const now = new Date();
        const timestamp = `<span class="log-timestamp">[${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}:${now.getSeconds().toString().padStart(2, '0')}]</span>`;

        let typeClass = '';
        switch (type.toUpperCase()) {
            case 'INFO':
                typeClass = 'log-info';
                break;
            case 'SUCCESS':
                typeClass = 'log-success';
                break;
            case 'ERROR':
                typeClass = 'log-error';
                break;
            case 'WARNING':
                typeClass = 'log-warning';
                break;
            default:
                typeClass = 'log-info';
        }

        const logEntry = document.createElement('div');
        logEntry.innerHTML = `${timestamp} <span class="${typeClass}">${type.toUpperCase()}</span>: ${message}`;
        consoleOutput.appendChild(logEntry);

        // Otomatik aşağı kaydır
        consoleOutput.scrollTop = consoleOutput.scrollHeight;
    }


    // -----------------------------------------------------------
    // 1. HARİTA KURULUMU & GEOMETRİ HESAPLAMA
    // -----------------------------------------------------------
    var map = L.map('map').setView([40.653, 35.815], 15);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap' }).addTo(map);

    var drawnItems = new L.FeatureGroup();
    map.addLayer(drawnItems);
    var previewLayer = null;

    var drawControl = new L.Control.Draw({
        edit: { featureGroup: drawnItems, remove: true },
        draw: {
            polygon: { shapeOptions: { color: '#e91e63' }, allowIntersection: false },
            rectangle: { shapeOptions: { color: '#9c27b0' } },
            circle: false, marker: false, polyline: false, circlemarker: false
        }
    });
    map.addControl(drawControl);

    let currentWkt = null;
    let currentBbox = null; // WGS84: minLng, minLat, maxLng, maxLat


    // WKT / BBOX yardımcı fonksiyonları
    function latLngToWKT(latlng) {
        return `${latlng.lng.toFixed(7)} ${latlng.lat.toFixed(7)}`;
    }

    function geoJsonToWkt(geojson) {
        if (!geojson || !geojson.geometry) return "GEOMETRYCOLLECTION EMPTY";

        const type = geojson.geometry.type.toUpperCase();
        const coords = geojson.geometry.coordinates;

        // Leaflet Draw, Polygonlar için ilk ve son koordinatı tekrar eder, WKT formatı da bunu ister.
        if (type === 'POLYGON' || type === 'RECTANGLE') {
            const rings = coords.map(ring => {
                // Leaflet GeoJSON formatında [Lng, Lat] döndürür, WKT ise Lat Lng'ye dikkat etmelidir.
                // TKGM WFS'in (GeoServer) varsayılan geometrisi: WKT'de X (Boylam/Lng), Y (Enlem/Lat) sırasını bekler.
                return `(${ring.map(c => `${c[0].toFixed(7)} ${c[1].toFixed(7)}`).join(', ')})`;
            });
            // WKT'de POLYGON(RING1, RING2, ...) şeklindedir.
            return `POLYGON ${rings.join(', ')}`;
        }
        if (type === 'POINT') {
            return `POINT (${coords[0].toFixed(7)} ${coords[1].toFixed(7)})`;
        }
        return "";
    }

    // Çizim olayını dinle
    map.on(L.Draw.Event.CREATED, function (e) {
        drawnItems.clearLayers();
        var layer = e.layer;
        drawnItems.addLayer(layer);

        const geojson = layer.toGeoJSON();
        const bounds = layer.getBounds();

        currentWkt = geoJsonToWkt(geojson);
        currentBbox = `${bounds.getSouthWest().lng.toFixed(7)},${bounds.getSouthWest().lat.toFixed(7)},${bounds.getNorthEast().lng.toFixed(7)},${bounds.getNorthEast().lat.toFixed(7)}`;

        document.getElementById('drawStatus').innerText = "✅ Çizim Yapıldı";
        document.getElementById('drawStatus').className = "badge bg-success w-100 mb-3";
        updateUrlPreview();
        logToConsole('SUCCESS', `Harita üzerine ${e.layerType.toUpperCase()} çizildi. Mekansal filtre hazır.`);
    });

    map.on(L.Draw.Event.DELETED, function () {
        currentWkt = null;
        currentBbox = null;
        document.getElementById('drawStatus').innerText = "Çizim Yok";
        document.getElementById('drawStatus').className = "badge bg-secondary w-100 mb-3";
        updateUrlPreview();
        logToConsole('WARNING', 'Çizilen geometri silindi. Mekansal filtre kaldırıldı.');
    });

    // -----------------------------------------------------------
    // 1.1. WKT & BBOX KONTROLLERİ (Aynı kalıyor)
    // -----------------------------------------------------------

    function updateWKTModalContent() {
        // Modal içeriği güncellenir
        const wktOutput = document.getElementById('wktOutput');
        const bboxOutput = document.getElementById('bboxOutput');

        if (!currentWkt || !currentBbox) {
            wktOutput.innerHTML = '<div class="alert alert-danger small">Haritada çizili geçerli bir geometri bulunmamaktadır.</div>';
            bboxOutput.innerHTML = '<div class="alert alert-danger small">BBOX bilgisi mevcut değil.</div>';
            return;
        }

        wktOutput.innerHTML = `
                <span class="badge bg-primary">WKT (WGS84 Boylam Enlem):</span>
                <code style="font-size:0.75rem; color:#0056b3; background-color: #f8f9fa; display:block; padding: 8px; border-radius: 4px; overflow-x: auto;">${currentWkt}</code>
                <button class="btn btn-sm btn-outline-primary mt-2" onclick="navigator.clipboard.writeText('${currentWkt}'); logToConsole('INFO', 'WKT panoya kopyalandı.');">WKT Kopyala</button>
            `;

        bboxOutput.innerHTML = `
                <span class="badge bg-warning text-dark">BBOX (WGS84 Lng,Lat,Lng,Lat):</span>
                <code style="font-size:0.75rem; color:#856404; background-color: #fff3cd; display:block; padding: 8px; border-radius: 4px; overflow-x: auto;">${currentBbox}</code>
                <span class="badge bg-info text-dark mt-2">BBOX WFS Parametresi (EPSG:4326):</span>
                <code style="font-size:0.75rem; color:#0c5460; background-color: #d1ecf1; display:block; padding: 8px; border-radius: 4px; overflow-x: auto;">bbox=${currentBbox},EPSG:4326</code>
                <button class="btn btn-sm btn-outline-warning mt-2" onclick="navigator.clipboard.writeText('bbox=${currentBbox},EPSG:4326'); logToConsole('INFO', 'WFS BBOX Parametresini Kopyala');">WFS BBOX Parametresini Kopyala</button>
            `;
        logToConsole('INFO', 'WKT/BBOX modalı açıldı. Detaylar görüntülendi.');
    }

    function calculateAndShowBBOX() {
        updateWKTModalContent();
        var wktModal = new bootstrap.Modal(document.getElementById('wktBboxModal'));
        wktModal.show();
    }

    // Leaflet Kontrolleri (WKT, BBOX, Coordinate) aynı kalıyor.

    L.Control.WKTButton = L.Control.extend({ options: { position: 'topright' }, onAdd: function(map) { var container = L.DomUtil.create('div', 'leaflet-bar leaflet-control leaflet-control-wkt-button'); var link = L.DomUtil.create('a', '', container); link.href = '#'; link.title = 'Çizilen Geometrinin WKT\'sini Görüntüle'; link.innerHTML = 'WKT'; L.DomEvent.on(link, 'click', L.DomEvent.stop).on(link, 'click', calculateAndShowBBOX); return container; } });
    L.Control.BBOXButton = L.Control.extend({ options: { position: 'topright' }, onAdd: function(map) { var container = L.DomUtil.create('div', 'leaflet-bar leaflet-control leaflet-control-bbox-button'); var link = L.DomUtil.create('a', '', container); link.href = '#'; link.title = 'Çizilen Geometrinin BBOX\'unu Görüntüle'; link.innerHTML = 'BBOX'; L.DomEvent.on(link, 'click', L.DomEvent.stop).on(link, 'click', calculateAndShowBBOX); return container; } });
    L.Control.CoordinateInfo = L.Control.extend({ options: { position: 'bottomleft' }, onAdd: function (map) { this._container = L.DomUtil.create('div', 'leaflet-control-coordinate-info'); this._update(); map.on('mousemove', this._onMouseMove, this); map.on('zoomend', this._onZoomEnd, this); return this._container; }, onRemove: function (map) { map.off('mousemove', this._onMouseMove, this); map.off('zoomend', this._onZoomEnd, this); }, _onMouseMove: function (e) { this._currentLatLng = e.latlng; this._update(); }, _onZoomEnd: function (e) { this._update(); }, _update: function () { const zoomLevel = this._map.getZoom(); let lat = this._currentLatLng ? this._currentLatLng.lat.toFixed(5) : '---'; let lng = this._currentLatLng ? this._currentLatLng.lng.toFixed(5) : '---'; this._container.innerHTML = `Zoom: <strong>${zoomLevel}</strong> | Lat: <strong>${lat}°</strong> | Lng: <strong>${lng}°</strong>`; } });

    map.addControl(new L.Control.WKTButton());
    map.addControl(new L.Control.BBOXButton());
    map.addControl(new L.Control.CoordinateInfo());

    // -----------------------------------------------------------
    // 1.2. HARİTA ODAKLAMA FONKSİYONU
    // -----------------------------------------------------------
    function centerMapToTKGMDefault() {
        const selectedUrl = document.getElementById('wfsUrlSelect').value;
        const TKGM_URL_PARTIAL = 'tkgm.ows/wfs';

        if (selectedUrl.includes(TKGM_URL_PARTIAL)) {
            // Amasya Merkez Koordinatları (Lat, Lng) ve Zoom 15
            const AMASYA_LAT = 40.655;
            const AMASYA_LNG = 35.836;
            const DEFAULT_ZOOM = 15;

            map.setView([AMASYA_LAT, AMASYA_LNG], DEFAULT_ZOOM);
            logToConsole('INFO', `TKGM URL seçildi. Harita otomatik olarak Amasya'ya (${AMASYA_LAT}, ${AMASYA_LNG}) Zoom ${DEFAULT_ZOOM} seviyesinde odaklandı.`);
        } else {
            // Başka bir URL seçilirse Türkiye genel görünümüne dön
            map.setView([39.92, 32.85], 6);
            logToConsole('INFO', `URL TKGM değil/Özel URL. Harita Türkiye genel görünümüne odaklandı.`);
        }
    }


    // -----------------------------------------------------------
    // 2. KATMANLAR & UI MANTIĞI (Özel URL Algılama Eklendi)
    // -----------------------------------------------------------

    const LAYERS_TKGM = [
        "TKGM:iller", "TKGM:ilceler", "TKGM:mahalleler", "TKGM:parseller_adalar",
        "TKGM:parseller", "TKGM:yapilar", "TKGM:pafta", "TKGM:irtifakhaklari",
        "TKGM:muhdesatlar", "TKGM:eklentiler", "TKGM:kulturvarliklarialan",
        "TKGM:pasif_parseller", "TKGM:planyuzbin_hazineparsel_view",
        "TKGM:planyuzbinview", "TKGM:tescilharicialanlar", "TKGM:yerkontrolnoktalari",
        "TKGM3D:bp_project_2d_v", "TKGM3D:bp_project_administrative_area_parsel_v",
        "TKGM3D:building_photogrametric_footprint_v", "TKGM3D:building_photogrametric_has_architecturel_v"
    ];

    // Geçici olarak özel URL'den alınan katmanları tutar.
    let CUSTOM_LAYERS = [];

    function populateLayerList(layers, defaultLayerName) {
        const listContainer = document.getElementById('availableLayersList');
        listContainer.innerHTML = "";

        document.getElementById('layerCount').innerText = layers.length;

        layers.forEach(l => {
            const item = document.createElement('a');
            item.className = 'list-group-item list-group-item-action py-1 text-truncate';
            item.innerText = l;
            item.onclick = () => {
                document.getElementById('selectedLayer').value = l;
                document.getElementById('typeNameInput').value = l;
                document.querySelectorAll('#availableLayersList .list-group-item').forEach(x => x.classList.remove('active'));
                item.classList.add('active');
                updateUrlPreview();
                logToConsole('INFO', `Katman seçildi: ${l}`);
            };
            listContainer.appendChild(item);
        });

        // Varsayılan katmanı seç
        let defaultItem = Array.from(listContainer.children).find(item => item.innerText === defaultLayerName);

        if (!defaultItem && layers.length > 0) {
            defaultItem = listContainer.firstChild;
            defaultLayerName = defaultItem.innerText;
            logToConsole('WARNING', `Varsayılan katman (${defaultLayerName}) bulunamadı, ilk katman seçildi.`);
        }

        if (defaultItem) {
            defaultItem.classList.add('active');
            document.getElementById('selectedLayer').value = defaultLayerName;
            document.getElementById('typeNameInput').value = defaultLayerName;
        } else {
            document.getElementById('selectedLayer').value = '';
            document.getElementById('typeNameInput').value = 'Katman Yok';
        }

        // updateUrlPreview(); // KALDIRILDI: Tekrarlı çağrıyı engellemek için buradan kaldırıldı.

    }

    // GÜNCELLENDİ: loadLayers mantığı
    function loadLayers(isUrlChange = false) {
        const wfsUrlSelect = document.getElementById('wfsUrlSelect');
        const selectedUrlOption = wfsUrlSelect.value;
        const customUrlGroup = document.getElementById('customUrlGroup');

        // Önce custom URL grubunu gizle
        customUrlGroup.style.display = 'none';

        // 'custom_url' seçeneğinin güncel değerini al
        const customOption = wfsUrlSelect.querySelector('option[value="custom_url"]');
        const customOptionValue = customOption ? customOption.value : '';


        // Eğer seçilen değer 'custom_url' ise (yani kullanıcı listeden "Özel URL" seçeneğini seçtiyse)
        if (selectedUrlOption === 'custom_url') {
            customUrlGroup.style.display = 'flex';
            // Arayüzü temizle ve kullanıcının URL girmesini iste
            document.getElementById('availableLayersList').innerHTML = '<div class="list-group-item text-danger">⚠️ Lütfen URL girip Algıla\'ya basın.</div>';
            document.getElementById('layerCount').innerText = '0';
            document.getElementById('selectedLayer').value = '';
            document.getElementById('typeNameInput').value = '';

            // Eğer seçilen değer TKGM ise
        } else if (selectedUrlOption.includes('tkgm')) {
            populateLayerList(LAYERS_TKGM, "TKGM:mahalleler");

            // Eğer seçilen değer başarılı bir şekilde algılanmış özel URL ise (URL değişimi sonrasında)
        } else if (selectedUrlOption === customOptionValue && CUSTOM_LAYERS.length > 0) {
            // Özel URL listesini yeniden yükle
            populateLayerList(CUSTOM_LAYERS, document.getElementById('selectedLayer').value || CUSTOM_LAYERS[0]);

            // Durum 4: Diğer tüm harici WFS'ler seçili
        } else {
            // Harici URL'ler için layer listesini temizle ve kullanıcıyı Algıla'ya yönlendir.
            document.getElementById('availableLayersList').innerHTML = '<div class="list-group-item text-warning">❗ Bu sunucunun katmanları otomatik yüklenmedi. Lütfen "Algıla" butonunu kullanın.</div>';
            document.getElementById('layerCount').innerText = '0';
            document.getElementById('selectedLayer').value = '';
            document.getElementById('typeNameInput').value = 'Katman Adını Girin/Algılayın';
        }

        updateOperationParams(true); // updateUrlPreview'ı atla
        if (isUrlChange) centerMapToTKGMDefault();
    }

    // GÜNCELLENDİ: detectAndLoadLayers mantığı (buildProxyUrl kaldırıldı)
    async function detectAndLoadLayers() {
        const rawUrl = document.getElementById('customWfsUrlInput').value.trim();
        const cleanedUrl = rawUrl.replace(/(\?.*)?$/, ''); // Parametreleri temizle

        if (!cleanedUrl || !cleanedUrl.toLowerCase().includes('wfs')) {
            logToConsole('ERROR', 'Geçerli bir WFS URL\'si girin.');
            alert('Geçerli bir WFS URL\'si girin.');
            return;
        }

        const capabilitiesUrl = `${cleanedUrl}?service=WFS&version=1.1.2&request=GetCapabilities`;
        // const proxyUrl = buildProxyUrl(capabilitiesUrl); // Proxy kaldırıldı

        logToConsole('INFO', `WFS Capabilities alınıyor: ${cleanedUrl}`);
        document.getElementById('loading-indicator').style.display = 'block';

        try {
            // Doğrudan hedef URL kullanılıyor
            const res = await fetch(capabilitiesUrl);
            const xmlText = await res.text();

            if (!res.ok) {
                logToConsole('ERROR', `Capabilities isteği başarısız oldu (HTTP ${res.status}). Yanıtı kontrol edin.`);
                // CORS hatası nedeniyle fetch başarısız olursa bu blok çalışmayabilir.
                throw new Error(`Capabilities isteği başarısız: HTTP ${res.status}`);
            }

            // XML'i ayrıştır
            const parser = new DOMParser();
            const xmlDoc = parser.parseFromString(xmlText, "text/xml");

            // Hata kontrolü: ServiceException var mı?
            const exception = xmlDoc.getElementsByTagName('ServiceException');
            if (exception.length > 0) {
                const exceptionMessage = exception[0].textContent || 'Bilinmeyen WFS Servis Hatası';
                logToConsole('ERROR', `WFS Hata Raporu: ${exceptionMessage}`);
                throw new Error(`WFS Servis Hatası: ${exceptionMessage}`);
            }

            // FeatureTypeList/FeatureType elementlerini bul
            const featureTypes = xmlDoc.getElementsByTagNameNS('*', 'FeatureType');
            CUSTOM_LAYERS = [];
            let defaultLayer = null;

            for (let i = 0; i < featureTypes.length; i++) {
                const nameElement = featureTypes[i].getElementsByTagNameNS('*', 'Name')[0];
                if (nameElement && nameElement.textContent) {
                    CUSTOM_LAYERS.push(nameElement.textContent);
                    if (!defaultLayer) defaultLayer = nameElement.textContent; // İlkini varsayılan yap
                }
            }

            if (CUSTOM_LAYERS.length > 0) {

                // --- URL'yi Kalıcı Olarak Güncelle ve Seçili Yap ---
                const wfsUrlSelect = document.getElementById('wfsUrlSelect');
                let customOption = wfsUrlSelect.querySelector('option[value="custom_url"]');

                // "custom_url" opsiyonunu yeni değer ve metinle güncelle
                customOption.value = cleanedUrl;
                customOption.text = `🔗 Özel URL: ${cleanedUrl.substring(0, 30)}${cleanedUrl.length > 30 ? '...' : ''}`;

                wfsUrlSelect.value = cleanedUrl; // Selectbox'ı yeni URL'ye ayarla
                // ----------------------------------------------------

                // Katman listesini yükle ve UI'yı güncelle
                populateLayerList(CUSTOM_LAYERS, defaultLayer);

                document.getElementById('customUrlGroup').style.display = 'none';

                logToConsole('SUCCESS', `${CUSTOM_LAYERS.length} adet katman başarıyla algılandı ve yüklendi. URL: ${cleanedUrl}`);

                updateOperationParams(); // Yeni URL ve katmanlarla tüm paramleri ve URL preview'i güncelle

            } else {
                logToConsole('WARNING', 'Capabilities belgesinde FeatureType bulunamadı.');
                alert('Bu servisten hiçbir katman (FeatureType) bilgisi alınamadı. Konsolu kontrol edin.');
                populateLayerList([], '');
                // Başarısız olsa bile, customUrlGroup'u tekrar göstermeliyiz
                document.getElementById('customUrlGroup').style.display = 'flex';
            }


        } catch (e) {
            logToConsole('ERROR', `URL algılama ve yükleme hatası: ${e.message}. CORS hatası olabileceğini unutmayın.`);
            alert('URL algılama hatası oluştu. Konsolu kontrol edin. CORS/URL hatası olabilir.');
            populateLayerList([], '');
        } finally {
            document.getElementById('loading-indicator').style.display = 'none';
        }
    }


    function updateOperationParams(skipPreview = false) {
        const operation = document.getElementById('wfsOperationSelect').value;
        const typeSelectionGroup = document.getElementById('typeSelectionGroup');
        const getFeatureParams = document.getElementById('getFeatureParams');

        // Birleştirilmiş sekme içeriği (#download-section kısmı)
        const downloadSection = document.getElementById('download-section');

        if (operation === 'GetCapabilities') {
            typeSelectionGroup.style.display = 'none';
        } else {
            typeSelectionGroup.style.display = 'block';
        }

        if (operation === 'GetFeature') {
            getFeatureParams.style.display = 'block';
            // Yeni yapıda download-section-container kontrolü daha uygun
            const downloadContainer = document.getElementById('download-section-container');
            if (downloadContainer) downloadContainer.style.display = 'flex';
        } else {
            getFeatureParams.style.display = 'none';
            const downloadContainer = document.getElementById('download-section-container');
            if (downloadContainer) downloadContainer.style.display = 'none';
        }

        // Buradaki çağrı sadece kullanıcı bir şeyi değiştirdiğinde (skipPreview false ise) çalışır.
        if (!skipPreview) {
            updateUrlPreview();
        }
    }


    // -----------------------------------------------------------
    // 3. URL VE PROXY MANTIĞI (GÜNCELLENDİ)
    // -----------------------------------------------------------

    function buildRequestUrl(formatOverride) {
        const operation = document.getElementById('wfsOperationSelect').value;
        const baseUrl = document.getElementById('wfsUrlSelect').value;
        const typeName = document.getElementById('selectedLayer').value;
        const maxFeatures = document.getElementById('maxFeatures').value;

        // WFS Versiyonunu ayarla
        let version = (operation === 'DescribeFeatureType') ? '1.0.0' : '1.1.2';

        // TKGM WFS'in genellikle 1.1.0'ı desteklediği varsayılır, ancak
        // kullanıcıdan gelen örnekte 1.1.2 kullanılmış. Biz 1.1.0'ı varsayalım 
        // veya GetFeature için 1.1.2 tutalım.
        if (operation === 'GetFeature' && baseUrl.includes('tkgm')) {
            // Eğer TKGM ise ve GetFeature ise 1.1.0'ı tutalım (daha yaygın).
            version = '1.1.2';
        }

        // outputFormat ayarı
        let format = formatOverride || document.getElementById('downloadFormat').value;

        // Ana URL yapısı
        let url = `${baseUrl}?service=WFS&version=${version}&request=${operation}`;

        if (operation === 'DescribeFeatureType' || operation === 'GetFeature') {
            url += `&typeName=${typeName}`;
        }

        if (operation === 'GetFeature') {
            url += `&maxFeatures=${maxFeatures}&srsName=EPSG:4326`;
            url += `&outputFormat=${encodeURIComponent(format)}`;

            const cqlInput = document.getElementById('cqlInput').value;
            const spatialMode = document.querySelector('input[name="spatialMode"]:checked').value;
            let cqlFilters = [];

            // 1. Kullanıcıdan gelen öznitelik filtresini ekle
            if (cqlInput.trim() !== "") {
                cqlFilters.push(`(${cqlInput})`);
            }

            // 2. Mekansal filtreyi (INTERSECTS veya BBOX) ekle
            if (currentWkt) {
                if (spatialMode === 'INTERSECTS') {
                    // *** ÖNEMLİ DÜZELTME: INTERSECTS için WKT ifadesi tek tırnak ('') içine alınmıştır.
                    // GeoServer/TKGM WFS'in default geometri adı 'geom'dur.
                    cqlFilters.push(`INTERSECTS(geom, '${currentWkt}')`); // <-- DÜZELTME BURADA
                } else if (spatialMode === 'BBOX' && currentBbox) {
                    // BBOX için ayrı bir parametre kullan, bu cql_filter'a girmez
                    url += `&bbox=${currentBbox},EPSG:4326`;
                }
            }

            // 3. Tüm filtreleri (öznitelik + mekansal INTERSECTS) 'AND' ile birleştir ve URL'ye ekle
            if (cqlFilters.length > 0) {
                // Burada cqlFilters.join(" AND ") tam olarak kullanıcının istediği yapıyı oluşturur.
                // Örn: (durum=3) AND INTERSECTS(geom, POLYGON (...))
                url += `&cql_filter=${encodeURIComponent(cqlFilters.join(" AND "))}`;
            }
        } else {
            url += `&outputFormat=${encodeURIComponent(format)}`;
        }

        return url;
    }

    // -----------------------------------------------------------
    // 3.1. IFRAME & HARİCİ İŞLEMLER (Proxy'siz)
    // -----------------------------------------------------------

    function getIframeFormatName(formatValue) {
        const options = Array.from(document.getElementById('downloadFormat').options);
        const selectedOption = options.find(opt => opt.value === formatValue);
        return selectedOption ? selectedOption.text : formatValue;
    }

    function loadIframeContent() {
        const targetFormat = document.getElementById('downloadFormat').value;
        const url = buildRequestUrl(targetFormat);
        const decodedUrl = decodeURIComponent(url);

        const iframe = document.getElementById('liveResultFrameInTab');
        const formatName = getIframeFormatName(targetFormat);

        document.getElementById('iframeFormatBadge').innerText = formatName;

        if (iframe) {
            // Doğrudan hedef URL kullanılıyor
            iframe.src = decodedUrl;
            logToConsole('INFO', `iFrame yükleniyor: ${formatName} formatında WFS isteği gönderildi. (CORS hatası alabilir)`);
        }
    }

    function openExternalUrl() {
        const targetFormat = document.getElementById('downloadFormat').value;
        let externalUrl = buildRequestUrl(targetFormat);
        logToConsole('INFO', `Harici URL açılıyor: ${getIframeFormatName(targetFormat)} formatında.`);
        // Doğrudan hedef URL kullanılıyor
        window.open(decodeURIComponent(externalUrl), '_blank');
    }

    // buildProxyUrl fonksiyonu kaldırıldı.
    // function buildProxyUrl(targetUrl) {
    //     return 'https://corsproxy.io/?' + encodeURIComponent(targetUrl);
    // }

    function updateUrlPreview() {
        const previewUrl = buildRequestUrl('application/json');
        document.getElementById('urlDisplay').textContent = decodeURIComponent(previewUrl);

        const downloadFormat = document.getElementById('downloadFormat').value;
        const downloadUrl = buildRequestUrl(downloadFormat);
        document.getElementById('downloadUrlDisplay').textContent = decodeURIComponent(downloadUrl);

        document.getElementById('iframeFormatBadge').innerText = getIframeFormatName(downloadFormat);

        if (document.getElementById('download-iframe-tab').classList.contains('active')) {
            loadIframeContent();
        }

        hljs.highlightAll();
        logToConsole('INFO', 'Request URL ve İndirme Bilgisi güncellendi.');
    }

    // -----------------------------------------------------------
    // 4. RESPONSE YÖNETİMİ (Aynı kalıyor)
    // -----------------------------------------------------------

    function formatXml(xml) {
        if (!xml) return '';
        var formatted = '';
        var reg = /(>)(<)(\/*)/g;
        xml = xml.replace(reg, '$1\r\n$2$3');
        var pad = 0;
        xml.split('\r\n').forEach(function (node) {
            var indent = 0;
            if (node.match(/.+<\/\w[^>]*>$/)) {
                indent = 0;
            } else if (node.match(/^<\/\w/)) {
                if (pad != 0) pad -= 1;
            } else if (node.match(/^<\w[^>]*[^\/]>.*$/)) {
                indent = 1;
            } else {
                indent = 0;
            }
            var padding = '';
            for (var i = 0; i < pad; i++) padding += '  ';
            formatted += padding + node + '\r\n';
            pad += indent;
        });
        return formatted;
    }

    function displayResponse(data, status, contentType, duration) {
        const output = document.getElementById('responseOutput');
        const badge = document.getElementById('responseStatusBadge');
        const timeBadge = document.getElementById('responseTimeBadge');

        badge.innerText = `HTTP ${status}`;
        badge.className = status >= 200 && status < 300 ? "badge bg-success" : "badge bg-danger";

        timeBadge.innerText = `${duration}ms`;
        timeBadge.style.display = 'inline-block';

        let formattedContent = "";
        let languageClass = "language-json";

        if (typeof data === 'object') {
            formattedContent = JSON.stringify(data, null, 2);
            languageClass = "language-json";
        } else if (typeof data === 'string' && data.trim().startsWith('<')) {
            // XML olarak varsay
            formattedContent = formatXml(data);
            languageClass = "language-xml";
        } else if (contentType && contentType.includes('xml')) {
            formattedContent = data;
            languageClass = "language-xml";
        } else {
            formattedContent = data || 'Yanıt içeriği boş.';
            languageClass = "language-plaintext";
        }

        output.className = languageClass;
        output.textContent = formattedContent;

        if (window.hljs) {
            hljs.highlightElement(output);
        }
    }

    function copyResponse() {
        const text = document.getElementById('responseOutput').textContent;
        navigator.clipboard.writeText(text).then(() => {
            alert("Yanıt panoya kopyalandı!");
            logToConsole('INFO', 'Sunucu yanıtı panoya kopyalandı.');
        });
    }

    function toggleWrap() {
        const codeBlock = document.getElementById('responseOutput');
        const isWrapped = codeBlock.style.whiteSpace === 'pre-wrap';
        codeBlock.style.whiteSpace = isWrapped ? 'pre' : 'pre-wrap';
        logToConsole('INFO', `Satır kaydırma: ${isWrapped ? 'Kapatıldı' : 'Açıldı'}.`);
    }


    // -----------------------------------------------------------
    // 5. İŞLEMLER (ÖNİZLEME VE İNDİRME) (Proxy'siz)
    // -----------------------------------------------------------

    async function previewData() {
        const operation = document.getElementById('wfsOperationSelect').value;
        const isGetFeature = operation === 'GetFeature';
        const typeName = document.getElementById('selectedLayer').value;

        // **EKLENEN KONTROL**
        if (!isGetFeature) {
            alert("Haritada önizleme (Fetch) sadece 'GetFeature' işlemi için geçerlidir.");
            logToConsole('WARNING', "Harita önizlemesi sadece 'GetFeature' işlemi için denendi.");
            return;
        }
        // **MEVCUT KONTROL**
        if (!typeName) {
            alert("Lütfen bir Katman Adı seçin veya Algıla butonu ile yükleyin.");
            logToConsole('ERROR', "Katman Adı seçilmedi.");
            return;
        }

        let targetFormat = 'application/json'; // GeoJSON almak için sabitlendi
        const targetUrl = buildRequestUrl(targetFormat);

        logToConsole('INFO', `Önizleme başlatılıyor (${operation}). Hedef URL: ${targetUrl.substring(0, 80)}...`);

        document.getElementById('loading-indicator').style.display = 'block';
        const startTime = performance.now();
        if (previewLayer) map.removeLayer(previewLayer); // Önceki katmanı temizle

        try {
            // Doğrudan hedef URL kullanılıyor
            const res = await fetch(targetUrl);
            const clone = res.clone();

            let dataToDisplay;
            let mapData = null;
            let contentType = res.headers.get("content-type");
            let responseStatus = res.status;

            try {
                if (contentType && contentType.includes('json')) {
                    dataToDisplay = await res.json();
                    mapData = dataToDisplay;
                } else {
                    dataToDisplay = await res.text();
                }
            } catch (e) {
                // Eğer json parse edilemezse, text olarak dene
                dataToDisplay = await clone.text();
                contentType = res.headers.get("content-type") || 'text/plain';
            }

            const endTime = performance.now();
            const duration = (endTime - startTime).toFixed(0);

            // Yanıt sekmesini göster
            new bootstrap.Tab(document.getElementById('response-tab')).show();
            displayResponse(dataToDisplay, responseStatus, contentType, duration);
            logToConsole('SUCCESS', `İstek başarıyla tamamlandı. (HTTP ${responseStatus}, Süre: ${duration}ms)`);

            if (!res.ok) {
                logToConsole('ERROR', `Sunucu Hatası: ${responseStatus}. Yanıt sekmesini kontrol edin.`);
                // 4xx/5xx hatası varsa throw
                throw new Error(`WFS Sunucu Hatası (HTTP: ${responseStatus}): Yanıt içeriğini kontrol edin.`);
            }

            // GetFeature işlemi için haritalama. isGetFeature kontrolü zaten yukarıda yapıldığı için burada sadece mapData kontrolü yeterlidir.
            if (mapData && mapData.type === 'FeatureCollection') {
                previewLayer = L.geoJSON(mapData, {
                    style: { color: "#3388ff", weight: 2 },
                    onEachFeature: (f, l) => {
                        let popup = "<div style='max-height:200px; overflow:auto'><table class='table table-xs'>";
                        for (let key in f.properties) {
                            popup += `<tr><td><strong>${key}</strong></td><td>${f.properties[key]}</td></tr>`;
                        }
                        popup += "</table></div>";
                        l.bindPopup(popup);
                    }
                }).addTo(map);

                if (mapData.features && mapData.features.length > 0) {
                    map.fitBounds(previewLayer.getBounds());
                    logToConsole('SUCCESS', `${mapData.features.length} adet geometri haritaya yüklendi.`);
                } else {
                    logToConsole('WARNING', "Kriterlere uygun veri bulunamadı.");
                    alert("Kriterlere uygun veri bulunamadı.");
                }
            } else {
                // Hata raporları veya GeoJSON olmayan yanıtlar
                logToConsole('WARNING', `GetFeature tamamlandı, ancak haritalanamadı. Yanıt türü: ${contentType}.`);
                alert(`İşlem Başarılı, ancak haritada görüntülenecek FeatureCollection verisi gelmedi. Yanıt sekmesini inceleyin.`);
            }

        } catch (e) {
            logToConsole('ERROR', `FETCH HATA: İşlem sırasında beklenmedik hata oluştu. Detay: ${e.message}. (Olası CORS hatası)`);
            document.getElementById('responseOutput').textContent = "FETCH ERROR: " + e.message + ". Bu, CORS (Cross-Origin Resource Sharing) hatası nedeniyle olabilir.";
            alert("İşlem sırasında beklenmedik hata oluştu. Detaylar için konsolu kontrol edin. (Büyük olasılıkla CORS Hatası)");
        } finally {
            document.getElementById('loading-indicator').style.display = 'none';
        }
    }

    async function downloadData() {
        const operation = document.getElementById('wfsOperationSelect').value;
        const typeName = document.getElementById('selectedLayer').value;

        if (operation !== 'GetFeature') {
            alert("Sadece 'GetFeature' işlemi için indirme yapılabilir.");
            logToConsole('WARNING', "Sadece 'GetFeature' işlemi için indirme yapılabilir.");
            return;
        }

        if (!typeName) {
            alert("Lütfen indirilecek bir Katman Adı seçin.");
            logToConsole('ERROR', "Katman Adı seçilmedi.");
            return;
        }

        const format = document.getElementById('downloadFormat').value;
        const targetUrl = buildRequestUrl(format);
        // const proxyUrl = buildProxyUrl(targetUrl); // Proxy kaldırıldı

        logToConsole('INFO', `İndirme başlatılıyor (${getIframeFormatName(format)} formatında).`);

        const layerName = document.getElementById('selectedLayer').value.split(':')[1];
        let extension = "dat";
        if (format.includes("json")) extension = "json";
        else if (format.includes("xml") || format.includes("gml")) extension = "xml";
        else if (format.includes("kml")) extension = "kml";
        else if (format.includes("zip") || format.includes("SHAPE-ZIP")) extension = "zip";
        else if (format.includes("csv")) extension = "csv";

        const filename = `${layerName}_export.${extension}`;

        document.getElementById('loading-indicator').style.display = 'block';

        try {
            // Doğrudan hedef URL kullanılıyor
            const response = await fetch(targetUrl);
            const responseStatus = response.status;

            if (!response.ok) {
                const errorText = await response.text();
                logToConsole('ERROR', `İndirme Hatası (HTTP ${responseStatus}): ${errorText.substring(0, 50)}...`);
                throw new Error(`İndirme Hatası (HTTP: ${responseStatus}): Sunucu Hata Raporu`);
            }

            const blob = await response.blob();
            const downloadUrl = window.URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = downloadUrl;
            a.download = filename;
            document.body.appendChild(a);
            a.click();

            logToConsole('SUCCESS', `Dosya başarıyla indirildi: ${filename}`);

            window.URL.revokeObjectURL(downloadUrl);
            document.body.removeChild(a);

        } catch (e) {
            logToConsole('ERROR', `İndirme sırasında hata oluştu. Hata: ${e.message}. (Olası CORS hatası)`);
            alert("İndirme sırasında hata oluştu. Detaylar için konsolu kontrol edin. Hata: " + e.message);
        } finally {
            document.getElementById('loading-indicator').style.display = 'none';
        }
    }

    // Input/Select Değişikliklerini Dinle
    document.getElementById('cqlInput').addEventListener('input', updateUrlPreview);
    document.getElementById('downloadFormat').addEventListener('change', updateUrlPreview);
    document.getElementById('maxFeatures').addEventListener('change', updateUrlPreview);
    document.querySelectorAll('input[name="spatialMode"]').forEach(r => r.addEventListener('change', updateUrlPreview));

    // WFS URL değiştiğinde hem katmanları yükle hem de haritayı odakla.
    document.getElementById('wfsUrlSelect').addEventListener('change', () => loadLayers(true));

    // Yeni birleştirilmiş sekmeye tıklandığında içeriğin yüklenmesini sağla
    document.getElementById('download-iframe-tab').addEventListener('click', loadIframeContent);


    // Sayfa yüklendiğinde başlat
    window.onload = function() {
        logToConsole('INFO', 'WFS Eğitim Portalı başlatıldı. CORS Proxy kaldırılmıştır.');

        // Çağrı 1: loadLayers, kendi içinde updateOperationParams(true) çağırır.
        loadLayers(false);

        // updateOperationParams(true) çağrıldığından, updateUrlPreview atlanmıştır.

        // Çağrı 2: Son ve tek geçerli çağrı.
        updateUrlPreview();
    };

</script>
