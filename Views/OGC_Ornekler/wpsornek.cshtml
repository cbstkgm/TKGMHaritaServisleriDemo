@{
Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OGC WPS Eğitim ve Web İşleme Servisi Portalı</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f4f7f6; color: #333; }
        .navbar { background: linear-gradient(135deg, #d35400 0%, #e67e22 100%); }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 15px rgba(0,0,0,0.05); margin-bottom: 20px; }
        .card-header { background-color: #fff; border-bottom: 1px solid #eee; font-weight: 600; color: #d35400; }
        .code-block { background-color: #2d2d2d; color: #e74c3c; padding: 15px; border-radius: 8px; font-family: 'Consolas', monospace; font-size: 0.85rem; overflow-x: auto; white-space: pre-wrap; height: 300px; }
        .param-badge { background-color: #fcefe3; color: #d35400; padding: 4px 8px; border-radius: 4px; font-family: monospace; font-weight: bold; }
        
        #loading-indicator { display: none; text-align: center; padding: 10px; }
        .process-info { background-color: #fff3e0; border-left: 5px solid #ff9800; padding: 10px; border-radius: 4px; margin-top: 15px; }
        .map-container { height: 400px; width: 100%; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); border: 2px solid #e0e0e0; z-index: 1; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="#">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-cpu me-2" viewBox="0 0 16 16">
                <path d="M5 2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 .5.5v2H5zM15 5.5a.5.5 0 0 1 .5.5v5a.5.5 0 0 1-.5.5h-2V11H13V5.5zm-5 7a.5.5 0 0 1 .5.5h5a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.5.5h-5a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 1 .5-.5zM1 2a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1zm0 2V2h14v2zm0 10v-2h14v2z"/>
            </svg>
            OGC WPS (Web İşleme) Portalı
        </a>
    </div>
</nav>

<div class="container">
    <div class="row">
        <div class="col-lg-4">

            <div class="card">
                <div class="card-header">
                    📚 WPS Nedir? (Web Processing Service)
                </div>
                <div class="card-body">
                    <p class="small text-muted">WPS, coğrafi analiz algoritmalarını (Buffer, Kesme, Rota vb.) bir web servisi üzerinden çalıştırmayı sağlar. **Veriyi değil, analizin sonucunu** döndürür.</p>
                    <hr />
                    <h6>Temel Parametreler:</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-1"><span class="param-badge">SERVICE</span>: WPS</li>
                        <li class="mb-1"><span class="param-badge">REQUEST</span>: Execute (İşlemi Çalıştır)</li>
                        <li class="mb-1"><span class="param-badge">IDENTIFIER</span>: Çalıştırılacak İşlem Adı (Örn: `gs:Buffer`)</li>
                        <li class="mb-1"><span class="param-badge">DATAINPUTS</span>: Giriş parametreleri (Veri, Mesafe vb.)</li>
                        <li class="mb-1"><span class="param-badge">RESPONSE</span>: asynch/synch (Asenkron/Senkron)</li>
                    </ul>
                </div>
            </div>
            
            <div class="card bg-light">
                <div class="card-header">
                    ⚙️ WPS Servis Ayarları & İşlem Seçimi
                </div>
                <div class="card-body">
                    <form id="wpsForm">
                        <div class="mb-3">
                            <label for="wpsUrlSelect" class="form-label fw-bold">WPS Servis URL (Açık Kaynak Örnekler)</label>
                            <select class="form-select" id="wpsUrlSelect">
                                <option value="https://geoserver.gisc.gmu.edu/geoserver/wps">GMU GeoServer (WPS 1.0.0)</option>
                                <option value="https://geoserver.gischat.org/geoserver/wps">GisChat GeoServer (WPS 1.0.0)</option>
                                <option value="https://geoserver.sdi4apps.eu/wps/WebProcessingService">SDI4Apps (WPS 1.0.0)</option>
                                <option value="http://geoserver.org/wps">GeoServer Official Demo (WPS 1.0.0)</option>
                                <option value="https://wps.eox.at/wps">EOX WPS (Raster İşlemler)</option>
                                <option value="https://server.arcgisonline.com/arcgis/services/Elevation/WPS/WPServer/WMSServer">ArcGIS Online (Yükseklik)</option>
                                <option value="https://geoserver.mapgears.com/geoserver/wps">Mapgears GeoServer</option>
                                <option value="http://publicus.geoserver.org/wps">Publicus GeoServer</option>
                                <option value="https://geoserver.ec-gis.org/geoserver/wps">EC-GIS GeoServer</option>
                                <option value="https://wps.opengeospatial.org/wps/WebProcessingService">OGC Testbed (Genellikle kapalı)</option>
                            </select>
                            <input type="text" class="form-control mt-2" id="wpsUrlInput" value="https://geoserver.gisc.gmu.edu/geoserver/wps" readonly>
                        </div>
                        
                        <div class="mb-3">
                            <label for="processId" class="form-label fw-bold">Çalıştırılacak İşlem ID'si (Identifier)</label>
                            <input type="text" class="form-control" id="processId" value="gs:Buffer">
                            <div class="form-text small">Örn: `gs:Buffer` (Tampon Bölge), `jts:convexHull` vb.</div>
                            <button type="button" class="btn btn-sm btn-outline-info mt-2" onclick="describeProcess()">
                                DescribeProcess (Parametreleri Gör)
                            </button>
                        </div>
                        
                        <hr/>
                        <h6>Process Giriş Ayarları (Örnek Buffer İçin):</h6>
                        <div class="mb-3">
                             <label for="bufferDistance" class="form-label fw-bold">Tampon Mesafe (Buffer Distance)</label>
                             <input type="number" class="form-control" id="bufferDistance" value="1000">
                             <div class="form-text small">Metre cinsinden tampon bölge mesafesi.</div>
                        </div>

                        <div class="mb-3">
                             <label for="wktInput" class="form-label fw-bold">Giriş Geometrisi (WKT)</label>
                             <input type="text" class="form-control" id="wktInput" value="POINT(-77.0369 38.9072)">
                             <div class="form-text small">WKT formatında geometrik nokta/çizgi. (Örn: Washington Anıtı)</div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-danger" onclick="executeProcess()">
                                ▶️ WPS İşlemini Çalıştır (Execute)
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>🗺️ İşlem Sonucu Harita Önizlemesi</span>
                    <span class="badge bg-warning text-dark" id="processStatus">Hazır</span>
                </div>
                <div class="card-body p-0 position-relative">
                    <div id="loading-indicator">
                        <div class="spinner-border text-primary" role="status"></div>
                        <div>İşlem Çalıştırılıyor...</div>
                    </div>
                    <div id="map" class="map-container"></div>
                </div>
                <div class="card-footer text-muted small">
                    Buffer sonucunun GeoJSON çıktısı, haritada kırmızı ile gösterilecektir.
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    💻 Oluşturulan WPS İsteği URL'i (Execute)
                </div>
                <div class="card-body bg-dark p-0">
                    <div class="code-block" id="requestCode">
                        İstek URL'i veya XML/JSON gövdesi burada gösterilecektir.
                    </div>
                </div>
            </div>
            
            <div class="card mt-4">
                <div class="card-header">
                    📝 Sonuç Girdisi (GeoJSON)
                </div>
                <div class="card-body">
                    <pre id="processResult" class="code-block" style="height: 150px; color:#27ae60;">İşlem sonucu GeoJSON burada gösterilecektir.</pre>
                </div>
            </div>
        </div>
    </div>
</div>

<footer class="text-center py-4 text-muted mt-5 border-top">
    <div class="container">
        <p class="mb-0">owsLab - WPS Web İşleme Servisi Entegrasyon Demosu</p>
    </div>
</footer>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/terraformer@1.0.9/terraformer.min.js"></script>
<script src="https://unpkg.com/terraformer-wkt-parser@1.0.5/terraformer-wkt-parser.min.js"></script>
<script>
    // ---------------------------------------------------------
    // 1. HARİTA BAŞLATMA
    // ---------------------------------------------------------
    var map = L.map('map').setView([38.9072, -77.0369], 10); 

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors',
        maxZoom: 18
    }).addTo(map);

    var resultLayer = null; 

    // ---------------------------------------------------------
    // 2. SERVİS SEÇİM MANTIĞI
    // ---------------------------------------------------------
    document.getElementById('wpsUrlSelect').addEventListener('change', function() {
        var selectedVal = this.value;
        document.getElementById('wpsUrlInput').value = selectedVal;
        document.getElementById('requestCode').innerText = "WPS Servis URL güncellendi. Process ID'sini kontrol edin.";
        document.getElementById('processStatus').innerText = "Hazır";
        // Haritayı Washington, DC çevresine odakla
        map.setView([38.9072, -77.0369], 10); 
    });
    
    // ---------------------------------------------------------
    // 3. DESCRIBEPROCESS İSTEĞİ (XML Çıktısı)
    // ---------------------------------------------------------
    function describeProcess() {
        const baseUrl = document.getElementById('wpsUrlInput').value;
        const processId = document.getElementById('processId').value;
        document.getElementById('loading-indicator').style.display = 'block';
        document.getElementById('processStatus').innerText = "Process Açıklaması İsteniyor...";

        const describeUrl = new URL(baseUrl);
        describeUrl.searchParams.append("service", "WPS");
        describeUrl.searchParams.append("version", "1.0.0");
        describeUrl.searchParams.append("request", "DescribeProcess");
        describeUrl.searchParams.append("identifier", processId);
        
        const finalUrl = decodeURIComponent(describeUrl.toString());
        document.getElementById('requestCode').innerText = finalUrl;

        // DescribeProcess her zaman XML döndürür, bu yüzden Fetch ile direkt XML gösterelim
        fetch(finalUrl)
            .then(response => response.text())
            .then(xmlText => {
                document.getElementById('requestCode').innerText = xmlText;
                document.getElementById('processStatus').innerText = "Process Tanımı Alındı (XML)";
                alert("Process'in girdi/çıktı parametrelerini 'WPS İsteği URL'i' bölümünde XML olarak görebilirsiniz.");
            })
            .catch(error => {
                document.getElementById('requestCode').innerText = `Hata: ${error.message}. URL: ${finalUrl}`;
                document.getElementById('processStatus').innerText = "Hata Oluştu";
            })
            .finally(() => {
                document.getElementById('loading-indicator').style.display = 'none';
            });
    }

    // ---------------------------------------------------------
    // 4. EXECUTE İSTEĞİ (Buffer Örneği)
    // ---------------------------------------------------------
    async function executeProcess() {
        const baseUrl = document.getElementById('wpsUrlInput').value;
        const processId = document.getElementById('processId').value;
        const bufferDistance = document.getElementById('bufferDistance').value;
        const wktInput = document.getElementById('wktInput').value;
        
        document.getElementById('loading-indicator').style.display = 'block';
        document.getElementById('processStatus').innerText = "İşlem Yürütülüyor...";
        document.getElementById('processResult').innerText = "Bekleniyor...";

        // GeoServer/WPS 1.0.0 için XML gövdesi oluşturma
        // POINT(-77.0369 38.9072) örneği
        const executeXml = `
<wps:Execute version="1.0.0" service="WPS" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.opengis.net/wps/1.0.0" xmlns:wfs="http://www.opengis.net/wfs" xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:gml="http://www.opengis.net/gml" xmlns:ogc="http://www.opengis.net/ogc" xmlns:wcs="http://www.opengis.net/wcs/1.1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 http://schemas.opengis.net/wps/1.0.0/wpsAll.xsd">
  <ows:Identifier>${processId}</ows:Identifier>
  <wps:DataInputs>
    <wps:Input>
      <ows:Identifier>feature</ows:Identifier>
      <wps:Data>
        <wps:ComplexData mimeType="application/wkt"><![CDATA[${wktInput}]]></wps:ComplexData>
      </wps:Data>
    </wps:Input>
    <wps:Input>
      <ows:Identifier>distance</ows:Identifier>
      <wps:Data>
        <wps:LiteralData>${bufferDistance}</wps:LiteralData>
      </wps:Data>
    </wps:Input>
  </wps:DataInputs>
  <wps:ResponseForm>
    <wps:ResponseDocument storeExecuteResponse="false" status="false">
      <wps:Output asReference="false">
        <ows:Identifier>result</ows:Identifier>
        <wps:MimeType>application/json</wps:MimeType>
      </wps:Output>
    </wps:ResponseDocument>
  </wps:ResponseForm>
</wps:Execute>`;

        document.getElementById('requestCode').innerText = executeXml; // XML Gövdesi

        try {
            const response = await fetch(baseUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/xml', // WPS, XML gövdesi bekler
                },
                body: executeXml,
            });

            if (!response.ok) {
                // Hata durumunda hata mesajını oku
                const errorText = await response.text();
                throw new Error(`WPS Hata: ${response.status}. Detay: ${errorText.substring(0, 100)}...`);
            }
            
            // Sonucu GeoJSON olarak bekliyoruz
            const resultJson = await response.json(); 
            
            // Sonucu gösterme
            document.getElementById('processResult').innerText = JSON.stringify(resultJson, null, 2);
            document.getElementById('processStatus').innerText = "İşlem Başarılı!";
            
            // Haritada çizme
            drawGeoJsonResult(resultJson, wktInput);


        } catch (error) {
            console.error(error);
            document.getElementById('processResult').innerText = "Hata Oluştu. Detaylar için konsola bakın. CORS hatası, sunucunun çalışmaması veya Process ID'sinin yanlış olması yaygındır.";
            document.getElementById('processStatus').innerText = "İşlem Başarısız";
        } finally {
            document.getElementById('loading-indicator').style.display = 'none';
        }
    }
    
    // ---------------------------------------------------------
    // 5. HARİTADA GÖSTERME
    // ---------------------------------------------------------
    function drawGeoJsonResult(geoJsonData, wktInput) {
        if (resultLayer) map.removeLayer(resultLayer);

        // WPS sonucunu çiz (Kırmızı tampon)
        resultLayer = L.geoJSON(geoJsonData, {
            style: { color: 'red', weight: 3, opacity: 0.8, fillOpacity: 0.2 }
        }).addTo(map);

        // Orijinal geometriyi çiz (Mavi nokta/çizgi)
        try {
            const terraformerGeoJson = Terraformer.WKT.parse(wktInput);
            L.geoJSON(terraformerGeoJson, {
                pointToLayer: function (feature, latlng) {
                    return L.circleMarker(latlng, {
                        radius: 5, fillOpacity: 1, color: 'blue', fillColor: 'blue'
                    });
                },
                style: { color: 'blue', weight: 5, opacity: 1 }
            }).addTo(map);

            map.fitBounds(resultLayer.getBounds());

        } catch (e) {
            console.warn("WKT girişi çizilemedi: ", e);
            if (resultLayer) map.fitBounds(resultLayer.getBounds());
        }
    }


    // ---------------------------------------------------------
    // 6. İLK YÜKLEME
    // ---------------------------------------------------------
    window.onload = function() {
        document.getElementById('wpsUrlSelect').dispatchEvent(new Event('change'));
        document.getElementById('loading-indicator').style.display = 'none';
        // İlk yüklemede, varsayılan noktayı haritada gösterelim.
        drawGeoJsonResult({ type: "FeatureCollection", features: [] }, document.getElementById('wktInput').value);
    };

</script>
</body>
</html>