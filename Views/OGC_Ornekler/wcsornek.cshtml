@{
Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OGC WCS Eğitim ve Kapsam Veri Portalı</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f4f7f6; color: #333; }
        .navbar { background: linear-gradient(135deg, #16a085 0%, #2ecc71 100%); }
        .map-container { height: 600px; width: 100%; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); border: 2px solid #e0e0e0; z-index: 1; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 15px rgba(0,0,0,0.05); margin-bottom: 20px; }
        .card-header { background-color: #fff; border-bottom: 1px solid #eee; font-weight: 600; color: #16a085; }
        .code-block { background-color: #2d2d2d; color: #f1c40f; padding: 15px; border-radius: 8px; font-family: 'Consolas', monospace; font-size: 0.85rem; overflow-x: auto; white-space: pre-wrap; }
        .param-badge { background-color: #e8f8f5; color: #1abc9c; padding: 4px 8px; border-radius: 4px; font-family: monospace; font-weight: bold; }

        #loading-indicator { display: none; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 9999; background: rgba(255,255,255,0.9); padding: 20px; border-radius: 10px; box-shadow: 0 0 10px rgba(0,0,0,0.2); text-align: center; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="#">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-stack me-2" viewBox="0 0 16 16">
                <path d="M5.443 12.502H3.984v-.832h1.459zm0-1.666H3.984v-.832h1.459zm0-1.666H3.984v-.832h1.459zm0-1.666H3.984v-.832h1.459zm0-1.666H3.984V5.002h1.459z"/>
                <path fill-rule="evenodd" d="M1 4.5l7-4 7 4v1.077l-7 4-7-4zM8 1.144L2.859 4.19l5.141 2.934 5.141-2.934z"/>
                <path fill-rule="evenodd" d="M1 7.077l7 4 7-4v1.077l-7 4-7-4zM8 8.144L2.859 11.19l5.141 2.934 5.141-2.934z"/>
                <path fill-rule="evenodd" d="M1 9.692l7 4 7-4v1.077l-7 4-7-4z"/>
            </svg>
            OGC WCS (Kapsam Veri) Portalı
        </a>
    </div>
</nav>

<div class="container">
    <div class="row">
        <div class="col-lg-4">

            <div class="card">
                <div class="card-header">
                    📚 WCS Farkı ve Başarılı İndirme İçin İpuçları
                </div>
                <div class="card-body">
                    <p class="small text-muted">WCS, WMS gibi **resim değil**, GeoTIFF/NetCDF gibi **ham veri dosyası** döndürür. Bu nedenle sonuç tarayıcıda görünmez, indirilmeye başlar.</p>
                    <hr />
                    <h6>Başarısız İndirme Nedenleri:</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-1">1. **CORS Hatası:** Sunucu, bu web sitesinden gelen isteklere izin vermiyor olabilir. (Çözüm: Linki doğrudan yeni sekmede açın.)</li>
                        <li class="mb-1">2. **Katman Adı Yanlış:** `COVERAGE` ID'si o anda geçerli olmayabilir. (Çözüm: `GetCapabilities` ile kontrol edin.)</li>
                        <li class="mb-1">3. **Çok Büyük BBOX:** Çok büyük bir alan istemek sunucuyu yorabilir ve isteği kesebilir. (Çözüm: Haritada küçük bir alanı seçin.)</li>
                    </ul>
                </div>
            </div>

            <div class="card bg-light">
                <div class="card-header">
                    ⚙️ WCS Servis Ayarları
                </div>
                <div class="card-body">
                    <form id="wcsForm">
                        <div class="mb-3">
                            <label for="wcsUrlSelect" class="form-label fw-bold">WCS Servis URL</label>
                            <select class="form-select" id="wcsUrlSelect">
                                <option value="https://ows.eox.at/wcs" data-wms-url="https://ows.eox.at/wms" data-coverage="terrain-global-ortho" data-wms-layer="terrain-global-ortho" selected>1. EOX WCS/WMS (Avrupa - Stabil Örnek)</option>
                                <option value="https://ahocevar.com/geoserver/wcs" data-wms-url="https://ahocevar.com/geoserver/wms" data-coverage="sf:sfdem" data-wms-layer="sf:sfdem">2. GeoServer Demo (DEM Örneği)</option>
                                <option value="https://geoserver.gisc.gmu.edu/geoserver/wcs" data-wms-url="https://geoserver.gisc.gmu.edu/geoserver/wms" data-coverage="USGS_NED_one_meter_DEM_in_Virginia" data-wms-layer="topp:states">3. GMU GeoServer (Virginia DEM)</option>
                            </select>
                            <input type="hidden" id="wmsUrlInput">
                            <input type="text" class="form-control mt-2" id="wcsUrlInput" value="https://ows.eox.at/wcs" readonly>
                        </div>

                        <div class="mb-3">
                            <label for="coverageName" class="form-label fw-bold">Coverage (Raster Katman)</label>
                            <input type="text" class="form-control" id="coverageName" value="terrain-global-ortho">
                            <div class="form-text small">Bu, WMS'te görünen katmanla aynı olmalıdır.</div>
                        </div>

                        <div class="mb-3">
                            <label for="outputFormat" class="form-label fw-bold">Output Format (Ham Veri Formatı)</label>
                            <select class="form-select" id="outputFormat">
                                <option value="image/geotiff" selected>image/geotiff</option>
                                <option value="NetCDF">NetCDF</option>
                            </select>
                            <div class="form-text small">Bu formatta dosya indirilecektir.</div>
                        </div>

                        <div class="mb-3">
                            <label for="mapBbox" class="form-label fw-bold">BBOX (Harita Sınırları)</label>
                            <input type="text" class="form-control" id="mapBbox" value="10.0,40.0,15.0,45.0">
                            <div class="form-text small">MinX, MinY, MaxX, MaxY şeklinde koordinatlar (EPSG:4326).</div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-primary" onclick="generateWCSRequest()">
                                💾 Ham Veri İndirme İsteği Oluştur
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="alert alert-info mt-3 small p-2">
                ✅ **Talimat:** Haritada küçük bir alan seçin, isteği oluşturun ve linke tıklayın. Eğer indirme başlamazsa, Linki kopyalayıp tarayıcınızın yeni sekmesinde açmayı deneyin.
            </div>

        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>🗺️ WCS Alanının WMS Önizlemesi (WCS alanını görselleştirmek için)</span>
                    <span class="badge bg-danger" id="wmsError"></span>
                </div>
                <div class="card-body p-0 position-relative">
                    <div id="loading-indicator">
                        <div class="spinner-border text-primary" role="status"></div>
                        <div>Harita Yükleniyor...</div>
                    </div>
                    <div id="map" class="map-container"></div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    💻 Oluşturulan WCS GetCoverage İsteği URL'i
                </div>
                <div class="card-body bg-dark p-0">
                    <div class="code-block" id="requestCode">
                        İstek URL'i burada gösterilecektir.
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    🔗 Direkt İndirme Linki (WCS)
                </div>
                <div class="card-body">
                    <a href="#" id="downloadLink" class="btn btn-outline-success btn-sm" target="_blank" disabled>İndirmek İçin Tıklayın (GetCoverage)</a>
                </div>
            </div>
        </div>
    </div>
</div>

<footer class="text-center py-4 text-muted mt-5 border-top">
    <div class="container">
        <p class="mb-0">owsLab - WCS Kapsam Veri Entegrasyon Demosu</p>
    </div>
</footer>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    // ---------------------------------------------------------
    // 1. HARİTA BAŞLATMA VE WMS/WCS İŞLEMLERİ
    // ---------------------------------------------------------
    var map = L.map('map').setView([42.0, 12.5], 6); // İtalya/Adriyatik çevresi (EOX için)
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors',
        maxZoom: 18
    }).addTo(map);

    var wmsLayer = null;

    // WMS Önizleme Katmanını Oluşturma/Güncelleme
    function updateWMSPreviewLayer(wmsUrl, wmsLayerName) {
        if (wmsLayer) map.removeLayer(wmsLayer);

        // WMS katmanı, WCS verisini temsil etmek için haritada bir resim gösterir.
        wmsLayer = L.tileLayer.wms(wmsUrl, {
            layers: wmsLayerName,
            format: 'image/png',
            transparent: true,
            version: '1.3.0',
            crs: L.CRS.EPSG4326,
            attribution: "WMS Preview"
        }).addTo(map);
    }

    // Harita hareket ettiğinde BBOX'u güncelleyen fonksiyon
    function updateBBoxFromMap() {
        const bounds = map.getBounds();
        // WCS genellikle EPSG:4326 formatında koordinat ister
        const bboxValue = `${bounds.getWest().toFixed(4)},${bounds.getSouth().toFixed(4)},${bounds.getEast().toFixed(4)},${bounds.getNorth().toFixed(4)}`;
        document.getElementById('mapBbox').value = bboxValue;

        // WCS isteğini ve indirme linkini de güncelle
        generateWCSRequest();
    }

    map.on('moveend', updateBBoxFromMap);

    // Servis seçimi değiştiğinde tüm parametreleri ve haritayı güncelleme
    document.getElementById('wcsUrlSelect').addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];

        const wcsUrl = selectedOption.value;
        const wmsUrl = selectedOption.getAttribute('data-wms-url');
        const coverageName = selectedOption.getAttribute('data-coverage');
        const wmsLayerName = selectedOption.getAttribute('data-wms-layer');

        // Form alanlarını güncelle
        document.getElementById('wcsUrlInput').value = wcsUrl;
        document.getElementById('wmsUrlInput').value = wmsUrl;
        document.getElementById('coverageName').value = coverageName;

        // Harita ve WMS katmanını güncelle
        if (wcsUrl.includes('eox.at')) {
            map.setView([42.0, 12.5], 6); // İtalya/Adriyatik
        } else if (wcsUrl.includes('ahocevar.com')) {
            map.setView([37.77, -122.42], 12); // San Francisco
        } else if (wcsUrl.includes('gisc.gmu.edu')) {
            map.setView([38.5, -79.0], 8); // Virginia
        }

        updateWMSPreviewLayer(wmsUrl, wmsLayerName);
        updateBBoxFromMap(); // BBOX ve WCS isteğini tetikler
    });

    // ---------------------------------------------------------
    // 2. WCS İSTEĞİ OLUŞTURMA FONKSİYONU
    // ---------------------------------------------------------
    function generateWCSRequest() {
        const baseUrl = document.getElementById('wcsUrlInput').value;
        const coverageName = document.getElementById('coverageName').value;
        const outputFormat = document.getElementById('outputFormat').value;
        // WCS GetCoverage için genellikle BBOX'taki CRS kullanılır, burada 4326 varsayalım.
        const targetCRS = 'EPSG:4326';
        const bboxValue = document.getElementById('mapBbox').value;

        const [minX, minY, maxX, maxY] = bboxValue.split(',').map(coord => parseFloat(coord));
        const width = 512; // Çıktı çözünürlüğünü optimize et
        const height = Math.round(width * ((maxY - minY) / (maxX - minX)));

        const wcsUrl = new URL(baseUrl);
        wcsUrl.searchParams.append("SERVICE", "WCS");
        wcsUrl.searchParams.append("VERSION", "1.1.1"); // Stabilite için 1.1.1 kullanalım
        wcsUrl.searchParams.append("REQUEST", "GetCoverage");
        wcsUrl.searchParams.append("IDENTIFIER", coverageName); // 1.1.1'de COVERAGE yerine IDENTIFIER kullanılır
        wcsUrl.searchParams.append("FORMAT", outputFormat);
        wcsUrl.searchParams.append("CRS", targetCRS);
        wcsUrl.searchParams.append("BBOX", `${minX},${minY},${maxX},${maxY},${targetCRS}`);
        wcsUrl.searchParams.append("WIDTH", width);
        wcsUrl.searchParams.append("HEIGHT", height);

        const finalUrl = decodeURIComponent(wcsUrl.toString());

        document.getElementById('requestCode').innerText = finalUrl;

        const downloadLink = document.getElementById('downloadLink');
        downloadLink.href = finalUrl;
        downloadLink.disabled = false;
        downloadLink.innerText = `${outputFormat} İndirmek İçin Tıklayın`;

        document.getElementById('wmsError').innerText = '';
    }


    // ---------------------------------------------------------
    // 3. İLK YÜKLEME
    // ---------------------------------------------------------
    window.onload = function() {
        // İlk yüklemede EOX servisi parametrelerini yükle
        document.getElementById('wcsUrlSelect').dispatchEvent(new Event('change'));
        document.getElementById('loading-indicator').style.display = 'none';

        // İlk servis olarak EOX WMS/WCS'i yükle
        const initialOption = document.getElementById('wcsUrlSelect').options[0];
        updateWMSPreviewLayer(initialOption.getAttribute('data-wms-url'), initialOption.getAttribute('data-wms-layer'));
        updateBBoxFromMap();
        generateWCSRequest();
    };

</script>
</body>
</html>